"""Pack our first stage and our app into a BCO image (bCoD)."""
import importlib.util
import struct
import sys
import zlib
from pathlib import Path

spec = importlib.util.spec_from_file_location("records", Path(__file__).resolve().parent / "copy-records.py")
records = importlib.util.module_from_spec(spec)
spec.loader.exec_module(records)
first_path, second_path, output = map(Path, sys.argv[1:])
second = second_path.read_bytes()
assert 0 < len(second) <= 0x100000
second += bytes(8 + (-len(second)) % 8)  # unexecuted tail: corruption tests flip it
first = bytearray(first_path.read_bytes())
assert 0x40 < len(first) < 0x1ff0 and first[:0x40] == bytes(0x40)
first.extend(b" " * 8)  # unexecuted tail: corruption tests flip it
first.extend(b" " * ((-(len(first) - 0x18)) % 8))
units = (len(first) - 0x18) // 8
struct.pack_into("<6I", first, 0, 0xaaaa5555, 1, 0xa5a5a5a5, 0x40da00, units, 0)
struct.pack_into("<6I", first, 0x18, 0xea000008, 0xa5a5a5a5,
                 0x8000, 0x1c2080, len(second), records.copy_checksum(second))
struct.pack_into("<I", first, 0x14, zlib.crc32(first[0x18:]))
image = first + b" " * (0x2000 - len(first)) + second
header = bytearray(0xb8)
struct.pack_into("<2I", header, 0, 0x446f4362, 1)
header[8:22] = b"20261002000000"
struct.pack_into("<5I", header, 0x18, 0x74, 9412, 0x200bd, 0x7f510, 2)  # +0x28: 2 = 0xb0-byte header (BSL)
struct.pack_into("<8I", header, 0x30, 0xb8, 0x401c0000, len(image),
                 zlib.crc32(image), 0x540000, 0, 0, 0)
header[0xb0:0xb7] = b"DMP 3.x"
struct.pack_into("<I", header, 0x2c, zlib.crc32(header[:0xb0]))
output.write_bytes(header + image)
print(f"PACK own app: {len(image)} image bytes; first={units * 8} second={len(second)}")

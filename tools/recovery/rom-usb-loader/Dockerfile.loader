# The loader talks to a mask ROM over libusb, so it needs libusb headers, and this
# machine installs nothing on the host. Native architecture only: it runs against the
# board attached to the same machine that built it.
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential pkg-config libusb-1.0-0-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src

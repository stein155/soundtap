#!/usr/sbin/nft -f
# Production input filter (ADR 0066): from the network the speaker answers what
# SoundTap serves and nothing else. One inet table holds IPv4 and IPv6 to the same ports
# (ADR 0134). Outbound traffic is not filtered. Loaded by the first sysinit line of a
# production inittab, before any interface is up.
flush ruleset

table inet filter {
	# Speakers this one leads: soundtapd adds a follower when it invites it and refreshes
	# it while the follower is connected.
	set snap_followers {
		type ipv4_addr
		flags timeout
		timeout 10m
	}
	set snap_followers6 {
		type ipv6_addr
		flags timeout
		timeout 10m
	}

	# The subnets this speaker has an address on, kept by /opt/soundtap/lan-allow.sh. As on
	# stock, only hosts on the speaker's own links are answered: a port forward or a routed
	# network does not reach it.
	set lan_nets {
		type ipv4_addr
		flags interval
	}

	# The same for IPv6, per interface: fe80::/10 and every prefix the interface has an
	# address in, kept by soundtapd (internal/lanfilter). The interface is part of the
	# element because every link has the same link-local prefix.
	set lan_nets6 {
		type ifname . ipv6_addr
		flags interval
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		icmp type { echo-request, destination-unreachable, time-exceeded } accept
		icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
		# Neighbour discovery and router advertisements (SLAAC) come from the link itself,
		# which a hop limit of 255 proves (RFC 4861); multicast listener queries from a
		# link-local router keep the switch sending mDNS here.
		# Not on the open setup AP: a phone there must not hand the speaker a route.
		iifname "wlan1" icmpv6 type nd-router-advert drop
		icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 accept
		icmpv6 type mld-listener-query ip6 saddr fe80::/10 accept
		# soundtapd (web UI, API, multiroom peers), AirPlay RTSP
		tcp dport { 80, 7000 } ip saddr @lan_nets accept
		tcp dport { 80, 7000 } iifname . ip6 saddr @lan_nets6 accept
		# Snapcast stream: followers only, never the setup AP
		iifname "wlan1" tcp dport 1704 drop
		tcp dport 1704 ip saddr @snap_followers accept
		tcp dport 1704 ip6 saddr @snap_followers6 accept
		# PTP (nqptp): AirPlay is not used from the setup AP
		iifname "wlan1" udp dport { 319, 320 } drop
		# mDNS (avahi), SSDP (soundtapd), PTP (nqptp)
		udp dport { 5353, 1900, 319, 320 } ip saddr @lan_nets accept
		udp dport { 5353, 1900, 319, 320 } iifname . ip6 saddr @lan_nets6 accept
		# AirPlay 2 and Spotify Connect listen on ports the kernel picks, as do the
		# replies to multicast searches and TFTP to the ST20's BCO
		tcp dport 32768-60999 ip saddr @lan_nets accept
		udp dport 32768-60999 ip saddr @lan_nets accept
		tcp dport 32768-60999 iifname . ip6 saddr @lan_nets6 accept
		udp dport 32768-60999 iifname . ip6 saddr @lan_nets6 accept
		# The ST20 BCO's bootloader answers TFTP from 192.168.1.100 on a link soundtapd
		# addresses itself (internal/bco addressLevel2), not through lan-allow.sh.
		ip saddr 192.168.1.100 udp dport 32768-60999 accept
		# The setup AP (soundtapd's Wi-Fi manager: wlan1, 192.168.42.1): udhcpd hands a phone its lease and
		# dnsd answers every captive-portal lookup with the setup page. A
		# DHCPDISCOVER is a broadcast from 0.0.0.0, so neither is matched on address.
		iifname "wlan1" udp dport { 53, 67 } accept
	}
}

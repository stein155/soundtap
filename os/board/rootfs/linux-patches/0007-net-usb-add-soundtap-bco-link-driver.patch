+static int bco_wlan_open(struct net_device *dev)
+{
+	struct bco_port *p = netdev_priv(dev);
+	int err = bco_port_open(dev);
+
+	if (err)
+		return err;
+	mutex_lock(&p->b->lock);
+	p->b->running = true;
+	mutex_unlock(&p->b->lock);
+	return 0;
+}
+
+/* Stop all work before cfg80211 tears the interface down: a pending scan is finished here. */
+static int bco_wlan_stop(struct net_device *dev)
+{
+	struct bco *b = ((struct bco_port *)netdev_priv(dev))->b;
+	struct cfg80211_scan_info info = { .aborted = true };
+	struct cfg80211_scan_request *req;
+
+	mutex_lock(&b->lock);
+	b->running = false;
+	b->joining = false;
+	b->connected = false;
+	mutex_unlock(&b->lock);
+	cancel_delayed_work_sync(&b->join_work);
+	cancel_work_sync(&b->scan_work);
+	mutex_lock(&b->lock);
+	req = b->scan_req;
+	b->scan_req = NULL;
+	mutex_unlock(&b->lock);
+	if (req)
+		cfg80211_scan_done(req, &info);
+	netif_carrier_off(dev);
+	return 0;
+}
+
+static const struct net_device_ops bco_wlan_ops = {
+	.ndo_open = bco_wlan_open,
+	.ndo_stop = bco_wlan_stop,
+	.ndo_start_xmit = bco_port_xmit,
+	.ndo_set_mac_address = eth_mac_addr,
+	.ndo_validate_addr = eth_validate_addr,
+};

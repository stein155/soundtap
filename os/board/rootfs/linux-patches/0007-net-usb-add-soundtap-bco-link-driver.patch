+static struct wireless_dev *bco_add_intf(struct wiphy *wiphy, const char *name,
+					 unsigned char name_assign_type, enum nl80211_iftype type,
+					 struct vif_params *params)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	struct net_device *dev;
+	struct bco_port *p;
+	int err;
+
+	if (type != NL80211_IFTYPE_AP)
+		return ERR_PTR(-EOPNOTSUPP);
+	if (b->ap)
+		return ERR_PTR(-EBUSY);
+	dev = alloc_netdev(sizeof(*p), name, name_assign_type, bco_port_setup);
+	if (!dev)
+		return ERR_PTR(-ENOMEM);
+	p = netdev_priv(dev);
+	p->b = b;
+	p->ch = BCOLINK_CH_WIFI;
+	p->wdev.wiphy = wiphy;
+	p->wdev.iftype = NL80211_IFTYPE_AP;
+	p->wdev.netdev = dev;
+	dev->ieee80211_ptr = &p->wdev;
+	dev->netdev_ops = &bco_ap_ops;
+	dev->needs_free_netdev = true;
+	eth_hw_addr_set(dev, wiphy->perm_addr);	/* the BCO beacons as its own MAC */
+	SET_NETDEV_DEV(dev, wiphy_dev(wiphy));
+	netif_carrier_off(dev);
+	err = cfg80211_register_netdevice(dev);
+	if (err) {
+		free_netdev(dev);
+		return ERR_PTR(err);
+	}
+	WRITE_ONCE(b->ap, dev);
+	return &p->wdev;
+}
+
+static int bco_del_intf(struct wiphy *wiphy, struct wireless_dev *wdev)
+{
+	struct bco *b = wiphy_priv(wiphy);
+
+	if (wdev->netdev != b->ap)
+		return -EOPNOTSUPP;
+	WRITE_ONCE(b->ap_up, false);
+	WRITE_ONCE(b->ap, NULL);
+	synchronize_net();	/* no RX path holds it any more */
+	cfg80211_unregister_netdevice(wdev->netdev);
+	return 0;
+}

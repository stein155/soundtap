From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stein Milder <info@steinmilder.nl>
Date: Tue, 6 Oct 2026 16:00:00 +0200
Subject: [PATCH] net: usb: add SoundTap BCO link driver

On the ST20 the Wi-Fi radio and the wired port live on the BCO
co-processor. The own BCO app exposes both over one vendor-specific USB
function (pid.codes test ID 1209:0001, class ff/52/01) that carries one
message per transfer: le16 (channel << 12 | length) and the payload.
Channel 0 is control, 1 the Wi-Fi station, 2 the wired port (ADR 0031).

This usbnet minidriver takes the function as its transport (bcolink0)
and registers wlan0, a FullMAC cfg80211 station (scan, connect with PMK
offload, disconnect, station info) carrying its data on channel 1, and
eth0 on channel 2, so userspace sees the same interfaces as on an ST10.
It replaces the earlier wlan0 face that rode on cdc_ether. Stock BCOs
still enumerate as CDC-ECM and never bind here.

A BCO app that announces flow control in HELLO reports its free Wi-Fi
transmit buffers; while it has none, wlan0 and wlan1 stop their queues
and frames wait in the qdisc instead of being dropped on the BCO. The
BCO's transmit and link counters and the flow-control state are under
/sys/class/net/bcolink0/bco/. An app without these capabilities works
as before.

A BCO app that announces them also sends link events (deauthentication,
disassociation, beacon loss), which end the connection at once with the
access point's reason; roams within the SSID, reported as
cfg80211_roamed (WIPHY_FLAG_SUPPORTS_FW_ROAM) and steered by the
connect's BSSID or BSSID hint; takes the regulatory domain cfg80211
settles on as channel masks and a TX power limit (reg_notifier); probes
for the scan's SSID, so hidden networks answer; and lists its PersParam
keys in the root-only bco/nv_keys for a bench check.

While the setup access point runs, `iw dev wlan1 station dump` lists
its clients with their counters (inactive time, frames in and out,
frames lost), and bco/ap shows its state: beacons, the time to the
first one, probe responses, the core's receive counters and each
client.

A BCO app that announces it also joins open and WEP networks, runs
TKIP and reports each network's real RSN and WPA IEs in scan results;
one that announces WPA3 joins WPA3-SAE networks over cfg80211's
external authentication (mgmt_tx, external_auth, set_pmksa) with PMF.

Upstream: Not applicable (SoundTap hardware support)
Signed-off-by: Stein Milder <info@steinmilder.nl>
---
diff -Nru a/drivers/net/usb/Kconfig b/drivers/net/usb/Kconfig
--- a/drivers/net/usb/Kconfig	2026-10-06 18:06:43.450816100 +0200
+++ b/drivers/net/usb/Kconfig	2026-10-06 18:06:43.454816079 +0200
@@ -398,6 +398,14 @@
 	  adapter based on the MosChip 7830 controller. This includes
 	  adapters marketed under the DeLOCK brand.
 
+config USB_NET_SOUNDTAP_BCO
+	tristate "SoundTap BCO link (SoundTouch 20 Wi-Fi and wired ports)"
+	depends on USB_USBNET && CFG80211
+	help
+	  The own SoundTap application on the SoundTouch 20's BCO co-processor
+	  exposes its Wi-Fi station and wired port over one vendor-specific USB
+	  function. This driver registers them as wlan0 (cfg80211) and eth0.
+
 config USB_NET_RNDIS_HOST
 	tristate "Host for RNDIS and ActiveSync devices"
 	depends on USB_USBNET
diff -Nru a/drivers/net/usb/Makefile b/drivers/net/usb/Makefile
--- a/drivers/net/usb/Makefile	2026-10-06 18:06:43.450816100 +0200
+++ b/drivers/net/usb/Makefile	2026-10-06 18:06:43.454816079 +0200
@@ -24,6 +24,7 @@
 obj-$(CONFIG_USB_NET_NET1080)	+= net1080.o
 obj-$(CONFIG_USB_NET_PLUSB)	+= plusb.o
 obj-$(CONFIG_USB_NET_RNDIS_HOST)	+= rndis_host.o
+obj-$(CONFIG_USB_NET_SOUNDTAP_BCO)	+= soundtap_bco.o
 obj-$(CONFIG_USB_NET_CDC_SUBSET_ENABLE)	+= cdc_subset.o
 obj-$(CONFIG_USB_NET_ZAURUS)	+= zaurus.o
 obj-$(CONFIG_USB_NET_MCS7830)	+= mcs7830.o
diff -Nru a/drivers/net/usb/soundtap_bco.c b/drivers/net/usb/soundtap_bco.c
--- a/drivers/net/usb/soundtap_bco.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/net/usb/soundtap_bco.c	2026-10-06 18:06:43.454816079 +0200
@@ -0,0 +1,2162 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SoundTap BCO link: the SoundTouch 20's Wi-Fi and wired ports, which live on the BCO co-processor
+ * behind one vendor-specific USB function of the own BCO app (ADR 0031).
+ *
+ * The usbnet device is the transport, bcolink0. Every transfer carries one message:
+ *	le16 (channel << 12 | length), then length bytes of payload
+ * Channel 0 is control (the ADR 0031 management messages), 1 the Wi-Fi station, 2 the wired port;
+ * data payloads are Ethernet frames. On top of the transport this driver registers
+ *	wlan0	a FullMAC cfg80211 station (scan, connect with the PMK handed down, disconnect,
+ *		station info) whose data is channel 1, with the device's own Wi-Fi MAC;
+ *	eth0	the wired port, channel 2.
+ *	wlan1	on request (iw ... interface add wlan1 type __ap), an open access point for hostapd
+ *		whose data is channel 1 while it beacons (ADR 0031); the BCO answers probes,
+ *		authentication and association itself (AP SME in the device).
+ * so userspace sees the same interfaces as on a SoundTouch 10.
+ *
+ * A BCO app with BCOLINK_CAP_FLOW reports its free Wi-Fi transmit buffers; channel-1 frames then
+ * wait in wlan0's (or wlan1's) qdisc while it has none, instead of being dropped on the BCO. Its
+ * counters (BCOLINK_CAP_STATS) are in /sys/class/net/bcolink0/bco/.
+ *
+ * The standard firmware features of ADR 0135, each used only when HELLO announces it: link events
+ * (deauthentication, disassociation, beacon loss) end the connection at once instead of at the next
+ * STATUS poll; the BCO roams within the SSID and the driver reports it (cfg80211_roamed); the
+ * regulatory domain cfg80211 settles on goes down as channel masks and a TX power limit; a scan's
+ * SSID goes into the BCO's directed probe, for hidden networks.
+ *
+ * With BCOLINK_CAP_SECURITY (ADR 0136) the BCO also joins open and WEP networks (SET_PROFILE
+ * security 0 and 2, the static WEP key from the connect or add_key) and runs TKIP; scan results
+ * carry each network's real RSN and WPA IEs. With BCOLINK_CAP_WPA3 it joins WPA3: wpa_supplicant
+ * runs SAE over cfg80211's external authentication (mgmt_tx, external_auth, set_pmksa) and the BCO
+ * runs the 4-way with the PMK SAE derived, PMF included.
+ *
+ * The protocol constants mirror bco/app/src/bcolink.h in the SoundTap tree.
+ */
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/rtnetlink.h>
+#include <linux/usb.h>
+#include <linux/usb/usbnet.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/random.h>
+#include <linux/workqueue.h>
+#include <linux/unaligned.h>
+#include <linux/ctype.h>
+#include <net/cfg80211.h>
+
+#define BCOLINK_HDR		2
+#define BCOLINK_MAX		1536
+#define BCOLINK_CH_CTRL		0
+#define BCOLINK_CH_WIFI		1
+#define BCOLINK_CH_WIRED	2
+
+/* Marks the transport's own messages: anything else the stack sends on bcolink0 is dropped. */
+#define BCO_SKB_PROTO		htons(ETH_P_802_EX1)
+
+#define BCO_MGMT_HDR		6
+/* The link protocol level this driver speaks; bco/app/src/bcolink.h BCOLINK_PROTO (ADR 0031). */
+#define BCO_LINK_PROTO		2
+/*
+ * A whole join on the BCO (bco/app/src/wifi.c) takes up to one scan, 2 passes x 13 channels x
+ * 200 ms + 200 ms = 5.4 s, then JOIN_TRIES (5) attempts of 1 + 2 + 1.5 + 8 s (setup, auth, assoc,
+ * 4-way handshake) = 62.5 s: about 68 s. Waiting less gave up while the BCO still joined, and
+ * wpa_supplicant's next connect raced the attempt still running.
+ */
+#define BCO_JOIN_TIMEOUT	(90 * HZ)
+#define BCO_LINK_POLL		(5 * HZ)
+#define BCO_WIRED_POLL		(2 * HZ)
+
+/* HELLO's capability bits this driver uses; bco/app/src/bcolink.h BCOLINK_CAP_*. */
+#define BCOLINK_CAP_AP		0x1	/* the app runs an access point */
+#define BCOLINK_CAP_FLOW	0x4
+#define BCOLINK_CAP_STATS	0x8
+/* FLOW's reply and the BCO's unasked credit reports: status, free, total, on, le32 taken. */
+#define BCO_FLOW_LEN		8
+/* LINK_STATS: status, then this many le32 counters. */
+#define BCO_STATS_N		5
+/* Wi-Fi held for want of credit this long means a lost report or frame: count afresh. */
+#define BCO_FLOW_STUCK		HZ
+
+/* ADR 0135's capabilities; bco/app/src/bcolink.h. */
+#define BCOLINK_CAP_EVENTS	0x10
+#define BCOLINK_CAP_ROAM	0x20
+#define BCOLINK_CAP_REGDOM	0x40
+#define BCOLINK_CAP_SCAN_SSID	0x80
+#define BCOLINK_CAP_NVINFO	0x100
+/* AP_STATUS's tail: the setup AP's diagnostics and per-client counters (bco/app/src/mgmt.h). */
+#define BCOLINK_CAP_APDIAG	0x200
+/* AP_STATUS: status, count, the MACs, BCO_AP_COUNTERS le32; with BCOLINK_CAP_APDIAG then
+ * BCO_AP_DIAG le32 and BCO_AP_CLIENT bytes per client. */
+#define BCO_AP_COUNTERS		8
+#define BCO_AP_DIAG		5
+#define BCO_AP_CLIENT		24
+/* and after the clients, from an app that sends them: the core's damaged frames to us and the
+ * last one's rate, a client's frames with a body and the last one's, frames without queue room */
+#define BCO_AP_EXTRA		7
+/* then per client: le32 frames with the Retry bit, le16 repeated sequence numbers, le16 the last
+ * sequence control. An app with only the first five extra words sends none of it. */
+#define BCO_AP_EXTRA_OLD	5
+#define BCO_AP_CLIENT2		8
+/* ADR 0136: every network security stock joined; SET_PROFILE security 0 (open), 2 (WEP) */
+#define BCOLINK_CAP_SECURITY	0x400
+/* ADR 0136: WPA3-SAE over cfg80211's external authentication, PSK-SHA256 and PMF on the BCO */
+#define BCOLINK_CAP_WPA3	0x800
+/* EXT_AUTH's actions in the BCO's unasked request, and the longest SAE frame either way */
+#define BCO_EXT_AUTH_START	1
+#define BCO_EXT_AUTH_ABORT	2
+#define BCO_SAE_MAX		512
+/* An unasked EVENTS report: status, event, le16 reason, bssid, channel, rssi (bco/app/src/mgmt.h). */
+#define BCO_EVENT_LEN		12
+#define BCO_EV_DEAUTH		1
+#define BCO_EV_DISASSOC		2
+#define BCO_EV_BEACON_LOSS	3
+#define BCO_EV_TX_WEDGE		4
+#define BCO_EV_ROAMED		5
+#define BCO_EV_ROAM_FAILED	6
+/* SET_PROFILE's security byte (bco/app/src/wifi.h WIFI_SEC_*) and SCAN's (WIFI_BSS_*). */
+enum { BCO_SEC_OPEN, BCO_SEC_PSK, BCO_SEC_WEP, BCO_SEC_SAE };
+enum { BCO_WEP_OPEN, BCO_WEP_SHARED, BCO_WEP_AUTO };	/* WEP authentication (WIFI_WEP_*) */
+enum { BCO_BSS_OPEN, BCO_BSS_RSN, BCO_BSS_WPA, BCO_BSS_WEP };
+/*
+ * SCAN's flags (payload byte 0) and the security detail an app with BCOLINK_CAP_SECURITY puts after
+ * an entry's security byte (and STATUS after its own): RSN group cipher suite type, RSN pairwise
+ * set, RSN AKM set, RSN capabilities' low byte, WPA IE group, WPA IE pairwise set; bco/app/src/mgmt.h.
+ */
+#define BCO_SCAN_START		0x1
+#define BCO_SCAN_DETAIL		0x2
+#define BCO_SCAN_DETAIL_LEN	6
+#define BCO_SET_CCMP		0x1	/* pairwise sets (wifi.h WIFI_SET_*) */
+#define BCO_SET_TKIP		0x2
+#define BCO_SET_PSK		0x1	/* AKM sets */
+#define BCO_SET_PSK256		0x2
+#define BCO_SET_SAE		0x4
+/* SET_PROFILE's tail: flags, bssid. */
+#define BCO_PROFILE_TAIL	7
+#define BCO_PROFILE_BSSID_FIXED	0x1
+#define BCO_PROFILE_BSSID_HINT	0x2
+#define BCO_PROFILE_ROAM	0x4
+/* SET_REGDOM: country[2], le16 channels, le16 passive, i8 dBm. */
+#define BCO_REGDOM_LEN		7
+/* NV_INFO entry: le32 key, le16 value length, 4 value bytes. */
+#define BCO_NV_ENTRY		10
+
+enum { T_HELLO = 1, T_SCAN, T_SET_PROFILE, T_FORGET, T_STATUS, T_AP_START, T_AP_STOP, T_AP_STATUS,
+	T_WIRED_PROBE = 12, T_FLOW, T_LINK_STATS, T_EVENTS, T_SET_REGDOM, T_NV_INFO, T_EXT_AUTH,
+	T_AUTH_FRAME, T_SET_PMK };
+enum { S_IDLE, S_SCANNING, S_JOINING, S_UP, S_FAILED, S_AP };
+
+struct bco {
+	struct usbnet *usb;
+	struct wiphy *wiphy;
+	struct wireless_dev wdev;
+	struct net_device *wlan, *eth;	/* set once registered; RX reads them lock-free */
+	struct net_device *ap;		/* wlan1 while it exists (wiphy lock) */
+	bool ap_up;			/* channel 1 belongs to wlan1: the BCO beacons */
+	struct work_struct setup;
+
+	struct mutex lock;		/* one request in flight; rsp is valid while it is held */
+	spinlock_t rx_lock;		/* armed/want_* and rsp against the RX path */
+	struct completion done;
+	bool armed;
+	u16 seq, want_seq;
+	u8 want_type;
+	u8 rsp[BCOLINK_MAX];
+	unsigned int rsp_len;
+
+	struct work_struct scan_work;
+	struct delayed_work join_work;
+	struct delayed_work wired_work;	/* eth0's carrier from the BCO's PHY */
+	struct cfg80211_scan_request *scan_req;	/* under lock */
+	unsigned long join_deadline;
+	bool joining, connected, running;
+	bool keyed;			/* the connect's network has keys: the BCO opens the port */
+	u32 sae_freq;			/* the SAE connect's access point's frequency (cfg80211_rx_mgmt) */
+	/*
+	 * Static WEP keys as wpa_supplicant sets them (add_key, set_default_key) and cfg80211 uploads
+	 * them after a connect; under lock. Only the default one goes to the BCO, in SET_PROFILE.
+	 */
+	u8 wep[4][WLAN_KEY_LEN_WEP104], wep_len[4], wep_def;
+	u8 bssid[ETH_ALEN];		/* the access point connected to (under lock) */
+
+	/* The last link event (BCOLINK_CAP_EVENTS), under rx_lock, for join_work to report. */
+	bool ev_pending;
+	u8 ev_type;
+	u16 ev_reason;
+
+	/* The regulatory domain for SET_REGDOM (BCOLINK_CAP_REGDOM), under rx_lock. */
+	struct work_struct reg_work;
+	u8 regdom[BCO_REGDOM_LEN];
+
+	/*
+	 * Flow control on channel 1 (BCOLINK_CAP_FLOW): the BCO reports how many Wi-Fi transmit
+	 * buffers it has free and how many channel-1 messages it has taken off the link. Ours in
+	 * flight are tx_sent - bco_taken; while that reaches bco_free, wlan0 and wlan1 stop their
+	 * queues and frames wait in the qdisc instead of being dropped on the BCO.
+	 */
+	u32 caps;			/* HELLO's capability bits */
+	spinlock_t flow_lock;
+	bool flow;			/* credit counted; else every frame goes down at once */
+	bool flow_resync;		/* bcolink0 came back up: count afresh */
+	u32 tx_sent, bco_taken;
+	u8 bco_free;
+	unsigned long stopped_at;	/* when credit last ran out */
+	unsigned long flow_stops;	/* times a queue stopped for want of credit */
+	unsigned long flow_resyncs;	/* counted afresh after BCO_FLOW_STUCK */
+	struct delayed_work flow_work;
+
+	/*
+	 * WPA3-SAE (BCOLINK_CAP_WPA3): wpa_supplicant runs SAE over cfg80211's external
+	 * authentication. The frame it last sent, for its TX status from tx_work.
+	 */
+	struct work_struct tx_work;
+	u8 tx_frame[24 + BCO_SAE_MAX];
+	unsigned int tx_len;
+	u64 tx_cookie;
+	bool tx_ack;
+
+	/* LINK_STATS, read at most once a second for sysfs (under lock) */
+	u32 stats[BCO_STATS_N];
+	unsigned long stats_at;
+	bool stats_ok;
+};
+
+struct bco_port {
+	struct bco *b;
+	u8 ch;
+	struct wireless_dev wdev;	/* wlan1 only */
+};
+
+static struct ieee80211_channel bco_channels[13];
+static struct ieee80211_rate bco_rates[] = {
+	{ .bitrate = 10 }, { .bitrate = 20 }, { .bitrate = 55 }, { .bitrate = 110 },
+	{ .bitrate = 60 }, { .bitrate = 90 }, { .bitrate = 120 }, { .bitrate = 180 },
+	{ .bitrate = 240 }, { .bitrate = 360 }, { .bitrate = 480 }, { .bitrate = 540 },
+};
+
+static struct ieee80211_supported_band bco_band = {
+	.channels = bco_channels, .n_channels = ARRAY_SIZE(bco_channels),
+	.bitrates = bco_rates, .n_bitrates = ARRAY_SIZE(bco_rates),
+};
+
+static const u32 bco_ciphers[] = { WLAN_CIPHER_SUITE_CCMP };
+/* An app with BCOLINK_CAP_SECURITY runs TKIP too, in software (ADR 0136). */
+static const u32 bco_ciphers_sec[] = { WLAN_CIPHER_SUITE_CCMP, WLAN_CIPHER_SUITE_TKIP,
+				      WLAN_CIPHER_SUITE_WEP40, WLAN_CIPHER_SUITE_WEP104 };
+/* With BCOLINK_CAP_WPA3 BIP too: wpa_supplicant offers PMF only to a driver that lists it. */
+static const u32 bco_ciphers_wpa3[] = { WLAN_CIPHER_SUITE_CCMP, WLAN_CIPHER_SUITE_TKIP,
+				       WLAN_CIPHER_SUITE_WEP40, WLAN_CIPHER_SUITE_WEP104,
+				       WLAN_CIPHER_SUITE_AES_CMAC };
+
+static struct bco *bco_of(struct usbnet *dev)
+{
+	return dev->driver_priv;
+}
+
+/* ---- flow control on channel 1 ---- */
+
+/* Whether a channel-1 frame may go down now. Under flow_lock. */
+static bool bco_credit(const struct bco *b)
+{
+	return !b->flow || (s32)(b->tx_sent - b->bco_taken) < b->bco_free;
+}
+
+/* Let wlan0 and wlan1 send again. Under flow_lock; wlan1 is gone only after a synchronize_net. */
+static void bco_flow_wake(struct bco *b)
+{
+	struct net_device *d[] = { READ_ONCE(b->wlan), READ_ONCE(b->ap) };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(d); i++)
+		if (d[i] && netif_queue_stopped(d[i]))
+			netif_wake_queue(d[i]);
+}
+
+/*
+ * A credit report: status, free, total, on, le32 taken. A resync (FLOW's own reply) starts counting
+ * from it, as if nothing of ours were in flight; a later report only moves the count forward.
+ */
+static void bco_flow_apply(struct bco *b, const u8 *p, bool resync)
+{
+	u32 taken = get_unaligned_le32(p + 4);
+	unsigned long flags;
+	bool held = false;
+
+	spin_lock_irqsave(&b->flow_lock, flags);
+	if (resync) {
+		b->flow = true;
+		b->tx_sent = taken;
+		b->stopped_at = jiffies;
+	}
+	if (b->flow && (resync || (s32)(taken - b->bco_taken) >= 0)) {
+		b->bco_taken = taken;
+		b->bco_free = p[1];
+		/* frames sent while a resync was on its way were never counted */
+		if ((s32)(b->tx_sent - taken) < 0)
+			b->tx_sent = taken;
+	}
+	held = resync && !bco_credit(b);
+	if (bco_credit(b))
+		bco_flow_wake(b);
+	spin_unlock_irqrestore(&b->flow_lock, flags);
+	if (held)
+		schedule_delayed_work(&b->flow_work, BCO_FLOW_STUCK);
+}
+
+/*
+ * Count a channel-1 frame against the credit. False when there is none: the queue is stopped and
+ * the frame goes back to the qdisc. Called with BHs off (ndo_start_xmit).
+ */
+static bool bco_flow_take(struct bco *b, struct net_device *dev)
+{
+	unsigned long flags;
+	bool ok, stop;
+
+	spin_lock_irqsave(&b->flow_lock, flags);
+	ok = bco_credit(b);
+	if (ok)
+		b->tx_sent++;
+	stop = !bco_credit(b);
+	if (stop && !netif_queue_stopped(dev)) {
+		netif_stop_queue(dev);
+		b->stopped_at = jiffies;
+		b->flow_stops++;
+	}
+	spin_unlock_irqrestore(&b->flow_lock, flags);
+	if (stop)
+		schedule_delayed_work(&b->flow_work, BCO_FLOW_STUCK);
+	return ok;
+}
+
+/* ---- control channel ---- */
+
+static void bco_ctrl_rx(struct bco *b, const u8 *p, unsigned int n)
+{
+	unsigned long flags;
+	unsigned int len;
+
+	/* ver, type, seq(2), len(2), payload */
+	if (n < BCO_MGMT_HDR || p[0] != 1)
+		return;
+	len = get_unaligned_be16(p + 4);
+	if (len > n - BCO_MGMT_HDR)
+		return;
+	/*
+	 * WPA3-SAE (BCOLINK_CAP_WPA3): the BCO asks for SAE (EXT_AUTH: status, action, bssid,
+	 * ssid_len, ssid) and passes up the access point's SAE frames (AUTH_FRAME: status, frame);
+	 * the replies to our own EXT_AUTH and AUTH_FRAME requests are a status byte alone.
+	 */
+	if (p[1] == (T_EXT_AUTH | 0x80) && len >= 1 + 1 + ETH_ALEN + 1 && !p[BCO_MGMT_HDR] && b->wlan) {
+		const u8 *a = p + BCO_MGMT_HDR + 1;
+		struct cfg80211_external_auth_params ea = {
+			.action = a[0] == BCO_EXT_AUTH_START ? NL80211_EXTERNAL_AUTH_START :
+							       NL80211_EXTERNAL_AUTH_ABORT,
+			.key_mgmt_suite = WLAN_AKM_SUITE_SAE,
+		};
+
+		memcpy(ea.bssid, a + 1, ETH_ALEN);
+		ea.ssid.ssid_len = min_t(unsigned int, a[1 + ETH_ALEN], IEEE80211_MAX_SSID_LEN);
+		if (len >= 1 + 1 + ETH_ALEN + 1 + ea.ssid.ssid_len) {
+			memcpy(ea.ssid.ssid, a + 1 + ETH_ALEN + 1, ea.ssid.ssid_len);
+			cfg80211_external_auth_request(b->wlan, &ea, GFP_ATOMIC);
+		}
+	}
+	if (p[1] == (T_AUTH_FRAME | 0x80) && len >= 1 + 24 + 6 && !p[BCO_MGMT_HDR] && b->wlan)
+		cfg80211_rx_mgmt(&b->wdev, b->sae_freq, 0, p + BCO_MGMT_HDR + 1, len - 1, 0);
+	/* the BCO's unasked credit reports (seq 0); FLOW's reply is also handled as one below */
+	if (p[1] == (T_FLOW | 0x80) && len >= BCO_FLOW_LEN && !p[BCO_MGMT_HDR])
+		bco_flow_apply(b, p + BCO_MGMT_HDR, false);
+	spin_lock_irqsave(&b->rx_lock, flags);
+	/* a link event (EVENTS' own reply is shorter): join_work reports it now, not at its next poll */
+	if (p[1] == (T_EVENTS | 0x80) && len >= BCO_EVENT_LEN && !p[BCO_MGMT_HDR]) {
+		b->ev_pending = true;
+		b->ev_type = p[BCO_MGMT_HDR + 1];
+		b->ev_reason = get_unaligned_le16(p + BCO_MGMT_HDR + 2);
+		mod_delayed_work(system_wq, &b->join_work, 0);
+	}
+	if (b->armed && p[1] == b->want_type && get_unaligned_be16(p + 2) == b->want_seq) {
+		memcpy(b->rsp, p + BCO_MGMT_HDR, len);
+		b->rsp_len = len;
+		b->armed = false;
+		complete(&b->done);
+	}
+	spin_unlock_irqrestore(&b->rx_lock, flags);
+}
+
+/*
+ * One request/reply on the control channel. Caller holds b->lock; the reply payload (status byte
+ * first) is in b->rsp/b->rsp_len until the caller drops it. The message is built once and cloned
+ * per try, so a PMK in it can be wiped from our copy afterwards.
+ */
+static int bco_req(struct bco *b, u8 type, const u8 *pl, unsigned int plen)
+{
+	struct net_device *net = b->usb->net;
+	unsigned int n = BCO_MGMT_HDR + plen;
+	struct sk_buff *skb;
+	int try, err = -ETIMEDOUT;
+	u8 *p;
+
+	lockdep_assert_held(&b->lock);
+	if (!netif_running(net))
+		return -ENETDOWN;
+	skb = alloc_skb(BCOLINK_HDR + n, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	p = skb_put(skb, BCOLINK_HDR + BCO_MGMT_HDR);
+	put_unaligned_le16(BCOLINK_CH_CTRL << 12 | n, p);
+	p[2] = 1;
+	p[3] = type;
+	put_unaligned_be16(++b->seq, p + 4);
+	put_unaligned_be16(plen, p + 6);
+	if (plen)
+		skb_put_data(skb, pl, plen);
+	skb->dev = net;
+	skb->protocol = BCO_SKB_PROTO;
+
+	spin_lock_bh(&b->rx_lock);
+	b->want_seq = b->seq;
+	b->want_type = type | 0x80;
+	b->rsp_len = 0;
+	b->armed = true;
+	reinit_completion(&b->done);
+	spin_unlock_bh(&b->rx_lock);
+
+	for (try = 0; try < 3; try++) {
+		struct sk_buff *c = skb_clone(skb, GFP_KERNEL);
+
+		if (!c) {
+			err = -ENOMEM;
+			break;
+		}
+		dev_queue_xmit(c);
+		if (wait_for_completion_timeout(&b->done, msecs_to_jiffies(500))) {
+			err = b->rsp_len && b->rsp[0] == 0 ? 0 : -EIO;
+			break;
+		}
+	}
+	spin_lock_bh(&b->rx_lock);
+	b->armed = false;
+	spin_unlock_bh(&b->rx_lock);
+	/* a clone still queued in usbnet holds the same data; only ours is wiped */
+	memzero_explicit(skb->data, skb->len);
+	kfree_skb(skb);
+	return err;
+}
+
+/*
+ * FLOW on, and count from its reply. A BCO that refuses or does not answer leaves channel 1
+ * without flow control, as with an app from before BCOLINK_CAP_FLOW. Caller holds b->lock.
+ */
+static int bco_flow_on(struct bco *b)
+{
+	unsigned long flags;
+	int err = bco_req(b, T_FLOW, (const u8[]){ 1 }, 1);
+
+	if (!err && b->rsp_len < BCO_FLOW_LEN)
+		err = -EPROTO;
+	if (!err) {
+		bco_flow_apply(b, b->rsp, true);
+		return 0;
+	}
+	spin_lock_irqsave(&b->flow_lock, flags);
+	b->flow = false;
+	bco_flow_wake(b);
+	spin_unlock_irqrestore(&b->flow_lock, flags);
+	return err;
+}
+
+/*
+ * Wi-Fi held without credit for BCO_FLOW_STUCK (a lost report or a frame lost on the link keeps
+ * the count off), or bcolink0 came back up: ask for a fresh report and count from it.
+ */
+static void bco_flow_watch(struct work_struct *w)
+{
+	struct bco *b = container_of(to_delayed_work(w), struct bco, flow_work);
+	unsigned long flags, due;
+	bool force, held;
+	int err;
+
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_FLOW))
+		return;
+	spin_lock_irqsave(&b->flow_lock, flags);
+	force = b->flow_resync;
+	b->flow_resync = false;
+	held = b->flow && !bco_credit(b);
+	due = b->stopped_at + BCO_FLOW_STUCK;
+	spin_unlock_irqrestore(&b->flow_lock, flags);
+	if (!force) {
+		if (!held)
+			return;
+		if (time_before(jiffies, due)) {
+			schedule_delayed_work(&b->flow_work, due - jiffies);
+			return;
+		}
+	}
+	mutex_lock(&b->lock);
+	err = bco_flow_on(b);
+	mutex_unlock(&b->lock);
+	if (err)
+		netdev_warn(b->usb->net, "BCO gives no transmit credit (%d): Wi-Fi without flow control\n",
+			    err);
+	else if (!force)
+		WRITE_ONCE(b->flow_resyncs, b->flow_resyncs + 1);
+}
+
+/* ---- usbnet minidriver: framing ---- */
+
+static int bco_rx_fixup(struct usbnet *dev, struct sk_buff *skb)
+{
+	struct bco *b = bco_of(dev);
+	struct net_device *port;
+	struct sk_buff *c;
+	unsigned int h, ch, len;
+
+	if (skb->len < BCOLINK_HDR)
+		return 0;
+	h = get_unaligned_le16(skb->data);
+	ch = h >> 12;
+	len = h & 0xfff;
+	if (len > BCOLINK_MAX || len > skb->len - BCOLINK_HDR)
+		return 0;
+	if (ch == BCOLINK_CH_CTRL) {
+		bco_ctrl_rx(b, skb->data + BCOLINK_HDR, len);
+		return 1;
+	}
+	port = ch == BCOLINK_CH_WIFI ? (READ_ONCE(b->ap_up) ? READ_ONCE(b->ap) : READ_ONCE(b->wlan)) :
+	       ch == BCOLINK_CH_WIRED ? READ_ONCE(b->eth) : NULL;
+	if (!port || len < ETH_HLEN)
+		return 0;
+	if (!netif_running(port) || !netif_carrier_ok(port)) {
+		dev_core_stats_rx_dropped_inc(port);
+		return 1;
+	}
+	c = skb_clone(skb, GFP_ATOMIC);
+	if (!c) {
+		dev_core_stats_rx_dropped_inc(port);
+		return 1;
+	}
+	skb_pull(c, BCOLINK_HDR);
+	skb_trim(c, len);
+	c->protocol = eth_type_trans(c, port);
+	dev_sw_netstats_rx_add(port, len);
+	netif_rx(c);
+	return 1;
+}
+
+static struct sk_buff *bco_tx_fixup(struct usbnet *dev, struct sk_buff *skb, gfp_t flags)
+{
+	if (skb->protocol != BCO_SKB_PROTO) {
+		dev_kfree_skb_any(skb);
+		return NULL;
+	}
+	usbnet_set_skb_tx_stats(skb, 1, 0);
+	return skb;
+}
+
+/* ---- ports ---- */
+
+static netdev_tx_t bco_port_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct bco_port *p = netdev_priv(dev);
+	struct net_device *net = p->b->usb->net;
+	unsigned int len = skb->len;
+
+	if (len > BCOLINK_MAX || !netif_running(net) || skb_cow_head(skb, BCOLINK_HDR)) {
+		dev_core_stats_tx_dropped_inc(dev);
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+	/* no transmit buffer free on the BCO: the frame waits in our qdisc, not dropped there */
+	if (p->ch == BCOLINK_CH_WIFI && READ_ONCE(p->b->flow) && !bco_flow_take(p->b, dev))
+		return NETDEV_TX_BUSY;
+	put_unaligned_le16(p->ch << 12 | len, skb_push(skb, BCOLINK_HDR));
+	skb->dev = net;
+	skb->protocol = BCO_SKB_PROTO;
+	dev_sw_netstats_tx_add(dev, 1, len);
+	dev_queue_xmit(skb);
+	return NETDEV_TX_OK;
+}
+
+/* A port up brings the transport up: userspace only ever touches wlan0 and eth0. */
+static int bco_port_open(struct net_device *dev)
+{
+	struct bco_port *p = netdev_priv(dev);
+	struct net_device *net = p->b->usb->net;
+
+	netif_start_queue(dev);	/* stopped for credit when it went down, perhaps */
+	return netif_running(net) ? 0 : dev_open(net, NULL);
+}
+
+/*
+ * eth0's carrier is the BCO's PHY link: WIRED_PROBE's reply is status, then le32 module ID,
+ * NCR, NCFGR, NSR, TSR, RSR and the port state (1 = link). A BCO app without a wired port
+ * refuses the request; eth0 then keeps the carrier it was opened with.
+ */
+static void bco_wired_poll(struct work_struct *w)
+{
+	struct bco *b = container_of(to_delayed_work(w), struct bco, wired_work);
+	struct net_device *eth = READ_ONCE(b->eth);
+	int link = -1;
+
+	if (!eth || !netif_running(eth))
+		return;
+	mutex_lock(&b->lock);
+	if (!bco_req(b, T_WIRED_PROBE, NULL, 0) && b->rsp_len >= 1 + 7 * 4)
+		link = get_unaligned_le32(b->rsp + 1 + 6 * 4) == 1;
+	mutex_unlock(&b->lock);
+	if (link == 1)
+		netif_carrier_on(eth);
+	else if (link == 0)
+		netif_carrier_off(eth);
+	schedule_delayed_work(&b->wired_work, BCO_WIRED_POLL);
+}
+
+static int bco_eth_open(struct net_device *dev)
+{
+	struct bco_port *p = netdev_priv(dev);
+	int err = bco_port_open(dev);
+
+	if (!err) {
+		netif_carrier_on(dev);
+		schedule_delayed_work(&p->b->wired_work, 0);
+	}
+	return err;
+}
+
+static int bco_eth_stop(struct net_device *dev)
+{
+	struct bco_port *p = netdev_priv(dev);
+
+	cancel_delayed_work_sync(&p->b->wired_work);
+	netif_carrier_off(dev);
+	return 0;
+}
+
+static const struct net_device_ops bco_eth_ops = {
+	.ndo_open = bco_eth_open,
+	.ndo_stop = bco_eth_stop,
+	.ndo_start_xmit = bco_port_xmit,
+	.ndo_set_mac_address = eth_mac_addr,
+	.ndo_validate_addr = eth_validate_addr,
+};
+
+static void bco_port_setup(struct net_device *dev)
+{
+	ether_setup(dev);
+	dev->needed_headroom = BCOLINK_HDR;
+	dev->max_mtu = BCOLINK_MAX - ETH_HLEN;
+	dev->lltx = true;
+	dev->pcpu_stat_type = NETDEV_PCPU_STAT_TSTATS;
+}
+
+/* ---- wlan0: cfg80211 over the control channel ---- */
+
+static int bco_chan_freq(int ch)
+{
+	return 2407 + 5 * ch;
+}
+
+static const u8 bco_rsn[] = { 0x30, 0x14, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 4,
+			      1, 0, 0x00, 0x0f, 0xac, 2, 0, 0 };
+
+/*
+ * One security IE from the BCO's detail: an RSN IE (OUI 00-0F-AC) or a WPA IE (vendor 00-50-F2
+ * type 1), the group, every pairwise suite and AKM of the sets, and for RSN the capabilities. So
+ * wpa_supplicant sees each network's real security: WPA only, TKIP, PMF. Returns its length.
+ */
+static unsigned int bco_sec_ie(u8 *q, bool rsn, u8 group, u8 pair, u8 akm, u8 caps)
+{
+	static const u8 rsn_oui[3] = { 0x00, 0x0f, 0xac }, wpa_oui[3] = { 0x00, 0x50, 0xf2 };
+	const u8 *oui = rsn ? rsn_oui : wpa_oui;
+	unsigned int n = 0, np = 0, na = 0, at;
+	u8 *len;
+
+	q[n++] = rsn ? WLAN_EID_RSN : WLAN_EID_VENDOR_SPECIFIC;
+	len = q + n++;
+	if (!rsn) {
+		memcpy(q + n, wpa_oui, 3);
+		n += 3;
+		q[n++] = 1;
+	}
+	q[n++] = 1, q[n++] = 0;
+	memcpy(q + n, oui, 3);
+	n += 3;
+	q[n++] = group;
+	at = n, n += 2;
+	if (pair & BCO_SET_CCMP) {
+		memcpy(q + n, oui, 3), q[n + 3] = 4, n += 4, np++;
+	}
+	if (pair & BCO_SET_TKIP) {
+		memcpy(q + n, oui, 3), q[n + 3] = 2, n += 4, np++;
+	}
+	put_unaligned_le16(np, q + at);
+	at = n, n += 2;
+	if (akm & BCO_SET_PSK) {
+		memcpy(q + n, oui, 3), q[n + 3] = 2, n += 4, na++;
+	}
+	if (rsn && (akm & BCO_SET_PSK256)) {
+		memcpy(q + n, oui, 3), q[n + 3] = 6, n += 4, na++;
+	}
+	if (rsn && (akm & BCO_SET_SAE)) {
+		memcpy(q + n, oui, 3), q[n + 3] = 8, n += 4, na++;
+	}
+	put_unaligned_le16(na, q + at);
+	if (rsn)
+		q[n++] = caps, q[n++] = 0;
+	*len = n - 2;
+	return n;
+}
+
+/*
+ * Put one BSS into the cfg80211 cache; returns a reference or NULL. det is the BCO's security
+ * detail (BCO_SCAN_DETAIL_LEN bytes) or NULL: then an RSN network shows as WPA2-PSK CCMP.
+ */
+static struct cfg80211_bss *bco_inform(struct bco *b, const u8 *ssid, u8 ssid_len, const u8 *bssid,
+				       u8 ch, s8 rssi, u8 sec, const u8 *det)
+{
+	u8 ie[2 + 32 + 3 + 2 * 40], *q = ie;
+	struct ieee80211_channel *c;
+
+	if (ssid_len > 32 || ch < 1 || ch > 13)
+		return NULL;
+	c = ieee80211_get_channel(b->wiphy, bco_chan_freq(ch));
+	if (!c)
+		return NULL;
+	*q++ = WLAN_EID_SSID, *q++ = ssid_len;
+	memcpy(q, ssid, ssid_len);
+	q += ssid_len;
+	*q++ = WLAN_EID_DS_PARAMS, *q++ = 1, *q++ = ch;
+	if (det) {
+		if (det[1] && sec != BCO_BSS_WEP)
+			q += bco_sec_ie(q, true, det[0], det[1], det[2], det[3]);
+		if (det[5])
+			q += bco_sec_ie(q, false, det[4], det[5], BCO_SET_PSK, 0);
+	} else if (sec == BCO_BSS_RSN) {
+		memcpy(q, bco_rsn, sizeof(bco_rsn));
+		q += sizeof(bco_rsn);
+	}
+	return cfg80211_inform_bss(b->wiphy, c, CFG80211_BSS_FTYPE_UNKNOWN, bssid, 0,
+				   WLAN_CAPABILITY_ESS | (sec ? WLAN_CAPABILITY_PRIVACY : 0),
+				   100, ie, q - ie, DBM_TO_MBM(rssi), GFP_KERNEL);
+}
+
+/*
+ * A scan runs on the BCO for ~11 s (13 channels, passive then probing). SCAN {1} starts it, SCAN {}
+ * polls; status 3 means still scanning. The lock is dropped between polls so STATUS keeps going.
+ */
+static void bco_scan_work(struct work_struct *w)
+{
+	struct bco *b = container_of(w, struct bco, scan_work);
+	struct cfg80211_scan_info info = { };
+	struct cfg80211_scan_request *req;
+	u8 start[2 + IEEE80211_MAX_SSID_LEN] = { BCO_SCAN_START };
+	bool detail = READ_ONCE(b->caps) & BCOLINK_CAP_SECURITY;
+	const u8 poll = BCO_SCAN_DETAIL;
+	unsigned int n_start = 1, i, size = 9 + (detail ? BCO_SCAN_DETAIL_LEN : 0);
+	int err, tries;
+
+	mutex_lock(&b->lock);
+	/* each entry with its security detail, from an app that has it (BCOLINK_CAP_SECURITY) */
+	if (detail)
+		start[0] |= BCO_SCAN_DETAIL;
+	/* SCAN {1, ssid_len, ssid}: the BCO's directed pass probes for it, so a hidden network answers */
+	req = b->scan_req;
+	for (i = 0; req && (b->caps & BCOLINK_CAP_SCAN_SSID) && i < req->n_ssids; i++)
+		if (req->ssids[i].ssid_len) {
+			start[1] = req->ssids[i].ssid_len;
+			memcpy(start + 2, req->ssids[i].ssid, start[1]);
+			n_start = 2 + start[1];
+			break;
+		}
+	err = bco_req(b, T_SCAN, start, n_start);
+	for (tries = 0; err == -EIO && b->rsp_len && b->rsp[0] == 3 && tries < 50; tries++) {
+		mutex_unlock(&b->lock);
+		msleep(500);
+		mutex_lock(&b->lock);
+		err = detail ? bco_req(b, T_SCAN, &poll, 1) : bco_req(b, T_SCAN, NULL, 0);
+	}
+	if (!err) {
+		const u8 *p = b->rsp + 2, *end = b->rsp + b->rsp_len;
+		unsigned int n = b->rsp_len > 1 ? b->rsp[1] : 0;
+
+		/* entry: ssid_len, ssid, bssid(6), channel, rssi (i8), security [, detail] */
+		while (n-- && p < end && p[0] <= 32 && p + 1 + p[0] + size <= end) {
+			const u8 *bssid = p + 1 + p[0];
+
+			cfg80211_put_bss(b->wiphy, bco_inform(b, p + 1, p[0], bssid, bssid[6],
+							      (s8)bssid[7], bssid[8],
+							      detail ? bssid + 9 : NULL));
+			p = bssid + size;
+		}
+	}
+	req = b->scan_req;
+	b->scan_req = NULL;
+	mutex_unlock(&b->lock);
+	if (req) {
+		info.aborted = !!err;
+		cfg80211_scan_done(req, &info);
+	}
+}
+
+static int bco_scan(struct wiphy *wiphy, struct cfg80211_scan_request *req)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	int err = 0;
+
+	mutex_lock(&b->lock);
+	if (b->scan_req || !b->running)
+		err = -EBUSY;
+	else
+		b->scan_req = req;
+	mutex_unlock(&b->lock);
+	if (!err)
+		schedule_work(&b->scan_work);
+	return err;
+}
+
+/*
+ * STATUS reply: status, state, ssid_len, ssid, bssid(6), channel, rssi, then (from apps that
+ * report it) why the last join failed: step, le16 IEEE status or reason code, and (from newer
+ * apps) the BSS's RSN group cipher suite type. Returns state or -1.
+ */
+static int bco_status(struct bco *b)
+{
+	const u8 *r = b->rsp;
+
+	if (bco_req(b, T_STATUS, NULL, 0) || b->rsp_len < 3 || r[2] > 32 ||
+	    b->rsp_len < 3 + r[2] + 8)
+		return -1;
+	return r[1];
+}
+
+/*
+ * The group cipher of the BSS in a STATUS reply already checked by bco_status, or NULL from an
+ * app that does not report it. An app without BCOLINK_CAP_SECURITY drops a TKIP group's frames
+ * (ARP, DHCP broadcasts); one with it deciphers them in software (ADR 0136). The log names it.
+ */
+static const char *bco_group_cipher(struct bco *b)
+{
+	const u8 *r = b->rsp;
+	unsigned int at = 3 + r[2] + 8 + 3;
+
+	if (b->rsp_len < at + 1)
+		return NULL;
+	switch (r[at]) {
+	case 0:
+		return "unknown";
+	case 2:
+		return "TKIP";
+	case 4:
+		return "CCMP";
+	}
+	return "other";
+}
+
+/*
+ * What the network in a STATUS reply already checked by bco_status offers, BCO_BSS_*, from apps
+ * that report it after the group cipher (BCOLINK_CAP_SECURITY); an older app joins RSN only.
+ */
+static u8 bco_status_sec(struct bco *b)
+{
+	const u8 *r = b->rsp;
+	unsigned int at = 3 + r[2] + 8 + 3 + 1;
+
+	return b->rsp_len >= at + 1 && r[at] <= BCO_BSS_WEP ? r[at] : BCO_BSS_RSN;
+}
+
+/* The security detail after it (BCOLINK_CAP_SECURITY), or NULL from an app without it. */
+static const u8 *bco_status_detail(struct bco *b)
+{
+	const u8 *r = b->rsp;
+	unsigned int at = 3 + r[2] + 8 + 3 + 1 + 1;
+
+	return b->rsp_len >= at + BCO_SCAN_DETAIL_LEN ? r + at : NULL;
+}
+
+/* The BCO's join failure steps (bco/app/src/wifi.h WIFI_FAIL_*). */
+enum { F_NONE, F_NOT_FOUND, F_SECURITY, F_AUTH, F_AUTH_TIMEOUT, F_ASSOC, F_ASSOC_TIMEOUT,
+	F_HANDSHAKE, F_KICKED };
+
+/*
+ * Why the join failed, as cfg80211 reports it to wpa_supplicant (CTRL-EVENT-ASSOC-REJECT
+ * status_code=...). A refusal carries the AP's own status code. The handshake runs on the BCO
+ * (4WAY_HANDSHAKE_STA_PSK), so wpa_supplicant never sees a wrong password itself: a handshake
+ * that did not complete is reported as 15 (challenge failure, never sent for open-system
+ * authentication), and security this station cannot join as 43 (invalid AKMP). soundtapd
+ * reads both. r is a STATUS reply already checked by bco_status.
+ */
+static void bco_join_result(struct bco *b, struct cfg80211_connect_resp_params *cr)
+{
+	const u8 *r = b->rsp;
+	const char *grp = bco_group_cipher(b);
+	unsigned int at = 3 + r[2] + 8, step = F_NONE, code = 0;
+
+	if (b->rsp_len >= at + 3) {
+		step = r[at];
+		code = get_unaligned_le16(r + at + 1);
+	}
+	cr->status = WLAN_STATUS_UNSPECIFIED_FAILURE;
+	switch (step) {
+	case F_NOT_FOUND:
+		cr->status = -1;
+		cr->timeout_reason = NL80211_TIMEOUT_SCAN;
+		break;
+	case F_SECURITY:
+		cr->status = WLAN_STATUS_INVALID_AKMP;
+		break;
+	case F_AUTH:
+	case F_ASSOC:
+		if (code)
+			cr->status = code;
+		break;
+	case F_AUTH_TIMEOUT:
+		cr->status = -1;
+		cr->timeout_reason = NL80211_TIMEOUT_AUTH;
+		break;
+	case F_ASSOC_TIMEOUT:
+		cr->status = -1;
+		cr->timeout_reason = NL80211_TIMEOUT_ASSOC;
+		break;
+	case F_HANDSHAKE:
+		cr->status = WLAN_STATUS_CHALLENGE_FAIL;
+		break;
+	}
+	if (b->wlan)
+		netdev_info(b->wlan, "BCO join failed: step %u, code %u%s%s\n", step, code,
+			    grp ? ", group cipher " : "", grp ?: "");
+}
+
+/*
+ * The connection after a link event, or a roam the BCO made. A deauthentication or disassociation
+ * carries the access point's reason; beacon loss and a wedged transmitter are local.
+ */
+static void bco_report_lost(struct bco *b, u8 ev, u16 reason)
+{
+	bool local = ev != BCO_EV_DEAUTH && ev != BCO_EV_DISASSOC;
+
+	if (local)
+		reason = ev == BCO_EV_BEACON_LOSS ? WLAN_REASON_DISASSOC_DUE_TO_INACTIVITY :
+						    WLAN_REASON_UNSPECIFIED;
+	else if (!reason)
+		reason = WLAN_REASON_UNSPECIFIED;
+	if (ev)
+		netdev_info(b->wlan, "BCO link lost: event %u, reason %u\n", ev, reason);
+	netif_carrier_off(b->wlan);
+	cfg80211_disconnected(b->wlan, reason, NULL, 0, local, GFP_KERNEL);
+}
+
+static void bco_join_poll(struct work_struct *w)
+{
+	struct bco *b = container_of(to_delayed_work(w), struct bco, join_work);
+	struct cfg80211_connect_resp_params cr = { };
+	struct cfg80211_bss *bss = NULL;
+	const char *grp = NULL;
+	unsigned long flags;
+	u8 ap[ETH_ALEN], ev = 0;
+	u16 reason = 0;
+	bool fail, lost = false, timeout;
+	int state;
+
+	mutex_lock(&b->lock);
+	if (!b->running || (!b->joining && !b->connected)) {
+		mutex_unlock(&b->lock);
+		return;
+	}
+	spin_lock_irqsave(&b->rx_lock, flags);
+	if (b->ev_pending) {
+		ev = b->ev_type;
+		reason = b->ev_reason;
+		b->ev_pending = false;
+	}
+	spin_unlock_irqrestore(&b->rx_lock, flags);
+	state = bco_status(b);
+	if (b->connected) {
+		/* the BCO is moving to another access point of the network (BCOLINK_CAP_ROAM) */
+		if (state == S_JOINING && (b->caps & BCOLINK_CAP_ROAM)) {
+			mutex_unlock(&b->lock);
+			schedule_delayed_work(&b->join_work, HZ / 2);
+			return;
+		}
+		lost = state != S_UP && state != -1;	/* a missed poll is not a lost link */
+		if (lost)
+			b->connected = false;
+		if (state == S_UP && !ether_addr_equal(b->rsp + 3 + b->rsp[2], b->bssid)) {
+			const u8 *r = b->rsp, *bssid = r + 3 + r[2];
+
+			bss = bco_inform(b, r + 3, r[2], bssid, bssid[6], (s8)bssid[7],
+					 bco_status_sec(b), bco_status_detail(b));
+			if (bss)
+				memcpy(b->bssid, bssid, ETH_ALEN);
+		}
+		mutex_unlock(&b->lock);
+		if (lost) {
+			bco_report_lost(b, ev, reason);
+			return;
+		}
+		if (bss) {
+			struct cfg80211_roam_info roam = { .links[0].bss = bss };
+
+			memcpy(ap, bss->bssid, ETH_ALEN);
+			netdev_info(b->wlan, "BCO roamed to %pM\n", ap);
+			cfg80211_roamed(b->wlan, &roam, GFP_KERNEL);	/* consumes the bss reference */
+			if (b->keyed)
+				cfg80211_port_authorized(b->wlan, ap, NULL, 0, GFP_KERNEL);
+		}
+		if (state == S_UP)
+			netif_carrier_on(b->wlan);	/* back after bcolink0 was down */
+		schedule_delayed_work(&b->join_work, BCO_LINK_POLL);
+		return;
+	}
+	if (state == S_UP) {
+		const u8 *r = b->rsp, *bssid = r + 3 + r[2];
+
+		/* the AP may not be in the scan cache: inform it from STATUS before reporting */
+		bss = bco_inform(b, r + 3, r[2], bssid, bssid[6], (s8)bssid[7], bco_status_sec(b),
+				 bco_status_detail(b));
+		grp = b->keyed ? bco_group_cipher(b) : NULL;
+	}
+	timeout = state != S_FAILED && state != S_UP && time_after(jiffies, b->join_deadline);
+	fail = state == S_FAILED || (state == S_UP && !bss) || timeout;
+	if (bss || fail) {
+		b->joining = false;
+		b->connected = !!bss;
+		if (bss)
+			memcpy(b->bssid, bss->bssid, ETH_ALEN);
+	}
+	if (!bss && fail) {
+		if (state == S_FAILED) {
+			bco_join_result(b, &cr);
+		} else if (timeout) {
+			/*
+			 * Stop the BCO's attempt before reporting: wpa_supplicant connects again at
+			 * once, and an attempt still running would answer that connect's STATUS polls.
+			 */
+			netdev_info(b->wlan, "BCO join timed out after %d s\n",
+				    BCO_JOIN_TIMEOUT / HZ);
+			bco_req(b, T_FORGET, NULL, 0);
+			cr.status = -1;
+			cr.timeout_reason = NL80211_TIMEOUT_UNSPECIFIED;
+		} else {
+			cr.status = WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+	}
+	mutex_unlock(&b->lock);
+
+	if (!bss && !fail) {
+		schedule_delayed_work(&b->join_work, HZ);
+		return;
+	}
+	if (bss)
+		cr.status = WLAN_STATUS_SUCCESS;
+	cr.links[0].bss = bss;
+	if (bss)
+		memcpy(ap, bss->bssid, ETH_ALEN);
+	cr.links[0].bssid = bss ? ap : NULL;
+	cfg80211_connect_done(b->wlan, &cr, GFP_KERNEL);	/* consumes the bss reference */
+	if (bss) {
+		if (grp)
+			netdev_info(b->wlan, "BCO joined %pM, group cipher %s\n", ap, grp);
+		/* the BCO did the 4-way handshake (4WAY_HANDSHAKE_STA_PSK): the port is open */
+		if (b->keyed)
+			cfg80211_port_authorized(b->wlan, ap, NULL, 0, GFP_KERNEL);
+		netif_carrier_on(b->wlan);
+		schedule_delayed_work(&b->join_work, BCO_LINK_POLL);
+	}
+}
+
+/*
+ * SET_PROFILE: ssid_len, ssid, security, key_len, key, 32 random bytes (the BCO's SNonce seed: it
+ * has no RNG) [, flags, bssid]. WPA-PSK goes down with the PMK handed down (handshake offload),
+ * never a passphrase; to an app that joins them (BCOLINK_CAP_SECURITY) an open network without a
+ * key, and WEP as key index, authentication and the default key (the connect's or the one
+ * add_key and set_default_key stored).
+ */
+static int bco_connect(struct wiphy *wiphy, struct net_device *dev,
+		       struct cfg80211_connect_params *sme)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	u8 pl[1 + 32 + 2 + WLAN_PMK_LEN + 32 + BCO_PROFILE_TAIL];
+	u32 caps = READ_ONCE(b->caps);
+	bool wep = sme->privacy && !sme->crypto.psk && !sme->crypto.wpa_versions &&
+		   (sme->crypto.cipher_group == WLAN_CIPHER_SUITE_WEP40 ||
+		    sme->crypto.cipher_group == WLAN_CIPHER_SUITE_WEP104 || sme->key_len);
+	bool open = !sme->privacy && !sme->crypto.psk && !sme->crypto.n_ciphers_pairwise &&
+		    !sme->crypto.wpa_versions && !sme->key_len;
+	/* SAE: wpa_supplicant runs it when the BCO asks (external authentication) */
+	bool sae = !sme->crypto.psk && sme->crypto.n_akm_suites &&
+		   sme->crypto.akm_suites[0] == WLAN_AKM_SUITE_SAE &&
+		   (sme->flags & CONNECT_REQ_EXTERNAL_AUTH_SUPPORT);
+	struct ieee80211_channel *ch = sme->channel ?: sme->channel_hint;
+	unsigned int n = 0, idx, klen;
+	const u8 *key;
+	int err;
+
+	if (sme->ssid_len < 1 || sme->ssid_len > 32 || (!open && !wep && !sae && !sme->crypto.psk) ||
+	    ((open || wep) && !(caps & BCOLINK_CAP_SECURITY)) || (sae && !(caps & BCOLINK_CAP_WPA3)))
+		return -EOPNOTSUPP;
+	mutex_lock(&b->lock);
+	idx = sme->key_len ? sme->key_idx : b->wep_def;
+	key = sme->key_len ? sme->key : b->wep[idx & 3];
+	klen = sme->key_len ?: b->wep_len[idx & 3];
+	mutex_unlock(&b->lock);
+	if (wep && (idx > 3 || (klen != WLAN_KEY_LEN_WEP40 && klen != WLAN_KEY_LEN_WEP104)))
+		return -EINVAL;
+	pl[n++] = sme->ssid_len;
+	memcpy(pl + n, sme->ssid, sme->ssid_len);
+	n += sme->ssid_len;
+	if (open || sae) {
+		pl[n++] = open ? BCO_SEC_OPEN : BCO_SEC_SAE;
+		pl[n++] = 0;
+	} else if (wep) {
+		pl[n++] = BCO_SEC_WEP;
+		pl[n++] = 2 + klen;
+		pl[n++] = idx;
+		pl[n++] = sme->auth_type == NL80211_AUTHTYPE_SHARED_KEY ? BCO_WEP_SHARED :
+			  sme->auth_type == NL80211_AUTHTYPE_OPEN_SYSTEM ? BCO_WEP_OPEN : BCO_WEP_AUTO;
+		memcpy(pl + n, key, klen);
+		n += klen;
+	} else {
+		pl[n++] = BCO_SEC_PSK;
+		pl[n++] = WLAN_PMK_LEN;
+		memcpy(pl + n, sme->crypto.psk, WLAN_PMK_LEN);
+		n += WLAN_PMK_LEN;
+	}
+	get_random_bytes(pl + n, 32);			/* the BCO's SNonce seed: it has no RNG */
+	n += 32;
+	/* the BSSID userspace asked for, and roaming within the SSID unless it fixed one */
+	if (caps & BCOLINK_CAP_ROAM) {
+		pl[n++] = sme->bssid ? BCO_PROFILE_BSSID_FIXED :
+			  BCO_PROFILE_ROAM | (sme->bssid_hint ? BCO_PROFILE_BSSID_HINT : 0);
+		if (sme->bssid || sme->bssid_hint)
+			memcpy(pl + n, sme->bssid ?: sme->bssid_hint, ETH_ALEN);
+		else
+			eth_zero_addr(pl + n);
+		n += ETH_ALEN;
+	}
+	mutex_lock(&b->lock);
+	err = b->running ? bco_req(b, T_SET_PROFILE, pl, n) : -ENETDOWN;
+	if (!err) {
+		b->joining = true;
+		b->connected = false;
+		b->keyed = !open && !wep;
+		b->sae_freq = ch ? ch->center_freq : bco_chan_freq(6);
+		b->join_deadline = jiffies + BCO_JOIN_TIMEOUT;
+	}
+	mutex_unlock(&b->lock);
+	memzero_explicit(pl, sizeof(pl));
+	if (!err)
+		schedule_delayed_work(&b->join_work, HZ / 2);
+	return err;
+}
+
+/*
+ * Keys from userspace. The BCO derives and installs every WPA key itself (handshake offload), so
+ * only a static WEP default key is taken: wpa_supplicant sets it before the connect, and cfg80211
+ * uploads the connect's keys again once connected. Stored here; the BCO gets the default one in
+ * SET_PROFILE and holds it there.
+ */
+static int bco_add_key(struct wiphy *wiphy, struct net_device *dev, int link_id, u8 idx,
+		       bool pairwise, const u8 *mac, struct key_params *params)
+{
+	struct bco *b = wiphy_priv(wiphy);
+
+	if (pairwise || mac || idx > 3 ||
+	    (params->cipher != WLAN_CIPHER_SUITE_WEP40 && params->cipher != WLAN_CIPHER_SUITE_WEP104) ||
+	    (params->key_len != WLAN_KEY_LEN_WEP40 && params->key_len != WLAN_KEY_LEN_WEP104))
+		return -EOPNOTSUPP;
+	mutex_lock(&b->lock);
+	memcpy(b->wep[idx], params->key, params->key_len);
+	b->wep_len[idx] = params->key_len;
+	mutex_unlock(&b->lock);
+	return 0;
+}
+
+static int bco_del_key(struct wiphy *wiphy, struct net_device *dev, int link_id, u8 idx,
+		       bool pairwise, const u8 *mac)
+{
+	struct bco *b = wiphy_priv(wiphy);
+
+	if (!pairwise && !mac && idx < 4) {
+		mutex_lock(&b->lock);
+		memzero_explicit(b->wep[idx], sizeof(b->wep[idx]));
+		b->wep_len[idx] = 0;
+		mutex_unlock(&b->lock);
+	}
+	return 0;
+}
+
+/*
+ * WPA3-SAE over cfg80211's external authentication (BCOLINK_CAP_WPA3, ADR 0136): wpa_supplicant
+ * sends its SAE frames with mgmt_tx, which go to the BCO for the access point; it hands the PMK
+ * SAE derived over set_pmksa and the result over external_auth; the BCO then associates and runs
+ * the 4-way with that PMK.
+ */
+static void bco_tx_work(struct work_struct *w)
+{
+	struct bco *b = container_of(w, struct bco, tx_work);
+
+	if (b->wlan)
+		cfg80211_mgmt_tx_status(&b->wdev, b->tx_cookie, b->tx_frame, b->tx_len, b->tx_ack,
+					GFP_KERNEL);
+}
+
+static int bco_mgmt_tx(struct wiphy *wiphy, struct wireless_dev *wdev,
+		       struct cfg80211_mgmt_tx_params *params, u64 *cookie)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	const u8 *f = params->buf;
+	int err;
+
+	/* SAE authentication frames only: algorithm 3, from the station */
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_WPA3) || params->len < 24 + 6 ||
+	    params->len > sizeof(b->tx_frame) || f[0] != 0xb0 || get_unaligned_le16(f + 24) != 3)
+		return -EOPNOTSUPP;
+	mutex_lock(&b->lock);
+	err = b->running ? bco_req(b, T_AUTH_FRAME, f + 24, params->len - 24) : -ENETDOWN;
+	if (err != -ENETDOWN) {
+		flush_work(&b->tx_work);
+		memcpy(b->tx_frame, f, params->len);
+		b->tx_len = params->len;
+		b->tx_cookie++;			/* any value but 0: this frame's TX status */
+		b->tx_ack = !err;
+		*cookie = b->tx_cookie;
+	}
+	mutex_unlock(&b->lock);
+	if (err == -ENETDOWN)
+		return err;
+	/* the status after the cookie: wpa_supplicant matches it to this request's reply */
+	schedule_work(&b->tx_work);
+	return 0;
+}
+
+static int bco_external_auth(struct wiphy *wiphy, struct net_device *dev,
+			     struct cfg80211_external_auth_params *params)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	u8 pl[2 + ETH_ALEN];
+	int err;
+
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_WPA3))
+		return -EOPNOTSUPP;
+	put_unaligned_le16(params->status, pl);
+	memcpy(pl + 2, params->bssid, ETH_ALEN);
+	mutex_lock(&b->lock);
+	err = b->running ? bco_req(b, T_EXT_AUTH, pl, sizeof(pl)) : -ENETDOWN;
+	mutex_unlock(&b->lock);
+	return err;
+}
+
+/*
+ * The PMK of an SAE exchange (wpa_supplicant adds it to the PMKSA cache with the PMK) goes to the
+ * BCO, which holds it for the 4-way; nothing else of the cache is kept here.
+ */
+static int bco_set_pmksa(struct wiphy *wiphy, struct net_device *dev, struct cfg80211_pmksa *pmksa)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	u8 pl[ETH_ALEN + WLAN_PMK_LEN];
+	int err = 0;
+
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_WPA3) || !pmksa->bssid || !pmksa->pmk ||
+	    pmksa->pmk_len != WLAN_PMK_LEN)
+		return 0;
+	memcpy(pl, pmksa->bssid, ETH_ALEN);
+	memcpy(pl + ETH_ALEN, pmksa->pmk, WLAN_PMK_LEN);
+	mutex_lock(&b->lock);
+	err = b->running ? bco_req(b, T_SET_PMK, pl, sizeof(pl)) : -ENETDOWN;
+	mutex_unlock(&b->lock);
+	memzero_explicit(pl, sizeof(pl));
+	return err;
+}
+
+static int bco_del_pmksa(struct wiphy *wiphy, struct net_device *dev, struct cfg80211_pmksa *pmksa)
+{
+	return 0;
+}
+
+static int bco_flush_pmksa(struct wiphy *wiphy, struct net_device *dev)
+{
+	return 0;
+}
+
+/* SAE frames to and from wpa_supplicant on the station; the access point keeps none (its SME
+ * is in the device), as before. */
+static const struct ieee80211_txrx_stypes bco_mgmt_stypes[NUM_NL80211_IFTYPES] = {
+	[NL80211_IFTYPE_STATION] = {
+		.tx = BIT(IEEE80211_STYPE_AUTH >> 4),
+		.rx = BIT(IEEE80211_STYPE_AUTH >> 4),
+	},
+};
+
+static int bco_set_default_key(struct wiphy *wiphy, struct net_device *dev, int link_id, u8 idx,
+			       bool unicast, bool multicast)
+{
+	struct bco *b = wiphy_priv(wiphy);
+
+	if (idx > 3)
+		return -EINVAL;
+	mutex_lock(&b->lock);
+	b->wep_def = idx;
+	mutex_unlock(&b->lock);
+	return 0;
+}
+
+static int bco_disconnect(struct wiphy *wiphy, struct net_device *dev, u16 reason)
+{
+	struct bco *b = wiphy_priv(wiphy);
+
+	mutex_lock(&b->lock);
+	b->joining = false;
+	b->connected = false;
+	mutex_unlock(&b->lock);
+	cancel_delayed_work_sync(&b->join_work);
+	mutex_lock(&b->lock);
+	bco_req(b, T_FORGET, NULL, 0);
+	mutex_unlock(&b->lock);
+	netif_carrier_off(dev);
+	cfg80211_disconnected(dev, reason, NULL, 0, true, GFP_KERNEL);
+	return 0;
+}
+
+/*
+ * Client i of the AP_STATUS reply in b->rsp: its MAC and, when the app sends per-client counters
+ * (BCOLINK_CAP_APDIAG) and sinfo is given, how long it has been silent, the frames from it (data
+ * and null-data), the unicast frames to it and how many of them were lost. -ENOENT past the last.
+ */
+static int bco_ap_client(struct bco *b, int i, u8 *mac, struct station_info *sinfo)
+{
+	unsigned int n = b->rsp_len, at;
+	const u8 *k;
+
+	if (n < 2 || i >= b->rsp[1] || 2 + 6 * (i + 1) > n)
+		return -ENOENT;
+	memcpy(mac, b->rsp + 2 + 6 * i, ETH_ALEN);
+	at = 2 + 6 * b->rsp[1] + 4 * (BCO_AP_COUNTERS + BCO_AP_DIAG) + BCO_AP_CLIENT * i;
+	if (!sinfo || !(READ_ONCE(b->caps) & BCOLINK_CAP_APDIAG) || at + BCO_AP_CLIENT > n)
+		return 0;
+	k = b->rsp + at;
+	sinfo->filled |= BIT_ULL(NL80211_STA_INFO_INACTIVE_TIME) | BIT_ULL(NL80211_STA_INFO_RX_PACKETS) |
+			 BIT_ULL(NL80211_STA_INFO_TX_PACKETS) | BIT_ULL(NL80211_STA_INFO_TX_FAILED);
+	sinfo->inactive_time = get_unaligned_le32(k + 4);
+	sinfo->rx_packets = get_unaligned_le32(k + 8) + get_unaligned_le32(k + 12);
+	sinfo->tx_packets = get_unaligned_le32(k + 16) + get_unaligned_le32(k + 20);
+	sinfo->tx_failed = get_unaligned_le32(k + 20);
+	return 0;
+}
+
+/*
+ * The setup AP's clients one by one, as the BCO lists them: `iw dev wlan1 station dump`, which
+ * soundtapd reads to tell an idle setup AP from one a phone is on. Without it the dump was empty
+ * and the setup AP went down under a phone. wlan0 lists nothing (`iw dev wlan0 link` has it).
+ */
+static int bco_dump_station(struct wiphy *wiphy, struct net_device *dev, int idx, u8 *mac,
+			    struct station_info *sinfo)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	int err = -ENOENT;
+
+	if (dev != b->ap)
+		return -ENOENT;
+	mutex_lock(&b->lock);
+	if (!bco_req(b, T_AP_STATUS, NULL, 0))
+		err = bco_ap_client(b, idx, mac, sinfo);
+	mutex_unlock(&b->lock);
+	return err;
+}
+
+static int bco_get_station(struct wiphy *wiphy, struct net_device *dev, const u8 *mac,
+			   struct station_info *sinfo)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	int err = -ENOENT, i;
+
+	mutex_lock(&b->lock);
+	if (dev == b->ap) {
+		u8 m[ETH_ALEN];
+
+		if (!bco_req(b, T_AP_STATUS, NULL, 0))
+			for (i = 0; err && !bco_ap_client(b, i, m, NULL); i++)
+				if (ether_addr_equal(m, mac))
+					err = bco_ap_client(b, i, m, sinfo);
+	} else if (bco_status(b) == S_UP) {
+		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_SIGNAL);
+		sinfo->signal = (s8)b->rsp[3 + b->rsp[2] + 7];
+		err = 0;
+	}
+	mutex_unlock(&b->lock);
+	return err;
+}
+
+/* ---- wlan1: the access point ---- */
+
+static int bco_ap_stop_link(struct net_device *dev)
+{
+	netif_carrier_off(dev);
+	return 0;
+}
+
+static const struct net_device_ops bco_ap_ops = {
+	.ndo_open = bco_port_open,
+	.ndo_stop = bco_ap_stop_link,
+	.ndo_start_xmit = bco_port_xmit,
+	.ndo_set_mac_address = eth_mac_addr,
+	.ndo_validate_addr = eth_validate_addr,
+};
+
+/*
+ * AP_START: channel, beacon interval (network order), beacon body. hostapd hands the beacon as head
+ * (header, fixed fields, IEs before TIM) and tail; a non-mac80211 device inserts the TIM itself.
+ */
+static int bco_start_ap(struct wiphy *wiphy, struct net_device *dev, struct cfg80211_ap_settings *s)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	const struct cfg80211_beacon_data *bd = &s->beacon;
+	unsigned int hl = bd->head_len > 24 ? bd->head_len - 24 : 0, n = 3 + hl + 6 + bd->tail_len;
+	u8 *pl;
+	int err;
+
+	if (hl < 12 || n - 3 > 512 || s->hidden_ssid || s->privacy || !s->chandef.chan)
+		return -EOPNOTSUPP;
+	/* the BCO refuses AP_START mid-scan; a scan takes ~11 s, so let a pending one finish */
+	flush_work(&b->scan_work);
+	pl = kmalloc(n, GFP_KERNEL);
+	if (!pl)
+		return -ENOMEM;
+	pl[0] = ieee80211_frequency_to_channel(s->chandef.chan->center_freq);
+	put_unaligned_be16(s->beacon_interval, pl + 1);
+	memcpy(pl + 3, bd->head + 24, hl);
+	memcpy(pl + 3 + hl, (u8[]){ WLAN_EID_TIM, 4, 0, s->dtim_period ?: 1, 0, 0 }, 6);
+	memcpy(pl + 3 + hl + 6, bd->tail, bd->tail_len);
+	mutex_lock(&b->lock);
+	err = bco_req(b, T_AP_START, pl, n);
+	if (!err)
+		WRITE_ONCE(b->ap_up, true);
+	mutex_unlock(&b->lock);
+	kfree(pl);
+	if (!err)
+		netif_carrier_on(dev);
+	return err;
+}
+
+static int bco_stop_ap(struct wiphy *wiphy, struct net_device *dev, unsigned int link_id)
+{
+	struct bco *b = wiphy_priv(wiphy);
+
+	netif_carrier_off(dev);
+	mutex_lock(&b->lock);
+	WRITE_ONCE(b->ap_up, false);
+	bco_req(b, T_AP_STOP, NULL, 0);
+	mutex_unlock(&b->lock);
+	return 0;
+}

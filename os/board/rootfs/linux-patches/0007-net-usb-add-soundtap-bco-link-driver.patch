+/* ---- regulatory domain (BCOLINK_CAP_REGDOM) ---- */
+
+/*
+ * cfg80211 settled on a regulatory domain (`iw reg set`, soundtapd's country): the channels it
+ * leaves enabled, those only for listening (NO_IR) and the lowest power limit among them go to the
+ * BCO. The request is sent from a work item, since the notifier runs under RTNL.
+ */
+static void bco_reg_notifier(struct wiphy *wiphy, struct regulatory_request *req)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	const struct ieee80211_supported_band *sb = wiphy->bands[NL80211_BAND_2GHZ];
+	unsigned long flags;
+	u16 chans = 0, passive = 0;
+	int i, dbm = 30;
+
+	if (!sb)
+		return;
+	for (i = 0; i < sb->n_channels; i++) {
+		const struct ieee80211_channel *c = &sb->channels[i];
+
+		if ((c->flags & IEEE80211_CHAN_DISABLED) || c->hw_value < 1 || c->hw_value > 13)
+			continue;
+		chans |= BIT(c->hw_value - 1);
+		if (c->flags & IEEE80211_CHAN_NO_IR)
+			passive |= BIT(c->hw_value - 1);
+		dbm = min(dbm, c->max_reg_power ?: c->max_power);
+	}
+	if (!chans)
+		return;		/* nothing usable: the BCO keeps what it has */
+	spin_lock_irqsave(&b->rx_lock, flags);
+	b->regdom[0] = req->alpha2[0];
+	b->regdom[1] = req->alpha2[1];
+	put_unaligned_le16(chans, b->regdom + 2);
+	put_unaligned_le16(passive, b->regdom + 4);
+	b->regdom[6] = clamp(dbm, 0, 30);
+	spin_unlock_irqrestore(&b->rx_lock, flags);
+	schedule_work(&b->reg_work);
+}
+
+static void bco_reg_work(struct work_struct *w)
+{
+	struct bco *b = container_of(w, struct bco, reg_work);
+	struct net_device *net = b->usb->net;
+	u8 pl[BCO_REGDOM_LEN];
+	unsigned long flags;
+	bool enforced;
+	int err;
+
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_REGDOM))
+		return;
+	spin_lock_irqsave(&b->rx_lock, flags);
+	memcpy(pl, b->regdom, sizeof(pl));
+	spin_unlock_irqrestore(&b->rx_lock, flags);
+	if (!get_unaligned_le16(pl + 2))
+		return;
+	mutex_lock(&b->lock);
+	err = bco_req(b, T_SET_REGDOM, pl, sizeof(pl));
+	enforced = !err && b->rsp_len >= 2 && b->rsp[1];
+	mutex_unlock(&b->lock);
+	if (err)
+		netdev_warn(net, "BCO refused regulatory domain %c%c (%d)\n", pl[0], pl[1], err);
+	else
+		netdev_info(net, "BCO regulatory domain %c%c: channels %#x, passive %#x, %d dBm%s\n",
+			    pl[0], pl[1], get_unaligned_le16(pl + 2), get_unaligned_le16(pl + 4),
+			    (s8)pl[6], enforced ? "" : " (limit not enforced by the BCO)");
+}

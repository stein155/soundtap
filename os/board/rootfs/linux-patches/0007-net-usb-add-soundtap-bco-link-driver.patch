+/* Stop all work before cfg80211 tears the interface down: a pending scan is finished here. */
+static int bco_wlan_stop(struct net_device *dev)
+{
+	struct bco *b = ((struct bco_port *)netdev_priv(dev))->b;
+	struct cfg80211_scan_info info = { .aborted = true };
+	struct cfg80211_scan_request *req;
+
+	mutex_lock(&b->lock);
+	b->running = false;
+	b->joining = false;
+	b->connected = false;
+	mutex_unlock(&b->lock);
+	cancel_delayed_work_sync(&b->join_work);
+	cancel_work_sync(&b->scan_work);
+	mutex_lock(&b->lock);
+	req = b->scan_req;
+	b->scan_req = NULL;
+	mutex_unlock(&b->lock);
+	if (req)
+		cfg80211_scan_done(req, &info);
+	netif_carrier_off(dev);
+	return 0;
+}

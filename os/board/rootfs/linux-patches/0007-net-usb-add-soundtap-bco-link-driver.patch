+static void bco_port_setup(struct net_device *dev)
+{
+	ether_setup(dev);
+	dev->needed_headroom = BCOLINK_HDR;
+	dev->max_mtu = BCOLINK_MAX - ETH_HLEN;
+	dev->lltx = true;
+	dev->pcpu_stat_type = NETDEV_PCPU_STAT_TSTATS;
+}

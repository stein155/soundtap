+/* ---- wlan0: cfg80211 over the control channel ---- */
+
+static int bco_chan_freq(int ch)
+{
+	return 2407 + 5 * ch;
+}
+
+static const u8 bco_rsn[] = { 0x30, 0x14, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 4,
+			      1, 0, 0x00, 0x0f, 0xac, 2, 0, 0 };
+
+/* Put one BSS into the cfg80211 cache; returns a reference or NULL. */
+static struct cfg80211_bss *bco_inform(struct bco *b, const u8 *ssid, u8 ssid_len, const u8 *bssid,
+				       u8 ch, s8 rssi, u8 sec)
+{
+	u8 ie[2 + 32 + 3 + sizeof(bco_rsn)], *q = ie;
+	struct ieee80211_channel *c;
+
+	if (ssid_len > 32 || ch < 1 || ch > 13)
+		return NULL;
+	c = ieee80211_get_channel(b->wiphy, bco_chan_freq(ch));
+	if (!c)
+		return NULL;
+	*q++ = WLAN_EID_SSID, *q++ = ssid_len;
+	memcpy(q, ssid, ssid_len);
+	q += ssid_len;
+	*q++ = WLAN_EID_DS_PARAMS, *q++ = 1, *q++ = ch;
+	if (sec == 1) {
+		memcpy(q, bco_rsn, sizeof(bco_rsn));
+		q += sizeof(bco_rsn);
+	}
+	return cfg80211_inform_bss(b->wiphy, c, CFG80211_BSS_FTYPE_UNKNOWN, bssid, 0,
+				   WLAN_CAPABILITY_ESS | (sec ? WLAN_CAPABILITY_PRIVACY : 0),
+				   100, ie, q - ie, DBM_TO_MBM(rssi), GFP_KERNEL);
+}
+
+/*
+ * A scan runs on the BCO for ~11 s (13 channels, passive then probing). SCAN {1} starts it, SCAN {}
+ * polls; status 3 means still scanning. The lock is dropped between polls so STATUS keeps going.
+ */
+static void bco_scan_work(struct work_struct *w)
+{
+	struct bco *b = container_of(w, struct bco, scan_work);
+	struct cfg80211_scan_info info = { };
+	struct cfg80211_scan_request *req;
+	const u8 start = 1;
+	int err, tries;
+
+	mutex_lock(&b->lock);
+	err = bco_req(b, T_SCAN, &start, 1);
+	for (tries = 0; err == -EIO && b->rsp_len && b->rsp[0] == 3 && tries < 50; tries++) {
+		mutex_unlock(&b->lock);
+		msleep(500);
+		mutex_lock(&b->lock);
+		err = bco_req(b, T_SCAN, NULL, 0);
+	}
+	if (!err) {
+		const u8 *p = b->rsp + 2, *end = b->rsp + b->rsp_len;
+		unsigned int n = b->rsp_len > 1 ? b->rsp[1] : 0;
+
+		/* entry: ssid_len, ssid, bssid(6), channel, rssi (i8), security */
+		while (n-- && p < end && p[0] <= 32 && p + 1 + p[0] + 9 <= end) {
+			const u8 *bssid = p + 1 + p[0];
+
+			cfg80211_put_bss(b->wiphy, bco_inform(b, p + 1, p[0], bssid, bssid[6],
+							      (s8)bssid[7], bssid[8]));
+			p = bssid + 9;
+		}
+	}
+	req = b->scan_req;
+	b->scan_req = NULL;
+	mutex_unlock(&b->lock);
+	if (req) {
+		info.aborted = !!err;
+		cfg80211_scan_done(req, &info);
+	}
+}
+
+static int bco_scan(struct wiphy *wiphy, struct cfg80211_scan_request *req)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	int err = 0;
+
+	mutex_lock(&b->lock);
+	if (b->scan_req || !b->running)
+		err = -EBUSY;
+	else
+		b->scan_req = req;
+	mutex_unlock(&b->lock);
+	if (!err)
+		schedule_work(&b->scan_work);
+	return err;
+}
+
+/* STATUS reply: status, state, ssid_len, ssid, bssid(6), channel, rssi. Returns state or -1. */
+static int bco_status(struct bco *b)
+{
+	const u8 *r = b->rsp;
+
+	if (bco_req(b, T_STATUS, NULL, 0) || b->rsp_len < 3 || r[2] > 32 ||
+	    b->rsp_len < 3 + r[2] + 8)
+		return -1;
+	return r[1];
+}
+
+static void bco_join_poll(struct work_struct *w)
+{
+	struct bco *b = container_of(to_delayed_work(w), struct bco, join_work);
+	struct cfg80211_connect_resp_params cr = { };
+	struct cfg80211_bss *bss = NULL;
+	u8 ap[ETH_ALEN];
+	bool fail, lost = false;
+	int state;
+
+	mutex_lock(&b->lock);
+	if (!b->running || (!b->joining && !b->connected)) {
+		mutex_unlock(&b->lock);
+		return;
+	}
+	state = bco_status(b);
+	if (b->connected) {
+		lost = state != S_UP && state != -1;	/* a missed poll is not a lost link */
+		if (lost)
+			b->connected = false;
+		mutex_unlock(&b->lock);
+		if (lost) {
+			netif_carrier_off(b->wlan);
+			cfg80211_disconnected(b->wlan, WLAN_REASON_UNSPECIFIED, NULL, 0, false,
+					      GFP_KERNEL);
+		} else {
+			if (state == S_UP)
+				netif_carrier_on(b->wlan);	/* back after bcolink0 was down */
+			schedule_delayed_work(&b->join_work, BCO_LINK_POLL);
+		}
+		return;
+	}
+	if (state == S_UP) {
+		const u8 *r = b->rsp, *bssid = r + 3 + r[2];
+
+		/* the AP may not be in the scan cache: inform it from STATUS before reporting */
+		bss = bco_inform(b, r + 3, r[2], bssid, bssid[6], (s8)bssid[7], 1);
+	}
+	fail = state == S_FAILED || (state == S_UP && !bss) ||
+	       time_after(jiffies, b->join_deadline);
+	if (bss || fail) {
+		b->joining = false;
+		b->connected = !!bss;
+	}
+	mutex_unlock(&b->lock);
+
+	if (!bss && !fail) {
+		schedule_delayed_work(&b->join_work, HZ);
+		return;
+	}
+	cr.status = bss ? WLAN_STATUS_SUCCESS : WLAN_STATUS_UNSPECIFIED_FAILURE;
+	cr.links[0].bss = bss;
+	if (bss)
+		memcpy(ap, bss->bssid, ETH_ALEN);
+	cr.links[0].bssid = bss ? ap : NULL;
+	cfg80211_connect_done(b->wlan, &cr, GFP_KERNEL);	/* consumes the bss reference */
+	if (bss) {
+		/* the BCO did the 4-way handshake (4WAY_HANDSHAKE_STA_PSK): the port is open */
+		cfg80211_port_authorized(b->wlan, ap, NULL, 0, GFP_KERNEL);
+		netif_carrier_on(b->wlan);
+		schedule_delayed_work(&b->join_work, BCO_LINK_POLL);
+	}
+}
+
+static int bco_connect(struct wiphy *wiphy, struct net_device *dev,
+		       struct cfg80211_connect_params *sme)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	u8 pl[1 + 32 + 2 + WLAN_PMK_LEN + 32];
+	unsigned int n = 0;
+	int err;
+
+	/* WPA2-PSK only, with the PMK handed down (handshake offload), never a passphrase */
+	if (sme->ssid_len < 1 || sme->ssid_len > 32 || !sme->crypto.psk)
+		return -EOPNOTSUPP;
+	pl[n++] = sme->ssid_len;
+	memcpy(pl + n, sme->ssid, sme->ssid_len);
+	n += sme->ssid_len;
+	pl[n++] = 1;
+	pl[n++] = WLAN_PMK_LEN;
+	memcpy(pl + n, sme->crypto.psk, WLAN_PMK_LEN);
+	n += WLAN_PMK_LEN;
+	get_random_bytes(pl + n, 32);			/* the BCO's SNonce seed: it has no RNG */
+	n += 32;
+	mutex_lock(&b->lock);
+	err = b->running ? bco_req(b, T_SET_PROFILE, pl, n) : -ENETDOWN;
+	if (!err) {
+		b->joining = true;
+		b->connected = false;
+		b->join_deadline = jiffies + BCO_JOIN_TIMEOUT;
+	}
+	mutex_unlock(&b->lock);
+	memzero_explicit(pl, sizeof(pl));
+	if (!err)
+		schedule_delayed_work(&b->join_work, HZ / 2);
+	return err;
+}
+
+static int bco_disconnect(struct wiphy *wiphy, struct net_device *dev, u16 reason)
+{
+	struct bco *b = wiphy_priv(wiphy);
+
+	mutex_lock(&b->lock);
+	b->joining = false;
+	b->connected = false;
+	mutex_unlock(&b->lock);
+	cancel_delayed_work_sync(&b->join_work);
+	mutex_lock(&b->lock);
+	bco_req(b, T_FORGET, NULL, 0);
+	mutex_unlock(&b->lock);
+	netif_carrier_off(dev);
+	cfg80211_disconnected(dev, reason, NULL, 0, true, GFP_KERNEL);
+	return 0;
+}
+
+static int bco_get_station(struct wiphy *wiphy, struct net_device *dev, const u8 *mac,
+			   struct station_info *sinfo)
+{
+	struct bco *b = wiphy_priv(wiphy);
+	int err = -ENOENT, i;
+
+	mutex_lock(&b->lock);
+	if (dev == b->ap) {
+		/* AP_STATUS reply: status, count, client MACs */
+		if (!bco_req(b, T_AP_STATUS, NULL, 0) && b->rsp_len >= 2)
+			for (i = 0; i < b->rsp[1] && 2 + 6 * (i + 1) <= b->rsp_len; i++)
+				if (ether_addr_equal(b->rsp + 2 + 6 * i, mac))
+					err = 0;
+	} else if (bco_status(b) == S_UP) {
+		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_SIGNAL);
+		sinfo->signal = (s8)b->rsp[3 + b->rsp[2] + 7];
+		err = 0;
+	}
+	mutex_unlock(&b->lock);
+	return err;
+}

+/* ---- bring-up ---- */
+
+static struct net_device *bco_port_new(struct bco *b, const char *name, u8 ch,
+				       const struct net_device_ops *ops, const u8 *mac)
+{
+	struct net_device *dev = alloc_netdev(sizeof(struct bco_port), name, NET_NAME_ENUM,
+					      bco_port_setup);
+	struct bco_port *p;
+
+	if (!dev)
+		return NULL;
+	p = netdev_priv(dev);
+	p->b = b;
+	p->ch = ch;
+	dev->netdev_ops = ops;
+	eth_hw_addr_set(dev, mac);
+	SET_NETDEV_DEV(dev, &b->usb->intf->dev);
+	netif_carrier_off(dev);
+	return dev;
+}
+
+/*
+ * After probe: bring the transport up, ask the BCO who it is, then register wiphy, wlan0 and eth0.
+ * A device that does not answer HELLO keeps only bcolink0.
+ */
+static void bco_setup_work(struct work_struct *w)
+{
+	struct bco *b = container_of(w, struct bco, setup);
+	struct net_device *net = b->usb->net, *wlan = NULL, *eth = NULL;
+	struct wiphy *wiphy = b->wiphy;
+	u8 mac[ETH_ALEN];
+	int i, err;
+
+	rtnl_lock();
+	err = net->reg_state == NETREG_REGISTERED ? dev_open(net, NULL) : -ENODEV;
+	rtnl_unlock();
+	if (err)
+		goto fail;
+
+	/* HELLO reply: status, ver_len, ver, wifi mac, state, uptime(4), proto, caps(4) */
+	mutex_lock(&b->lock);
+	err = bco_req(b, T_HELLO, NULL, 0);
+	if (!err && (b->rsp_len < 2 || b->rsp_len < 2 + b->rsp[1] + ETH_ALEN ||
+		     !is_valid_ether_addr(b->rsp + 2 + b->rsp[1])))
+		err = -EPROTO;
+	if (!err) {
+		unsigned int at = 2 + b->rsp[1] + ETH_ALEN + 1 + 4;
+
+		memcpy(mac, b->rsp + 2 + b->rsp[1], ETH_ALEN);
+		netdev_info(net, "BCO app %.*s\n", b->rsp[1], b->rsp + 2);
+		/* An app from before the level existed is still the only way onto the LAN: keep it. */
+		if (b->rsp_len <= at) {
+			netdev_warn(net, "BCO app predates link protocol %d; flash a current one\n",
+				    BCO_LINK_PROTO);
+		} else if (b->rsp[at] != BCO_LINK_PROTO) {
+			netdev_err(net, "BCO app speaks link protocol %u, this kernel %d; flash a matching BCO app\n",
+				   b->rsp[at], BCO_LINK_PROTO);
+			err = -EPROTONOSUPPORT;
+		} else if (b->rsp_len >= at + 1 + 4) {
+			WRITE_ONCE(b->caps, get_unaligned_le32(b->rsp + at + 1));
+		}
+		/* Without the capability hostapd would start an AP that never goes on air. */
+		if (!err && !(b->caps & BCOLINK_CAP_AP))
+			netdev_info(net, "BCO app runs no access point: no setup AP on wlan1\n");
+	}
+	/* an app without BCOLINK_CAP_FLOW takes every frame and drops what finds no buffer */
+	if (!err && (b->caps & BCOLINK_CAP_FLOW)) {
+		if (bco_flow_on(b))
+			netdev_warn(net, "BCO refused flow control: Wi-Fi frames may be dropped on the BCO\n");
+		else
+			netdev_info(net, "BCO transmit flow control on, %u of %u buffers free\n",
+				    b->rsp[1], b->rsp[2]);
+	}
+	/* link events at once instead of at the next STATUS poll (ADR 0135) */
+	if (!err && (b->caps & BCOLINK_CAP_EVENTS) && bco_req(b, T_EVENTS, (const u8[]){ 1 }, 1))
+		netdev_warn(net, "BCO refused link events: a lost link shows at the next poll\n");
+	mutex_unlock(&b->lock);
+	if (err)
+		goto fail;
+
+	memcpy(wiphy->perm_addr, mac, ETH_ALEN);
+	for (i = 0; i < ARRAY_SIZE(bco_channels); i++) {
+		bco_channels[i].band = NL80211_BAND_2GHZ;
+		bco_channels[i].center_freq = bco_chan_freq(i + 1);
+		bco_channels[i].hw_value = i + 1;
+		bco_channels[i].max_power = 20;
+	}
+	wiphy->bands[NL80211_BAND_2GHZ] = &bco_band;
+	wiphy->interface_modes = BIT(NL80211_IFTYPE_STATION);
+	if (b->caps & BCOLINK_CAP_AP) {
+		wiphy->interface_modes |= BIT(NL80211_IFTYPE_AP);
+		wiphy->iface_combinations = &bco_combo;
+		wiphy->n_iface_combinations = 1;
+		wiphy->flags |= WIPHY_FLAG_HAVE_AP_SME;
+	}
+	if (b->caps & BCOLINK_CAP_ROAM)
+		wiphy->flags |= WIPHY_FLAG_SUPPORTS_FW_ROAM;	/* the BCO roams within the SSID */
+	wiphy->reg_notifier = bco_reg_notifier;
+	wiphy->max_scan_ssids = 1;
+	wiphy->max_scan_ie_len = 256;	/* wpa_supplicant adds IEs; the BCO probes with its own */
+	wiphy->signal_type = CFG80211_SIGNAL_TYPE_MBM;
+	if (b->caps & BCOLINK_CAP_WPA3) {
+		wiphy->cipher_suites = bco_ciphers_wpa3;
+		wiphy->n_cipher_suites = ARRAY_SIZE(bco_ciphers_wpa3);
+		/* SAE over external authentication, optional or required PMF on the BCO */
+		wiphy->features |= NL80211_FEATURE_SAE;
+		wiphy->mgmt_stypes = bco_mgmt_stypes;
+		wiphy_ext_feature_set(wiphy, NL80211_EXT_FEATURE_MFP_OPTIONAL);
+	} else if (b->caps & BCOLINK_CAP_SECURITY) {
+		wiphy->cipher_suites = bco_ciphers_sec;
+		wiphy->n_cipher_suites = ARRAY_SIZE(bco_ciphers_sec);
+	} else {
+		wiphy->cipher_suites = bco_ciphers;
+		wiphy->n_cipher_suites = ARRAY_SIZE(bco_ciphers);
+	}
+	wiphy_ext_feature_set(wiphy, NL80211_EXT_FEATURE_4WAY_HANDSHAKE_STA_PSK);
+	set_wiphy_dev(wiphy, &b->usb->intf->dev);
+	err = wiphy_register(wiphy);
+	if (err)
+		goto fail;
+
+	wlan = bco_port_new(b, "wlan%d", BCOLINK_CH_WIFI, &bco_wlan_ops, mac);
+	/*
+	 * the wired MAC is the Wi-Fi MAC, locally administered; read the BCO's own
+	 * wired MAC from PersParam once the GEM is brought up
+	 */
+	mac[0] |= 0x02;
+	eth = bco_port_new(b, "eth%d", BCOLINK_CH_WIRED, &bco_eth_ops, mac);
+	if (!wlan || !eth) {
+		err = -ENOMEM;
+		goto fail_free;
+	}
+	b->wdev.wiphy = wiphy;
+	b->wdev.iftype = NL80211_IFTYPE_STATION;
+	b->wdev.netdev = wlan;
+	wlan->ieee80211_ptr = &b->wdev;
+
+	/* the transport may be unplugged meanwhile: register under RTNL only while it is there */
+	rtnl_lock();
+	err = net->reg_state == NETREG_REGISTERED ? register_netdevice(wlan) : -ENODEV;
+	if (!err) {
+		err = register_netdevice(eth);
+		if (err)
+			unregister_netdevice(wlan);
+	}
+	if (!err) {
+		WRITE_ONCE(b->wlan, wlan);
+		WRITE_ONCE(b->eth, eth);
+	}
+	rtnl_unlock();
+	if (err)
+		goto fail_free;
+	netdev_info(net, "BCO link up: %s, %s\n", wlan->name, eth->name);
+	return;
+
+fail_free:
+	free_netdev(eth);
+	free_netdev(wlan);
+	wiphy_unregister(wiphy);
+fail:
+	netdev_info(net, "no SoundTap BCO app on this link (%d)\n", err);
+}
+
+/*
+ * ---- sysfs: /sys/class/net/bcolink0/bco/ ----
+ * The BCO's LINK_STATS counters (since the BCO app started; u32, they wrap), asked of it at most
+ * once a second, and this driver's flow-control state. Read-only, for /api/health and the bench.
+ */
+
+static struct bco *bco_of_dev(struct device *d)
+{
+	return bco_of(netdev_priv(to_net_dev(d)));
+}
+
+static ssize_t bco_stat_show(struct device *d, char *buf, unsigned int i)
+{
+	struct bco *b = bco_of_dev(d);
+	ssize_t ret;
+	int err = 0, j;
+
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_STATS))
+		return -EOPNOTSUPP;
+	if (mutex_lock_interruptible(&b->lock))
+		return -EINTR;
+	if (!b->stats_ok || time_after(jiffies, b->stats_at + HZ)) {
+		err = bco_req(b, T_LINK_STATS, NULL, 0);
+		if (!err && b->rsp_len < 1 + 4 * BCO_STATS_N)
+			err = -EPROTO;
+		b->stats_ok = !err;
+		for (j = 0; !err && j < BCO_STATS_N; j++)
+			b->stats[j] = get_unaligned_le32(b->rsp + 1 + 4 * j);
+		b->stats_at = jiffies;
+	}
+	ret = err ? err : sysfs_emit(buf, "%u\n", b->stats[i]);
+	mutex_unlock(&b->lock);
+	return ret;
+}
+
+#define BCO_STAT(name, i)								\
+static ssize_t name##_show(struct device *d, struct device_attribute *a, char *buf)	\
+{											\
+	return bco_stat_show(d, buf, i);						\
+}											\
+static DEVICE_ATTR_RO(name)
+
+BCO_STAT(tx_ok, 0);		/* Wi-Fi frames the peer acknowledged */
+BCO_STAT(tx_failed, 1);		/* lost on air after the retries */
+BCO_STAT(tx_dropped, 2);	/* never sent: no free transmit buffer, not joined */
+BCO_STAT(link_dropped, 3);	/* messages the BCO dropped at the link, any channel */
+BCO_STAT(tx_frames, 4);		/* frames from the SCM the radio took */
+
+static ssize_t flow_show(struct device *d, struct device_attribute *a, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", READ_ONCE(bco_of_dev(d)->flow));
+}
+static DEVICE_ATTR_RO(flow);
+
+static ssize_t flow_stops_show(struct device *d, struct device_attribute *a, char *buf)
+{
+	return sysfs_emit(buf, "%lu\n", READ_ONCE(bco_of_dev(d)->flow_stops));
+}
+static DEVICE_ATTR_RO(flow_stops);
+
+static ssize_t flow_resyncs_show(struct device *d, struct device_attribute *a, char *buf)
+{
+	return sysfs_emit(buf, "%lu\n", READ_ONCE(bco_of_dev(d)->flow_resyncs));
+}
+static DEVICE_ATTR_RO(flow_resyncs);
+
+/*
+ * The setup AP as the BCO reports it (AP_STATUS), one "name value" per line: up (0/1), probe
+ * requests answered, frames heard, transmits ACKed, lost and dropped, frames to the SCM and beacons
+ * sent; with BCOLINK_CAP_APDIAG also the ms from AP_START to the first beacon, the core's frames to
+ * our address, those its address filter missed, client data it kept, held frames lost, and a
+ * "client" line per associated client. soundtapd logs it while the setup AP runs.
+ */
+static ssize_t ap_show(struct device *d, struct device_attribute *a, char *buf)
+{
+	static const char *const base[BCO_AP_COUNTERS] = { "up", "probes", "rx", "tx_ok", "tx_failed",
+		"tx_dropped", "to_scm", "beacons" };
+	static const char *const diag[BCO_AP_DIAG] = { "first_beacon_ms", "core_to_us",
+		"core_filter_missed", "core_client_data", "held_dropped" };
+	static const char *const extra[BCO_AP_EXTRA] = { "core_fcs_bad", "core_fcs_bad_last",
+		"core_data", "core_data_last", "core_no_room", "core_acks", "core_ack_last" };
+	struct bco *b = bco_of_dev(d);
+	unsigned int n, at, i, ex = 0, c2 = 0;
+	ssize_t len = 0;
+	int err;
+
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_AP))
+		return -EOPNOTSUPP;
+	if (mutex_lock_interruptible(&b->lock))
+		return -EINTR;
+	err = bco_req(b, T_AP_STATUS, NULL, 0);
+	n = b->rsp_len;
+	at = n >= 2 ? 2 + 6 * b->rsp[1] : n + 1;
+	if (!err && at + 4 * BCO_AP_COUNTERS > n)
+		err = -EPROTO;
+	for (i = 0; !err && i < BCO_AP_COUNTERS; i++)
+		len += sysfs_emit_at(buf, len, "%s %u\n", base[i], get_unaligned_le32(b->rsp + at + 4 * i));
+	at += 4 * BCO_AP_COUNTERS;
+	if (!err && (READ_ONCE(b->caps) & BCOLINK_CAP_APDIAG) &&
+	    at + 4 * BCO_AP_DIAG + BCO_AP_CLIENT * b->rsp[1] <= n) {
+		for (i = 0; i < BCO_AP_DIAG; i++)
+			len += sysfs_emit_at(buf, len, "%s %u\n", diag[i], get_unaligned_le32(b->rsp + at + 4 * i));
+		at += 4 * BCO_AP_DIAG;
+		/* what follows the clients: the extra words, then the second block per client */
+		i = at + BCO_AP_CLIENT * b->rsp[1];
+		if (i + 4 * BCO_AP_EXTRA + BCO_AP_CLIENT2 * b->rsp[1] <= n)
+			ex = BCO_AP_EXTRA, c2 = i + 4 * BCO_AP_EXTRA;
+		else if (i + 4 * BCO_AP_EXTRA_OLD <= n)
+			ex = BCO_AP_EXTRA_OLD;
+		for (i = 0; i < b->rsp[1]; i++, at += BCO_AP_CLIENT) {
+			const u8 *k = b->rsp + at, *k2 = b->rsp + c2 + BCO_AP_CLIENT2 * i;
+
+			len += sysfs_emit_at(buf, len,
+					     "client %pM dozing %u held %u rssi %d rate %u idle_ms %u rx_data %u rx_null %u tx_ok %u tx_failed %u",
+					     b->rsp + 2 + 6 * i, k[0] & 1, k[1], (s8)k[2], k[3],
+					     get_unaligned_le32(k + 4), get_unaligned_le32(k + 8),
+					     get_unaligned_le32(k + 12), get_unaligned_le32(k + 16),
+					     get_unaligned_le32(k + 20));
+			if (c2)
+				len += sysfs_emit_at(buf, len, " retries %u repeats %u seq %u",
+						     get_unaligned_le32(k2), get_unaligned_le16(k2 + 4),
+						     get_unaligned_le16(k2 + 6));
+			len += sysfs_emit_at(buf, len, "\n");
+		}
+		/* the last-frame words (1, 3 and 6) as hex: a byte each of rate, level or class, and
+		 * frame control */
+		for (i = 0; i < ex; i++)
+			len += sysfs_emit_at(buf, len, 0x4a >> i & 1 ? "%s 0x%x\n" : "%s %u\n", extra[i],
+					     get_unaligned_le32(b->rsp + at + 4 * i));
+	}
+	mutex_unlock(&b->lock);
+	return err ? err : len;
+}
+static DEVICE_ATTR_RO(ap);
+
+/*
+ * NV_INFO (BCOLINK_CAP_NVINFO): the keys of the BCO's PersParam log, each with its value length and,
+ * for a value of at most 4 bytes, the value. Read-only on the BCO, readable by root only, and asked
+ * of the BCO only when someone reads the file: the bench check for the antenna setting (ADR 0135).
+ */
+static ssize_t nv_keys_show(struct device *d, struct device_attribute *a, char *buf)
+{
+	struct bco *b = bco_of_dev(d);
+	ssize_t len = 0;
+	int err, i, k;
+
+	if (!(READ_ONCE(b->caps) & BCOLINK_CAP_NVINFO))
+		return -EOPNOTSUPP;
+	if (mutex_lock_interruptible(&b->lock))
+		return -EINTR;
+	err = bco_req(b, T_NV_INFO, NULL, 0);
+	if (!err && (b->rsp_len < 2 || b->rsp_len < 2 + b->rsp[1] * BCO_NV_ENTRY))
+		err = -EPROTO;
+	for (i = 0; !err && i < b->rsp[1]; i++) {
+		const u8 *e = b->rsp + 2 + i * BCO_NV_ENTRY;
+		u32 key = get_unaligned_le32(e);
+		u16 vl = get_unaligned_le16(e + 4);
+
+		for (k = 24; k >= 0; k -= 8)
+			len += sysfs_emit_at(buf, len, "%c", isprint(key >> k & 0xff) ? key >> k & 0xff : '.');
+		len += sysfs_emit_at(buf, len, " %u", vl);
+		if (vl <= 4)
+			len += sysfs_emit_at(buf, len, " %*phN", vl, e + 6);
+		len += sysfs_emit_at(buf, len, "\n");
+	}
+	mutex_unlock(&b->lock);
+	return err ? err : len;
+}
+static DEVICE_ATTR_ADMIN_RO(nv_keys);
+
+static struct attribute *bco_attrs[] = {
+	&dev_attr_tx_ok.attr, &dev_attr_tx_failed.attr, &dev_attr_tx_dropped.attr,
+	&dev_attr_link_dropped.attr, &dev_attr_tx_frames.attr,
+	&dev_attr_flow.attr, &dev_attr_flow_stops.attr, &dev_attr_flow_resyncs.attr,
+	&dev_attr_nv_keys.attr, &dev_attr_ap.attr,
+	NULL
+};
+
+static const struct attribute_group bco_attr_group = {
+	.name = "bco",
+	.attrs = bco_attrs,
+};
+
+static int bco_bind(struct usbnet *dev, struct usb_interface *intf)
+{
+	struct net_device *net = dev->net;
+	struct wiphy *wiphy;
+	struct bco *b;
+	int err;
+
+	err = usbnet_get_endpoints(dev, intf);
+	if (err)
+		return err;
+	wiphy = wiphy_new(&bco_ops, sizeof(*b));
+	if (!wiphy)
+		return -ENOMEM;
+	b = wiphy_priv(wiphy);
+	b->wiphy = wiphy;
+	b->usb = dev;
+	mutex_init(&b->lock);
+	/* The BCO resends its last reply for a repeated type+seq; a reloaded driver must not start
+	 * where the previous one did, or its first SET_PROFILE could get that stale reply. */
+	b->seq = get_random_u16();
+	spin_lock_init(&b->rx_lock);
+	init_completion(&b->done);
+	INIT_WORK(&b->setup, bco_setup_work);
+	INIT_WORK(&b->scan_work, bco_scan_work);
+	INIT_DELAYED_WORK(&b->join_work, bco_join_poll);
+	INIT_DELAYED_WORK(&b->wired_work, bco_wired_poll);
+	spin_lock_init(&b->flow_lock);
+	INIT_DELAYED_WORK(&b->flow_work, bco_flow_watch);
+	INIT_WORK(&b->reg_work, bco_reg_work);
+	INIT_WORK(&b->tx_work, bco_tx_work);
+	dev->driver_priv = b;
+
+	/* bcolink0 is a transport, not a LAN: no addresses, no ARP, no IPv6 autoconfiguration */
+	strscpy(net->name, "bcolink%d", sizeof(net->name));
+	net->priv_flags |= IFF_NO_ADDRCONF;
+	net->sysfs_groups[0] = &bco_attr_group;	/* the device-specific group, as qmi_wwan */
+	dev->hard_mtu = BCOLINK_HDR + BCOLINK_MAX;
+	dev->rx_urb_size = dev->hard_mtu;
+	/* the two-byte link header then leaves the IP header of a received frame 4-byte aligned */
+	set_bit(EVENT_NO_IP_ALIGN, &dev->flags);
+	schedule_work(&b->setup);
+	return 0;
+}
+
+static void bco_unbind(struct usbnet *dev, struct usb_interface *intf)
+{
+	struct bco *b = bco_of(dev);
+
+	cancel_work_sync(&b->setup);
+	if (b->ap) {
+		struct net_device *ap = b->ap;
+
+		WRITE_ONCE(b->ap, NULL);
+		unregister_netdev(ap);	/* needs_free_netdev frees it */
+	}
+	if (b->wlan) {
+		/* the transport is already unregistered, so no RX path runs any more */
+		unregister_netdev(b->wlan);	/* runs bco_wlan_stop: works cancelled */
+		unregister_netdev(b->eth);
+		cancel_delayed_work_sync(&b->flow_work);	/* no port sends any more */
+		free_netdev(b->wlan);
+		free_netdev(b->eth);
+		wiphy_unregister(b->wiphy);
+	}
+	cancel_delayed_work_sync(&b->join_work);
+	cancel_work_sync(&b->scan_work);
+	cancel_delayed_work_sync(&b->flow_work);
+	cancel_work_sync(&b->reg_work);
+	cancel_work_sync(&b->tx_work);
+	memzero_explicit(b->wep, sizeof(b->wep));	/* no static WEP key outlives the device */
+	wiphy_free(b->wiphy);
+}
+
+/*
+ * bcolink0 came (back) up: an eth0 that is up asks the BCO for its link again, and the credit is
+ * counted afresh, since frames queued while it was down never reached the BCO.
+ */
+static int bco_reset(struct usbnet *dev)
+{
+	struct bco *b = bco_of(dev);
+	struct net_device *eth = READ_ONCE(b->eth);
+	unsigned long flags;
+
+	if (eth && netif_running(eth)) {
+		netif_carrier_on(eth);
+		mod_delayed_work(system_wq, &b->wired_work, 0);
+	}
+	if (READ_ONCE(b->caps) & BCOLINK_CAP_FLOW) {
+		spin_lock_irqsave(&b->flow_lock, flags);
+		b->flow_resync = true;
+		spin_unlock_irqrestore(&b->flow_lock, flags);
+		mod_delayed_work(system_wq, &b->flow_work, 0);
+	}
+	return 0;
+}
+
+/* bcolink0 went down: nothing reaches the ports any more. */
+static int bco_stop(struct usbnet *dev)
+{
+	struct bco *b = bco_of(dev);
+
+	if (b->wlan)
+		netif_carrier_off(b->wlan);
+	if (b->eth)
+		netif_carrier_off(b->eth);
+	return 0;
+}
+
+static const struct driver_info bco_info = {
+	.description = "SoundTap BCO link",
+	.flags = FLAG_SEND_ZLP | FLAG_MULTI_PACKET | FLAG_NOARP,
+	.bind = bco_bind,
+	.unbind = bco_unbind,
+	.reset = bco_reset,
+	.stop = bco_stop,
+	.rx_fixup = bco_rx_fixup,
+	.tx_fixup = bco_tx_fixup,
+};
+
+static const struct usb_device_id bco_ids[] = {
+	/* pid.codes test PID until the BCO app has an allocated one (ADR 0031) */
+	{ USB_DEVICE_AND_INTERFACE_INFO(0x1209, 0x0001, USB_CLASS_VENDOR_SPEC, 0x52, 1),
+	  .driver_info = (unsigned long)&bco_info },
+	{ }
+};
+MODULE_DEVICE_TABLE(usb, bco_ids);
+
+static struct usb_driver bco_driver = {
+	.name = "soundtap_bco",
+	.id_table = bco_ids,
+	.probe = usbnet_probe,
+	.disconnect = usbnet_disconnect,
+	.suspend = usbnet_suspend,
+	.resume = usbnet_resume,
+	.disable_hub_initiated_lpm = 1,
+};
+module_usb_driver(bco_driver);
+
+MODULE_DESCRIPTION("SoundTap BCO link: SoundTouch 20 Wi-Fi and wired ports over USB");
+MODULE_LICENSE("GPL");

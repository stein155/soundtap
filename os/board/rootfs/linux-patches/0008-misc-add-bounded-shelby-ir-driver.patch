From 5f7cfb2461937ea78eb836fdb6e8ada2889df00f Mon Sep 17 00:00:00 2001
From: Stein Milder <info@steinmilder.nl>
Date: Sat, 15 Aug 2026 12:00:00 +0200
Subject: [PATCH] misc: add bounded Shelby IR receiver driver

The Bose Shelby infrared block exposes a receive-only edge sampler through
the AM335x UART registers rather than a conventional serial data stream.
Add the SoundTap ST10 decoder and its legacy /dev/ir byte interface.

Keep interrupt FIFO draining and UART reset polling bounded so malformed or
absent hardware cannot lock the CPU or block boot.  Read the receive FIFO
only while the LSR data-ready bit is asserted, and order IRQ, timer, misc
device, FIFO, and runtime-PM teardown so no callback can outlive its state.

Upstream: Not applicable (SoundTap hardware support)
Signed-off-by: Stein Milder <info@steinmilder.nl>
---
 drivers/misc/Makefile          |   1 +
 drivers/misc/soundtap-st10-ir.c | 323 ++++++++++++++++++++++++++++++++++
 2 files changed, 324 insertions(+)
 create mode 100644 drivers/misc/soundtap-st10-ir.c

diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index a9f9452..88e35b4 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -72,3 +72,4 @@ obj-$(CONFIG_TPS6594_PFSM)	+= tps6594-pfsm.o
 obj-$(CONFIG_NSM)		+= nsm.o
 obj-$(CONFIG_MARVELL_CN10K_DPI)	+= mrvl_cn10k_dpi.o
 obj-y				+= keba/
+obj-y += soundtap-st10-ir.o
diff --git a/drivers/misc/soundtap-st10-ir.c b/drivers/misc/soundtap-st10-ir.c
new file mode 100644
index 0000000..1aea784
--- /dev/null
+++ b/drivers/misc/soundtap-st10-ir.c
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/fs.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kfifo.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/poll.h>
+#include <linux/pm_runtime.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+#include <linux/uaccess.h>
+
+#define UART_RHR 0x00
+#define UART_DLL 0x00
+#define UART_DLH 0x04
+#define UART_IER 0x04
+#define UART_IIR 0x08
+#define UART_FCR 0x08
+#define UART_LCR 0x0c
+#define UART_LSR 0x14
+#define UART_MDR1 0x20
+#define UART_RX_FIFO_LVL 0x48
+#define UART_SYSC 0x54
+#define UART_SYSS 0x58
+#define UART_IER2 0x80
+
+struct soundtap_ir {
+	void __iomem *uart;
+	struct miscdevice misc;
+	struct kfifo fifo;
+	spinlock_t lock;
+	wait_queue_head_t wait;
+	struct timer_list release;
+	u8 level, run, state, bits, byte, first, last;
+	int overshoot;
+};
+
+static u8 reverse8(u8 v)
+{
+	v = ((v & 0x55) << 1) | ((v >> 1) & 0x55);
+	v = ((v & 0x33) << 2) | ((v >> 2) & 0x33);
+	return (v << 4) | (v >> 4);
+}
+
+static void soundtap_ir_put(struct soundtap_ir *ir, u8 code)
+{
+	if (kfifo_avail(&ir->fifo)) {
+		kfifo_in(&ir->fifo, &code, 1);
+		wake_up_interruptible(&ir->wait);
+	}
+}
+
+static void soundtap_ir_timeout(struct timer_list *timer)
+{
+	struct soundtap_ir *ir = from_timer(ir, timer, release);
+	unsigned long flags;
+
+	spin_lock_irqsave(&ir->lock, flags);
+	if (ir->last) {
+		ir->last = 0;
+		soundtap_ir_put(ir, 0);
+	}
+	spin_unlock_irqrestore(&ir->lock, flags);
+}
+
+static void soundtap_ir_reset(struct soundtap_ir *ir)
+{
+	ir->state = 0;
+	ir->bits = 0;
+}
+
+static bool between(int v, int low, int high)
+{
+	return v >= low && v <= high;
+}
+
+/* BoseDecode_EdgeEvent from the stock ir.ko, with durations in microseconds. */
+static void soundtap_ir_edge(struct soundtap_ir *ir, u8 level, int duration)
+{
+	int total;
+	u8 code;
+
+	switch (ir->state) {
+	case 0:
+		if (!level)
+			ir->state = 1;
+		return;
+	case 1:
+		if (level) {
+			if (!between(duration, 700, 1300))
+				goto bad;
+			ir->overshoot = duration - 1000;
+			return;
+		}
+		total = duration + ir->overshoot;
+		if (!between(total, 1050, 1950))
+			goto bad;
+		ir->byte = 0;
+		ir->bits = 8;
+		ir->state = 2;
+		return;
+	case 2:
+	case 3:
+		if (level) {
+			ir->overshoot = duration - 500;
+			return;
+		}
+		total = duration + ir->overshoot;
+		if (between(total, 350, 648))
+			ir->byte >>= 1;
+		else if (between(total, 1050, 1950))
+			ir->byte = (ir->byte >> 1) | 0x80;
+		else
+			goto bad;
+		if (--ir->bits)
+			return;
+		if (ir->state++ == 2) {
+			ir->first = ir->byte;
+			ir->byte = 0;
+			ir->bits = 8;
+			return;
+		}
+		/* The stock driver compares bit-reversed frame bytes. */
+		if ((u8)(reverse8(ir->first) ^ reverse8(ir->byte)) != 0xff)
+			goto bad;
+		code = reverse8(ir->first);
+		soundtap_ir_reset(ir);
+		if (code != ir->last) {
+			if (ir->last)
+				soundtap_ir_put(ir, 0);
+			ir->last = code;
+			if (code)
+				soundtap_ir_put(ir, code);
+		}
+		mod_timer(&ir->release, jiffies + 14);
+		return;
+	case 4:
+	default:
+		goto bad;
+	}
+bad:
+	soundtap_ir_reset(ir);
+}
+
+static irqreturn_t soundtap_ir_irq(int irq, void *data)
+{
+	struct soundtap_ir *ir = data;
+	unsigned long flags;
+	u8 sample, bit;
+	int budget = 64, i;
+
+	if (!(readb(ir->uart + UART_IIR) & 0x04))
+		return IRQ_NONE;
+	spin_lock_irqsave(&ir->lock, flags);
+	while (budget-- && (readb(ir->uart + UART_LSR) & 1)) {
+		sample = readb(ir->uart + UART_RHR);
+		for (i = 0; i < 8; i++) {
+			bit = !!(sample & BIT(i));
+			if (bit == ir->level) {
+				ir->run++;
+				continue;
+			}
+			soundtap_ir_edge(ir, ir->level, ir->run * 124);
+			ir->level = bit;
+			ir->run = 1;
+		}
+	}
+	spin_unlock_irqrestore(&ir->lock, flags);
+	return IRQ_HANDLED;
+}
+
+static int soundtap_ir_open(struct inode *inode, struct file *file)
+{
+	file->private_data = container_of(file->private_data, struct soundtap_ir, misc);
+	return 0;
+}
+
+static ssize_t soundtap_ir_read(struct file *file, char __user *buf, size_t len, loff_t *pos)
+{
+	struct soundtap_ir *ir = file->private_data;
+	u8 code;
+	unsigned long flags;
+
+	if (!len)
+		return 0;
+	spin_lock_irqsave(&ir->lock, flags);
+	if (!kfifo_out(&ir->fifo, &code, 1)) {
+		spin_unlock_irqrestore(&ir->lock, flags);
+		return 0;
+	}
+	spin_unlock_irqrestore(&ir->lock, flags);
+	return copy_to_user(buf, &code, 1) ? -EFAULT : 1;
+}
+
+static __poll_t soundtap_ir_poll(struct file *file, poll_table *wait)
+{
+	struct soundtap_ir *ir = file->private_data;
+
+	poll_wait(file, &ir->wait, wait);
+	return kfifo_is_empty(&ir->fifo) ? 0 : EPOLLIN | EPOLLRDNORM;
+}
+
+static const struct file_operations soundtap_ir_fops = {
+	.owner = THIS_MODULE,
+	.open = soundtap_ir_open,
+	.read = soundtap_ir_read,
+	.poll = soundtap_ir_poll,
+	.llseek = noop_llseek,
+};
+
+static int soundtap_ir_uart_reset(struct soundtap_ir *ir, u32 clock)
+{
+	/* Stock ir.ko divides the 48 MHz functional clock by 32000 (0x05dc). */
+	u32 divisor = clock / 32000;
+	u32 syss;
+	int err;
+
+	writeb(readb(ir->uart + UART_SYSC) | 2, ir->uart + UART_SYSC);
+	err = readl_poll_timeout(ir->uart + UART_SYSS, syss, syss & 1, 1, 1000);
+	if (err)
+		return err;
+	writeb(readb(ir->uart + UART_MDR1) | 7, ir->uart + UART_MDR1);
+	udelay(2);
+	writeb(readb(ir->uart + UART_LCR) | 0x80, ir->uart + UART_LCR);
+	writeb(divisor, ir->uart + UART_DLL);
+	writeb((readb(ir->uart + UART_DLH) & 0xc0) | ((divisor >> 8) & 0x3f),
+	       ir->uart + UART_DLH);
+	writeb(readb(ir->uart + UART_LCR) & 0x7f, ir->uart + UART_LCR);
+	writeb(4, ir->uart + UART_RX_FIFO_LVL);
+	writeb(readb(ir->uart + UART_IER2) | 1, ir->uart + UART_IER2);
+	writeb(3, ir->uart + UART_FCR);
+	writeb((readb(ir->uart + UART_MDR1) & ~7) | 6, ir->uart + UART_MDR1);
+	udelay(2);
+	return 0;
+}
+
+static void soundtap_ir_uart_enable(struct soundtap_ir *ir)
+{
+	int budget = 64;
+
+	while (budget-- && (readb(ir->uart + UART_LSR) & 1))
+		readb(ir->uart + UART_RHR);
+	readb(ir->uart + UART_IIR);
+	writeb(readb(ir->uart + UART_IER) | 0x0c, ir->uart + UART_IER);
+}
+
+static int soundtap_ir_probe(struct platform_device *pdev)
+{
+	struct soundtap_ir *ir;
+	u32 clock = 48000000;
+	int err;
+
+	of_property_read_u32(pdev->dev.of_node, "clock-frequency", &clock);
+	ir = devm_kzalloc(&pdev->dev, sizeof(*ir), GFP_KERNEL);
+	if (!ir)
+		return -ENOMEM;
+	pm_runtime_enable(&pdev->dev);
+	err = pm_runtime_resume_and_get(&pdev->dev);
+	if (err < 0)
+		goto pm;
+	ir->uart = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ir->uart)) {
+		err = PTR_ERR(ir->uart);
+		goto power;
+	}
+	err = kfifo_alloc(&ir->fifo, 16, GFP_KERNEL);
+	if (err)
+		goto power;
+	spin_lock_init(&ir->lock);
+	init_waitqueue_head(&ir->wait);
+	timer_setup(&ir->release, soundtap_ir_timeout, 0);
+	ir->misc.minor = MISC_DYNAMIC_MINOR;
+	ir->misc.name = "ir";
+	ir->misc.fops = &soundtap_ir_fops;
+	platform_set_drvdata(pdev, ir);
+	err = soundtap_ir_uart_reset(ir, clock);
+	if (err)
+		goto fifo;
+	err = request_irq(platform_get_irq(pdev, 0), soundtap_ir_irq, IRQF_TRIGGER_RISING,
+			  dev_name(&pdev->dev), ir);
+	if (err)
+		goto fifo;
+	err = misc_register(&ir->misc);
+	if (err)
+		goto irq;
+	soundtap_ir_uart_enable(ir);
+	return 0;
+
+irq:
+	writeb(0, ir->uart + UART_IER);
+	free_irq(platform_get_irq(pdev, 0), ir);
+	del_timer_sync(&ir->release);
+fifo:
+	kfifo_free(&ir->fifo);
+
+power:
+	pm_runtime_put_sync(&pdev->dev);
+pm:
+	pm_runtime_disable(&pdev->dev);
+	return err;
+}
+
+static const struct of_device_id soundtap_ir_of_match[] = {
+	{ .compatible = "bose,shelby-ir" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, soundtap_ir_of_match);
+
+/* This built-in fixed-DT device must not be unbound while /dev/ir is open. */
+static struct platform_driver soundtap_ir_driver = {
+	.probe = soundtap_ir_probe,
+	.driver = {
+		.name = "soundtap-st10-ir",
+		.of_match_table = soundtap_ir_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(soundtap_ir_driver);
+MODULE_LICENSE("GPL");
-- 

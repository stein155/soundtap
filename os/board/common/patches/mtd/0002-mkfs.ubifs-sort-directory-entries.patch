From 6ea18767c148f8e91ba19f6222ba454c2eb1d90c Mon Sep 17 00:00:00 2001
From: SoundTap contributors <soundtap@example.invalid>
Date: Fri, 14 Aug 2026 21:00:00 +0000
Subject: [PATCH] mkfs.ubifs: sort directory entries

The order returned by readdir depends on the host filesystem. That order
controls UBIFS inode allocation and node layout, preventing reproducible
images even when all input timestamps are fixed. Use scandir with alphasort
so identical trees produce a stable traversal order.

Signed-off-by: SoundTap contributors <soundtap@example.invalid>
---
 ubifs-utils/mkfs.ubifs/mkfs.ubifs.c | 28 ++++++++++++++++++----------
 1 file changed, 18 insertions(+), 10 deletions(-)

diff --git a/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c b/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c
index e38c434..8791600 100644
--- a/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c
+++ b/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c
@@ -1936,7 +1936,9 @@ static int add_directory(const char *dir_name, ino_t dir_inum, struct stat *st,
 {
 	struct dirent *entry;
+	struct dirent **entries = NULL;
 	DIR *dir = NULL;
-	int kname_len, err = 0;
+	int entry_count = 0, entry_index = 0;
+	int kname_len, err = 0, i;
 	loff_t size = UBIFS_INO_NODE_SZ;
 	char *name = NULL;
 	unsigned int nlink = 2;
@@ -1952,6 +1954,12 @@ static int add_directory(const char *dir_name, ino_t dir_inum, struct stat *st,
 		if (dir == NULL)
 			return sys_errmsg("cannot open directory '%s'",
 					   dir_name);
+		entry_count = scandir(dir_name, &entries, NULL, alphasort);
+		if (entry_count < 0) {
+			closedir(dir);
+			return sys_errmsg("cannot scan directory '%s'",
+					   dir_name);
+		}
 	}
 
 	/*
@@ -1972,14 +1980,9 @@ static int add_directory(const char *dir_name, ino_t dir_inum, struct stat *st,
 		struct stat dent_st;
 		struct fscrypt_context *new_fctx = NULL;
 
-		errno = 0;
-		entry = readdir(dir);
-		if (!entry) {
-			if (errno == 0)
-				break;
-			sys_errmsg("error reading directory '%s'", dir_name);
-			goto out_free;
-		}
+		if (entry_index == entry_count)
+			break;
+		entry = entries[entry_index++];
 
 		if (strcmp(".", entry->d_name) == 0)
 			continue;
@@ -2143,6 +2146,9 @@ static int add_directory(const char *dir_name, ino_t dir_inum, struct stat *st,
 	if (err)
 		goto out_free;
 
+	for (i = 0; i < entry_count; i++)
+		free(entries[i]);
+	free(entries);
 	free(name);
 	if (existing && closedir(dir) == -1)
 		return sys_errmsg("error closing directory '%s'", dir_name);
@@ -2151,6 +2157,9 @@ static int add_directory(const char *dir_name, ino_t dir_inum, struct stat *st,
 	return 0;
 
 out_free:
+	for (i = 0; i < entry_count; i++)
+		free(entries[i]);
+	free(entries);
 	free(itr);
 	free(name);
 	if (existing)

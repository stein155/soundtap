From 1113da6fd75c97e8513950e302f91697306b5836 Mon Sep 17 00:00:00 2001
From: SoundTap contributors <soundtap@example.invalid>
Date: Fri, 14 Aug 2026 21:10:00 +0000
Subject: [PATCH 1/2] mkfs.ubifs: add hard-link path comparator

Prepare to emit deferred hard-linked files in a deterministic order.

Signed-off-by: SoundTap contributors <soundtap@example.invalid>
---
 ubifs-utils/mkfs.ubifs/mkfs.ubifs.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c b/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c
index 8791600..641bf68 100644
--- a/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c
+++ b/ubifs-utils/mkfs.ubifs/mkfs.ubifs.c
@@ -2164,0 +2165,8 @@ out_free:
+static int compare_inum_mappings(const void *left, const void *right)
+{
+	const struct inum_mapping * const *a = left;
+	const struct inum_mapping * const *b = right;
+
+	return strcmp((*a)->path_name, (*b)->path_name);
+}
+

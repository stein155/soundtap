/*
 * SoundTouch 20 and 30 Series III: the ST10's Shelby 2 module in the ST20 and ST30 boxes.
 * Preview, never booted. Compared with the stock spotty_sm2 and mojo_sm2 trees, which are
 * one tree apart from the codec script's name and the sync-out timer: the amplifier, mute,
 * codec and DSP reset lines, the keypad matrix, the IR receiver, Bluetooth's enable and the
 * NAND are all the ST10's, so this is the ST10's tree with what stock changes:
 *
 * - One lamp, the Wi-Fi lamp: stock's shelby-led node has only uledw, on DM timer 4 (the
 *   ST10's wifi-white PWM), and uledy on gpio2_17 (the ST10's wifi-amber).
 * - The ST10's other lamp pads drive the front panel, a bose,ssdspi like the ST20's on
 *   SPI1 chip select 0: chip enable gpio0_12, reset gpio2_9, data/command gpio2_12, and
 *   its supply on gpio2_23 (the PMIC's "disp" regulator). soundtapd drives the panel over
 *   /dev/spidev1.0, which the ST10 tree already has.
 * - gpio0_4 is microbsel, the rear micro-B port's mux, held low as stock holds it.
 * - The rear Ethernet port: stock spotty_sm2 and mojo_sm2 describe it exactly as ginger_sm2
 *   (the SoundTouch 300) does, property for property: rmii1_pins_default, davinci_mdio_default,
 *   one slave in RMII with the PHY at address 0 (phy_id 0x3f:00) and the reference clock from
 *   the board (rmii-clock-ext). So this tree takes the ST300's mac_sw, mdio and cpsw_port nodes,
 *   which took a lease on the ST300 on 2026-11-16, and init.d/soundtap loads the CPSW modules
 *   and runs the eth0 watcher for spotty3 and mojo3 as for the ST300. Not seen on a Series III.
 */
#include "am335x-soundtap-st10.dts"

/ {
	model = "Bose SoundTouch 20/30 Series III (SoundTap)";
	compatible = "bose,spotty3-sm2", "ti,am33xx";

	chosen {
		bootargs = "console=ttyS3,115200n8 root=ubi0:rootfs ro rootfstype=ubifs ubi.mtd=9,2048 rootwait init=/init mem=128M cma=8M panic=10 omap_wdt.early_enable=1 variant=spotty3 module_type=sm2 country=GB region=GB soundtap.nandroot=1 soundtap.watchdog=90";
	};

	leds {
		pinctrl-0 = <&wifi_amber_pins>;
		/delete-node/ bt-white;
		/delete-node/ soundtouch-white;
		/delete-node/ soundtouch-amber;
		/delete-node/ bt-blue;
		/delete-node/ aux-white;
	};
};

&am33xx_pinmux {
	wifi_amber_pins: pinmux-wifi-amber-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA11, PIN_OUTPUT_PULLDOWN, MUX_MODE7) /* gpio2_17 wifi amber */
		>;
	};

	/* Stock rmii1_pins_default and davinci_mdio_default, as on the ST300. */
	rmii1_pins: pinmux-rmii1-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_MII1_CRS, PIN_INPUT_PULLDOWN, MUX_MODE1) /* rmii1_crs_dv */
			AM33XX_PADCONF(AM335X_PIN_MII1_RX_ER, PIN_INPUT_PULLDOWN, MUX_MODE1) /* rmii1_rx_er */
			AM33XX_PADCONF(AM335X_PIN_MII1_TX_EN, PIN_OUTPUT_PULLDOWN, MUX_MODE1) /* rmii1_tx_en */
			AM33XX_PADCONF(AM335X_PIN_MII1_TXD1, PIN_OUTPUT_PULLDOWN, MUX_MODE1) /* rmii1_txd1 */
			AM33XX_PADCONF(AM335X_PIN_MII1_TXD0, PIN_OUTPUT_PULLDOWN, MUX_MODE1) /* rmii1_txd0 */
			AM33XX_PADCONF(AM335X_PIN_MII1_RXD1, PIN_INPUT_PULLDOWN, MUX_MODE1) /* rmii1_rxd1 */
			AM33XX_PADCONF(AM335X_PIN_MII1_RXD0, PIN_INPUT_PULLDOWN, MUX_MODE1) /* rmii1_rxd0 */
			AM33XX_PADCONF(AM335X_PIN_RMII1_REF_CLK, PIN_INPUT_PULLDOWN, MUX_MODE0) /* rmii1_refclk */
		>;
	};

	mdio_pins: pinmux-mdio-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_MDIO, PIN_INPUT_PULLUP, MUX_MODE0)
			AM33XX_PADCONF(AM335X_PIN_MDC, PIN_OUTPUT_PULLUP, MUX_MODE0)
		>;
	};

	/* Stock ssdspi_pins_default and ncp6922_pins_default, and gpiodev's microbsel. */
	panel_pins: pinmux-panel-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_UART1_CTSN, PIN_OUTPUT, MUX_MODE7) /* gpio0_12 panel CE */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA3, PIN_OUTPUT, MUX_MODE7) /* gpio2_9 panel reset */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA6, PIN_OUTPUT, MUX_MODE7) /* gpio2_12 panel D/C */
			AM33XX_PADCONF(AM335X_PIN_LCD_HSYNC, PIN_OUTPUT, MUX_MODE7) /* gpio2_23 panel supply */
			AM33XX_PADCONF(AM335X_PIN_SPI0_D1, PIN_OUTPUT, MUX_MODE7) /* gpio0_4 microbsel */
			AM33XX_PADCONF(AM335X_PIN_GPMC_CLK, PIN_INPUT_PULLDOWN, MUX_MODE7) /* gpio2_1 microbdet (stock 0x8c 0x27) */
		>;
	};
};

/* The panel's lines are muxed with the bus it hangs on. */
&spi1 {
	pinctrl-0 = <&spi1_pins &panel_pins>;
};

&gpio0 {
	microbsel-hog {
		gpio-hog;
		gpios = <4 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "microbsel";
	};
};

&gpio2 {
	/* Stock's "disp" regulator: a GPIO the panel driver turns on and nothing turns off. */
	panel-supply-hog {
		gpio-hog;
		gpios = <23 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "panel_supply";
	};
};

/* Rear Ethernet: RMII, PHY at address 0, reference clock from the board (stock rmii-clock-ext). */
&mac_sw {
	pinctrl-names = "default";
	pinctrl-0 = <&rmii1_pins>;
	status = "okay";
};

&davinci_mdio_sw {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;

	ethphy0: ethernet-phy@0 {
		reg = <0>;
	};
};

&cpsw_port1 {
	phy-handle = <&ethphy0>;
	phy-mode = "rmii";
	ti,dual-emac-pvid = <1>;
};

&cpsw_port2 {
	status = "disabled";
};

# The cross toolchain only, built by this Buildroot and kept as an SDK: `make toolchain`
# builds it once per key (this file, the Buildroot commit, the builder image) and
# soundtap_defconfig uses it as an external toolchain, so an image build no longer spends
# its first quarter of an hour on gcc. Same gcc, binutils, musl and kernel headers as the
# internal toolchain it replaces. Keep the target lines in step with soundtap_defconfig.
BR2_arm=y
BR2_cortex_a8=y
BR2_ARM_FPU_VFPV3=y
BR2_KERNEL_HEADERS_6_12=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_REPRODUCIBLE=y

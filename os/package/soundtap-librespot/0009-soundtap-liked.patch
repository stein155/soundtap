+// The little protobuf the collection service speaks, written out: one request, no new crate.
+fn pb_varint(out: &mut Vec<u8>, mut v: u64) {
+    while v >= 0x80 {
+        out.push((v as u8 & 0x7f) | 0x80);
+        v >>= 7;
+    }
+    out.push(v as u8);
+}
+
+fn pb_bytes(out: &mut Vec<u8>, field: u8, bytes: &[u8]) {
+    out.push(field << 3 | 2);
+    pb_varint(out, bytes.len() as u64);
+    out.extend_from_slice(bytes);
+}
+
+fn liked_set(username: &str) -> Vec<u8> {
+    let mut out = Vec::new();
+    pb_bytes(&mut out, 1, username.as_bytes());
+    pb_bytes(&mut out, 2, b"collection");
+    out
+}
+
+fn liked_write(username: &str, uri: &str, on: bool) -> Vec<u8> {
+    let mut item = Vec::new();
+    pb_bytes(&mut item, 1, uri.as_bytes());
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs());
+    item.push(2 << 3);
+    pb_varint(&mut item, now);
+    if !on {
+        item.extend_from_slice(&[3 << 3, 1]);
+    }
+    let mut out = liked_set(username);
+    pb_bytes(&mut out, 3, &item);
+    out
+}

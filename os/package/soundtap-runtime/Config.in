config BR2_PACKAGE_SOUNDTAP_RUNTIME
	bool "SoundTap runtime"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_LIBGPG_ERROR_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_4
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_ALSA_UTILS
	select BR2_PACKAGE_ALSA_UTILS_APLAY
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_AVAHI_DAEMON
	select BR2_PACKAGE_BLUEZ5_UTILS
	select BR2_PACKAGE_BLUEZ5_UTILS_CLIENT
	select BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO
	select BR2_PACKAGE_BLUEZ_ALSA
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_HOSTAPD
	select BR2_PACKAGE_HOSTAPD_DRIVER_NL80211
	select BR2_PACKAGE_IW
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_SOUNDTAP_FFMPEG
	select BR2_PACKAGE_SOUNDTAP_LIBRESPOT
	select BR2_PACKAGE_SOUNDTAP_SHAIRPORT_SYNC
	select BR2_PACKAGE_SOUNDTAP_SNAPCAST
	select BR2_PACKAGE_SOUNDTAPD
	select BR2_PACKAGE_WPA_SUPPLICANT
	select BR2_PACKAGE_WPA_SUPPLICANT_CLI
	select BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE
	select BR2_PACKAGE_WPA_SUPPLICANT_NL80211
	select BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE
	help
	  Runtime scripts and network/audio receiver configuration for
	  supported SoundTap products.

comment "SoundTap runtime needs C++, NPTL, wchar, dynamic libraries, Rust and FFmpeg support"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS_NPTL || \
		!BR2_USE_WCHAR || BR2_STATIC_LIBS || \
		!BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS || \
		!BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS

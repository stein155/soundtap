--- a/cmd/wlamark.c	1970-01-01 01:00:00.000000000 +0100
+++ b/cmd/wlamark.c	2026-09-16 22:30:00.000000000 +0200
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * mark <n> -- record a boot stage from a bootcmd.
+ *
+ * The C-level markers in common/wla_mark.c answer "how far did U-Boot itself
+ * get". They cannot answer "how far did the boot script get", and on this board
+ * that is the question that matters: the slot recipe in the environment reads a
+ * kernel out of NAND, clears its boot marker and calls bootm, and when the board
+ * does not come up there is no console to say which of those steps failed.
+ *
+ * Stages 1 to 6 are written by the C code. A script uses 7 and up.
+ *
+ * Failures are silent, exactly as in wla_uboot_mark(): a diagnostic must never
+ * be the reason a board does not boot.
+ */
+#include <command.h>
+#include <vsprintf.h>
+#include <wla_mark.h>
+
+static int do_wlamark(struct cmd_tbl *cmdtp, int flag, int argc,
+		      char *const argv[])
+{
+	unsigned long stage;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+
+	stage = simple_strtoul(argv[1], NULL, 10);
+	wla_uboot_mark((unsigned int)stage);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(mark, 2, 0, do_wlamark,
+	   "record a boot stage into the update staging partition",
+	   "n\n"
+	   "    - write marker n (1..12); one erase block per stage.\n"
+	   "      Stages 1..6 are U-Boot's own; scripts should use 7 and up.");

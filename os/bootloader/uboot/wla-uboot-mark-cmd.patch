+config CMD_WLAMARK
+	bool "mark command that records a boot stage into NAND"
+	help
+	  This board has no serial console, and the USB gadget that could carry one
+	  only exists while a host is attached -- which is exactly when the mask ROM
+	  boots over USB instead of from NAND. So a bootcmd running off NAND cannot
+	  be watched at all, and a board that does not come up says nothing about
+	  which step failed.
+
+	  mark <n> writes one short marker into a scratch block of the update
+	  staging partition, one block per stage, so a bootcmd can record how far it
+	  got and the next system to boot can read it back. Stages 1 to 6 belong to
+	  the C code; a script should use 7 and up, which nothing else writes.
+
+	  Diagnostic only. It writes to flash, so it has no place in a shipped image.
+
 config CMD_NAND
 	bool "nand"
 	default y if NAND_SUNXI

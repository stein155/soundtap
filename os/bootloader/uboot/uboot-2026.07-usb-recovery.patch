+/*
+ * What kind of package this is, and whether this board takes it: SoundTap's (it carries
+ * soundtap-rootfs) on any board with the gesture; Bose's when its chain is a stock family,
+ * its ubi.img's version tag names this board's module (rt_m) and stock variant, and its
+ * payloads fit their partitions. -ENOEXEC: not for this speaker.
+ */
+static int rt_classify(struct rt_pkg *pkg, u32 erasesize)
+{
+	const char *b = env_get("rt_b"), *mod = env_get("rt_m");
+	const struct rt_bose *bose = NULL;
+	struct rt_module *m;
+	int i, j;
+
+	pkg->rootfs = rt_module_named(pkg, "soundtap-rootfs");
+	pkg->bose = !pkg->rootfs;
+	if (pkg->bose) {
+		for (i = 0; b && i < ARRAY_SIZE(rt_bose_boards); i++)
+			if (!strcmp(b, rt_bose_boards[i].board))
+				bose = &rt_bose_boards[i];
+		for (i = 0; i < ARRAY_SIZE(rt_bose_chains); i++) {
+			for (j = 0; j < pkg->n && rt_bose_chains[i][j]; j++)
+				if (strcmp(pkg->m[j].name, rt_bose_chains[i][j]))
+					break;
+			if (j == pkg->n && (j == RT_STU_MODULES || !rt_bose_chains[i][j]))
+				break;
+		}
+		pkg->rootfs = rt_module_named(pkg, "ubi.img");
+		pkg->kernel = rt_module_named(pkg, "linuxPatched");
+		pkg->mlo = rt_module_named(pkg, "MLO");
+		pkg->uboot = rt_module_named(pkg, "u-boot.img");
+		if (!bose || !mod || i == ARRAY_SIZE(rt_bose_chains) || !pkg->rootfs ||
+		    !pkg->kernel || !pkg->mlo || !pkg->uboot ||
+		    !rt_tag_names(pkg->rootfs->tag, mod, bose->stock)) {
+			printf("Update.stu: not a SoundTap package, nor Bose's firmware for this speaker "
+			       "(%s/%s, ubi.img %s); nothing written\n", mod ? mod : "?", b ? b : "?",
+			       pkg->rootfs ? pkg->rootfs->tag : "missing");
+			return -ENOEXEC;
+		}
+		if (pkg->rootfs->size > RT_SLOT_SIZE + RT_STU_OVERLAP || pkg->kernel->size > RT_KERNEL_SIZE ||
+		    pkg->mlo->size > RT_SPL_SIZE || pkg->uboot->size > RT_UBOOT_MAX) {
+			printf("Update.stu: a module of Bose's package does not fit this speaker; "
+			       "nothing written\n");
+			return -ENOEXEC;
+		}
+	}
+	/* The module declares its overlap with the next header as its own; the UBI image is
+	 * whichever of the two lengths is whole eraseblocks (ubiBodySize in internal/web). */
+	m = pkg->rootfs;
+	if (m->size % erasesize == 0)
+		m->body = m->size;
+	else if ((m->size - RT_STU_OVERLAP) % erasesize == 0)
+		m->body = m->size - RT_STU_OVERLAP;
+	else
+		m->body = 0;
+	return m->body && m->body <= RT_SLOT_SIZE ? 0 : -EINVAL;
+}
+
+/*
+ * Pass one: all of Update.stu read once, into the SHA-256 and into each module's image CRC,
+ * which covers the module's whole declared size, overlap included (internal/stu's payload).
+ * Nothing is erased before the CRC of every module the stick writes matches. A module it
+ * does not write may differ: Bose's own 27.0.6 packages carry host firmware whose CRC field
+ * does not match its bytes (TRI_shelby_update.tri says 0xffffffff, SEN_FW_update.bos another
+ * value), which Bose's installer evidently does not hold it to; its header CRC still holds
+ * the chain together, and the second pass's digest the whole file.
+ */
+static int rt_check(u8 *buf, const struct rt_pkg *pkg, sha256_context *ctx, loff_t file)
+{
+	u32 crc[RT_STU_MODULES] = {};
+	loff_t off, a, b;
+	u32 n;
+	int i;
+
+	for (off = 0; off < file; off += n) {
+		n = min_t(loff_t, RT_CHUNK, file - off);
+		if (rt_read(buf, off, n))
+			return -EIO;
+		sha256_update(ctx, buf, n);
+		for (i = 0; i < pkg->n; i++) {
+			a = max_t(loff_t, off, pkg->m[i].off);
+			b = min_t(loff_t, off + n, pkg->m[i].off + pkg->m[i].size);
+			if (a < b)
+				crc[i] = crc32(crc[i], buf + (a - off), b - a);
+		}
+	}
+	for (i = 0; i < pkg->n; i++) {
+		const struct rt_module *m = &pkg->m[i];
+
+		if (crc[i] == m->crc)
+			continue;
+		if (m != pkg->rootfs && m != pkg->kernel && m != pkg->mlo && m != pkg->uboot) {
+			printf("Update.stu: %s: image CRC does not match; not written\n", m->name);
+			continue;
+		}
+		printf("Update.stu: %s: image CRC mismatch; nothing written\n", m->name);
+		return -EBADMSG;
+	}
+	return 0;
+}
+
+/*
+ * Bose's kernel as its updater writes it (flash.ValidateKernel): a uImage whose name fixsig
+ * turns back into Linux, that fits its module. A SoundTap kernel under Bose's module names
+ * is not Bose's firmware (errNotStock in internal/web/firmware): refused.
+ */
+static int rt_kernel_ok(u8 *buf, const struct rt_module *m)
+{
+	char name[33];
+
+	if (m->size < 64 || rt_read(buf, m->off, 64))
+		return m->size < 64 ? -ENOEXEC : -EIO;
+	memcpy(name, buf + 32, 32);
+	name[32] = 0;
+	if (get_unaligned_be32(buf) != 0x27051956 ||
+	    (strncmp(name, "Linux", 5) && strncmp(name, "Linub", 5)) || strstr(name, "SoundTap") ||
+	    get_unaligned_be32(buf + 12) > m->size - 64) {
+		printf("Update.stu: linuxPatched is not Bose's kernel; nothing written\n");
+		return -ENOEXEC;
+	}
+	return 0;
+}
+
+/*
+ * Bose's SPL and U-Boot as soundtapd holds them before it writes either
+ * (install.VerifyBootloaders): an SPL with the header the ROM parses, loading to SRAM and
+ * starting with a branch (ValidateAM335xSPL), and a legacy uImage whose data and header
+ * CRCs check out.
+ */
+static int rt_boot_ok(const u8 *mlo, u32 mlo_len, const u8 *ub, u32 ub_len)
+{
+	u8 h[64];
+	u32 n;
+
+	if (mlo_len < 0x20c || get_unaligned_le32(mlo) != 0x40 ||
+	    get_unaligned_le32(mlo + 0x204) != 0x402f0400 ||
+	    get_unaligned_le32(mlo + 0x200) > mlo_len - 0x200 ||
+	    (mlo[0x20b] != 0xea && mlo[0x20b] != 0xeb))
+		return -ENOEXEC;
+	if (ub_len < 64 || get_unaligned_be32(ub) != 0x27051956)
+		return -ENOEXEC;
+	n = get_unaligned_be32(ub + 12);
+	if (n > ub_len - 64 || crc32(0, ub + 64, n) != get_unaligned_be32(ub + 24))
+		return -ENOEXEC;
+	memcpy(h, ub, sizeof(h));
+	put_unaligned_be32(0, h + 4);
+	return crc32(0, h, sizeof(h)) == get_unaligned_be32(ub + 4) ? 0 : -ENOEXEC;
+}
+
+/* SHA-256 over len bytes of Update.stu from off, a chunk at a time. */
+static int rt_hash(u8 *buf, sha256_context *ctx, loff_t off, loff_t len)
+{
+	u32 n;
+
+	for (; len > 0; off += n, len -= n) {
+		n = min_t(loff_t, RT_CHUNK, len);
+		if (rt_read(buf, off, n))
+			return -EIO;
+		sha256_update(ctx, buf, n);
+	}
+	return 0;
+}
+
+static bool rt_page_empty(const u8 *p, u32 len)
+{
+	while (len--)
+		if (*p++ != 0xff)
+			return false;
+	return true;
+}
+
+/* One NAND page read back after programming; 4 KiB covers every page size on these boards. */
+static u8 rt_page[4096];
+
+/*
+ * At most this many blocks of the slot are marked bad in one update, as the installer that
+ * runs on stock allows per partition (MTD_MARK_BAD_PER_PARTITION in os/installer/module/mtd.h).
+ * More failures than that in one write is not wear but something else -- timing, power, a
+ * driver -- and a mark is for good, so the update stops there and the old slot boots.
+ */
+#define RT_MARK_BAD_MAX		2
+
+/*
+ * An erase failed because of this block only when the NAND said so: nand_erase_nand sets
+ * fail_addr to the block when its status read FAIL. A write-protected chip fails every erase
+ * with -EIO and leaves fail_addr unknown; that says nothing about the block.
+ */
+static int rt_erase_err(const struct erase_info *ei, loff_t blk, int err)
+{
+	return err == -EIO && ei->fail_addr != blk ? -EROFS : err;
+}
+
+/*
+ * Retire a block of the slot being written after the NAND failed its erase or program: err
+ * is what that returned, and only -EIO, the chip's FAIL status, counts. A timeout or any other
+ * error, a read that fails or reads back otherwise, never comes here; nothing outside the two
+ * rootfs slots is ever marked, and never more than RT_MARK_BAD_MAX blocks. Returns 0 once
+ * the block is marked; the caller then goes on in the next good block.
+ */
+static int rt_mark_bad(struct mtd_info *mtd, loff_t part, loff_t blk, const char *op, int err,
+		       int *marked)
+{
+	const char *name = part == RT_PING_ROOTFS ? "NAND.File-System-Ping" : "NAND.File-System-Pong";
+	u32 n;
+	int ret;
+
+	if ((part != RT_PING_ROOTFS && part != RT_PONG_ROOTFS) || blk < part ||
+	    blk >= part + RT_SLOT_SIZE) {
+		printf("Update.stu: 0x%llx is outside the slot; not marked bad\n", (long long)blk);
+		return -EINVAL;
+	}
+	n = (u32)(blk - part) / mtd->erasesize;	/* 32-bit: U-Boot has no 64-bit division */
+	if (err != -EIO) {
+		printf("Update.stu: %s block %u: %s failed (%d), not a NAND failure; not marked bad\n",
+		       name, n, op, err);
+		return -EIO;
+	}
+	if (*marked >= RT_MARK_BAD_MAX) {
+		printf("Update.stu: %s block %u: %s failed (%d); %d blocks marked bad already, the "
+		       "most allowed: not marked, nothing selected\n", name, n, op, err, *marked);
+		return -EIO;
+	}
+	ret = mtd_block_markbad(mtd, blk);
+	if (ret) {
+		printf("Update.stu: %s block %u: %s failed (%d), and marking it bad failed (%d)\n",
+		       name, n, op, err, ret);
+		return -EIO;
+	}
+	(*marked)++;
+	printf("Update.stu: %s block %u (0x%llx) marked bad: %s failed (%d), %d of %d\n",
+	       name, n, (long long)blk, op, err, *marked, RT_MARK_BAD_MAX);
+	return 0;
+}
+
+/*
+ * One image eraseblock into the first good block at *blk or after it, before end: erased,
+ * the pages that are not empty written, all of it read back and compared, as a write that
+ * reports success proves nothing about the bytes NAND kept. A block of a rootfs slot the
+ * NAND fails to erase or program is marked bad and the image block goes into the next one,
+ * as ubiformat does; it is all in RAM. Anywhere else a failing block fails the write
+ * (rt_mark_bad marks nothing outside the two rootfs slots). A read that fails or differs
+ * fails the update, and marks nothing.
+ */
+static int rt_write_block(struct mtd_info *mtd, const u8 *data, loff_t part, loff_t end,
+			  loff_t *blk, int *marked)
+{
+	size_t ret;
+	u32 p;
+	int err;
+
+	for (;; *blk += mtd->erasesize) {
+		struct erase_info ei = { .mtd = mtd, .len = mtd->erasesize };
+
+		while (*blk < end && mtd_block_isbad(mtd, *blk))
+			*blk += mtd->erasesize;
+		if (*blk >= end)
+			return -ENOSPC;
+		ei.addr = *blk;
+		err = mtd_erase(mtd, &ei);
+		if (err) {
+			if (rt_mark_bad(mtd, part, *blk, "erase", rt_erase_err(&ei, *blk, err), marked))
+				return -EIO;
+			continue;
+		}
+		for (p = 0, err = 0; p < mtd->erasesize; p += mtd->writesize) {
+			if (rt_page_empty(data + p, mtd->writesize))
+				continue;
+			err = mtd_write(mtd, *blk + p, mtd->writesize, &ret, data + p);
+			if (err || ret != mtd->writesize)
+				break;
+		}
+		if (p < mtd->erasesize) {
+			if (rt_mark_bad(mtd, part, *blk, "write", err, marked))
+				return -EIO;
+			continue;
+		}
+		for (p = 0; p < mtd->erasesize; p += mtd->writesize) {
+			err = mtd_read(mtd, *blk + p, mtd->writesize, &ret, rt_page);
+			if ((err && !mtd_is_bitflip(err)) || ret != mtd->writesize ||
+			    memcmp(rt_page, data + p, mtd->writesize))
+				return -EIO;
+		}
+		return 0;
+	}
+}
+
+/* Every good block from blk to end erased, so nothing of what was there before survives
+ * behind the image; in a rootfs slot one that cannot be erased is marked bad. */
+static int rt_erase_rest(struct mtd_info *mtd, loff_t part, loff_t blk, loff_t end, int *marked)
+{
+	int err;
+
+	for (; blk < end; blk += mtd->erasesize) {
+		struct erase_info ei = { .mtd = mtd, .addr = blk, .len = mtd->erasesize };
+
+		rt_kick();
+		if (mtd_block_isbad(mtd, blk))
+			continue;
+		err = mtd_erase(mtd, &ei);
+		if (err && rt_mark_bad(mtd, part, blk, "erase", rt_erase_err(&ei, blk, err), marked))
+			return -EIO;
+	}
+	return 0;
+}
+
+/*
+ * Pass two, what ubiformat does for the installer, into the len bytes of NAND at part:
+ * every good eraseblock erased, image eraseblocks written to the good ones in order with
+ * empty pages left erased (rt_write_block), and every block after the image erased too, so
+ * no eraseblock of the old image survives with a volume header UBI would believe; one that
+ * cannot be erased is marked bad, which UBI skips. A kernel, which ends inside a block,
+ * has the rest of that block left erased, as nandwrite -p pads it. Each chunk goes into
+ * the package's hash from the buffer it is written from.
+ */
+static int rt_write(struct mtd_info *mtd, u8 *buf, const struct rt_module *m, loff_t part,
+		    loff_t len, sha256_context *ctx)
+{
+	loff_t blk = part, end = part + len;
+	int marked = 0, err;
+	u32 done, n, b;
+
+	if (mtd->writesize > sizeof(rt_page))
+		return -EINVAL;
+	for (done = 0; done < m->body; done += n) {
+		n = min_t(u32, RT_CHUNK, m->body - done);
+		if (rt_read(buf, m->off + done, n))
+			return -EIO;
+		sha256_update(ctx, buf, n);
+		memset(buf + n, 0xff, roundup(n, mtd->erasesize) - n);
+		for (b = 0; b < n; b += mtd->erasesize, blk += mtd->erasesize) {
+			err = rt_write_block(mtd, buf + b, part, end, &blk, &marked);
+			if (err)
+				return err;
+		}
+	}
+	return rt_erase_rest(mtd, part, blk, end, &marked);
+}
+
+/* Pass two for a module that is written later, from RAM: read into dst, and into the hash
+ * from there, so the bytes written are the bytes hashed. */
+static int rt_capture(u8 *dst, const struct rt_module *m, sha256_context *ctx)
+{
+	u32 done, n;
+
+	for (done = 0; done < m->body; done += n) {
+		n = min_t(u32, RT_CHUNK, m->body - done);
+		if (rt_read(dst + done, m->off + done, n))
+			return -EIO;
+		sha256_update(ctx, dst + done, n);
+	}
+	return 0;
+}
+
+/*
+ * The boot chain copies in the order the way back to stock writes them (stockBootSlots in
+ * app/internal/install/bootloaders.go, ADR 0009): Bose's SPL reads only the first U-Boot
+ * copy, so that goes first, while our SPL still runs and boots our spare instead of a first
+ * copy that is not ours; then Bose's SPL, backups before NAND.SPL, which the ROM moves on
+ * from when it is half written; the spare last, which Bose's chain never reads. No step
+ * runs our SPL with Bose's U-Boot or Bose's SPL with ours.
+ */
+static const struct rt_copy {
+	loff_t start, end;
+	bool uboot;
+	const char *name;
+} rt_stock_copies[] = {
+	{ RT_UBOOT, RT_UBOOT_SPARE, true, "NAND.U-Boot" },
+	{ 1 * RT_SPL_SIZE, 2 * RT_SPL_SIZE, false, "NAND.SPL.backup1" },
+	{ 2 * RT_SPL_SIZE, 3 * RT_SPL_SIZE, false, "NAND.SPL.backup2" },
+	{ 3 * RT_SPL_SIZE, 4 * RT_SPL_SIZE, false, "NAND.SPL.backup3" },
+	{ 0, RT_SPL_SIZE, false, "NAND.SPL" },
+	{ RT_UBOOT_SPARE, RT_ENV_REDUND, true, "the spare NAND.U-Boot" },
+};
+
+/*
+ * Whether the copy in [start, end) holds len bytes of data, read past bad blocks as
+ * nanddump --bb=skipbad does. To decide whether to write (strict), a read the NAND
+ * corrected as many bits in as it calls due for a rewrite (-EUCLEAN) counts as not holding
+ * them, as bootSlot.worn has it; to check a write, a corrected read is a good read.
+ */
+static bool rt_copy_holds(struct mtd_info *mtd, const struct rt_copy *c, const u8 *data, u32 len,
+			  bool strict)
+{
+	loff_t blk;
+	size_t ret;
+	u32 done = 0, p, n;
+	int err;
+
+	for (blk = c->start; done < len; blk += mtd->erasesize) {
+		if (blk >= c->end)
+			return false;
+		if (mtd_block_isbad(mtd, blk))
+			continue;
+		for (p = 0; p < mtd->erasesize && done < len; p += mtd->writesize, done += n) {
+			n = min_t(u32, len - done, mtd->writesize);
+			err = mtd_read(mtd, blk + p, mtd->writesize, &ret, rt_page);
+			if ((err && (strict || !mtd_is_bitflip(err))) || ret != mtd->writesize ||
+			    memcmp(rt_page, data + done, n))
+				return false;
+		}
+	}
+	return true;
+}
+
+/* Whether the good blocks of the copy hold len bytes (ubootGoodBlocks): checked for every
+ * copy before anything of the boot chain is written. */
+static bool rt_copy_fits(struct mtd_info *mtd, const struct rt_copy *c, u32 len)
+{
+	loff_t blk;
+	u32 room = 0;
+
+	for (blk = c->start; blk < c->end; blk += mtd->erasesize)
+		if (!mtd_block_isbad(mtd, blk))
+			room += mtd->erasesize;
+	return room >= len;
+}
+
+/*
+ * One copy written from RAM (data padded with 0xff to whole blocks) into its own range and
+ * nothing past it, as bootSlot.write does: image blocks into the good blocks in order, each
+ * read back, the rest of the range erased. A block that fails fails the write; nothing here
+ * is marked bad.
+ */
+static int rt_put(struct mtd_info *mtd, const struct rt_copy *c, const u8 *data, u32 len)
+{
+	loff_t blk = c->start;
+	int marked = RT_MARK_BAD_MAX, err;
+	u32 b;
+
+	for (b = 0; b < len; b += mtd->erasesize, blk += mtd->erasesize) {
+		rt_kick();
+		err = rt_write_block(mtd, data + b, c->start, c->end, &blk, &marked);
+		if (err)
+			return err;
+	}
+	return rt_erase_rest(mtd, c->start, blk, c->end, &marked);
+}
+
+/*
+ * Bose's boot chain over ours, as install.WriteBootloaders does it: in rt_stock_copies
+ * order, every copy that does not already hold Bose's bytes written and read back, the ones
+ * that do left alone; once anything was written, both U-Boot copies read again, as a block
+ * that went bad shifts what follows it. Stops at the first copy that fails.
+ */
+static int rt_boot_chain(struct mtd_info *mtd, const u8 *mlo, u32 mlo_len, const u8 *ub,
+			 u32 ub_len)
+{
+	const struct rt_copy *c;
+	int wrote = 0, err;
+
+	for (c = rt_stock_copies; c < rt_stock_copies + ARRAY_SIZE(rt_stock_copies); c++) {
+		const u8 *d = c->uboot ? ub : mlo;
+		u32 len = c->uboot ? ub_len : mlo_len;
+
+		if (rt_copy_holds(mtd, c, d, len, true)) {
+			printf("Update.stu: %s holds Bose's already; left alone\n", c->name);
+			continue;
+		}
+		printf("Update.stu: writing Bose's %s into %s\n", c->uboot ? "U-Boot" : "SPL", c->name);
+		err = rt_put(mtd, c, d, len);
+		if (!err && !rt_copy_holds(mtd, c, d, len, false))
+			err = -EIO;
+		if (err) {
+			printf("Update.stu: %s not written (%d)\n", c->name, err);
+			return err;
+		}
+		wrote++;
+	}
+	if (wrote && (!rt_copy_holds(mtd, &rt_stock_copies[0], ub, ub_len, false) ||
+		      !rt_copy_holds(mtd, &rt_stock_copies[5], ub, ub_len, false))) {
+		printf("Update.stu: NAND.U-Boot no longer holds Bose's U-Boot after the boot chain write\n");
+		return -EIO;
+	}
+	return 0;
+}
+
+/*
+ * The slot recipes our installers write: mainline_env_templates in
+ * os/installer/module/installer.c and mainlineTemplates in internal/flash/recipes.go, byte for
+ * byte (os/tests/installer/test_wla_env_recipes.py). Index 2 takes the device tree and the
+ * kernel, 3 the variant and the module type, 4 the variant.
+ */
+static const char *const rt_env_templates[] = {
+	"nand_boot=setenv slot Ping; setenv rmtd 8; setenv kaddr 0x280000; run slot_boot",
+	"nand_boot2=setenv slot Pong; setenv rmtd 9; setenv kaddr 0x780000; run slot_boot",
+	"slot_boot=if ubi part NAND.File-System-${slot} 2048; then if ubifsmount ubi0:rootfs; "
+		"then if ubifsload 0x83000000 /boot/%s; then mw.l 0x82000000 0 1; ubifsload "
+		"0x82000000 /boot/%s; if itest.l *0x82000000 == 0x56190527; then run "
+		"soundtap_args; bootm 0x82000000 - 0x83000000; fi; run stock_args; if nand read 0x80007fc0 "
+		"${kaddr} 0x500000; then if fixsig 0x80007fc0; then bootm 0x80007fc0 - 0x83000000; fi; "
+		"fi; fi; fi; fi; reset",
+	"soundtap_args=setenv bootargs console=ttyGS0,115200n8 root=ubi0:rootfs ro "
+		"rootfstype=ubifs ubi.mtd=${rmtd},2048 rootwait init=/init mem=128M cma=8M panic=10 "
+		"omap_wdt.early_enable=1 variant=%s module_type=%s country=GB region=GB "
+		"soundtap.nandroot=1 ubi.mtd=NAND.Persistent-Storage,2048",
+	"stock_args=setenv bootargs console=ttyO3,115200n8 quiet root=ubi0:rootfs ro "
+		"ubi.mtd=${rmtd},2048 noinitrd rootfstype=ubifs rootwait=1 ip=off variant=%s "
+		"variant_raw=${variant_raw} variant_mode=normal oled_type= country=GB region=GB",
+	"mtdids=nand0=nand0",
+	"mtdparts=mtdparts=nand0:0x20000@0x0(NAND.SPL),0x20000@0x20000(NAND.SPL.backup1),0x20000@0x40000(NAND.SPL.backup2),0x20000@0x60000(NAND.SPL.backup3),0x1E0000@0x80000(NAND.U-Boot),0x20000@0x260000(NAND.U-Boot-Env),0x500000@0x280000(NAND.Kernel-Ping),0x500000@0x780000(NAND.Kernel-Pong),0x6000000@0xC80000(NAND.File-System-Ping),0x6000000@0x6C80000(NAND.File-System-Pong),0x2600000@0xCC80000(NAND.Persistent-Storage),0xB80000@0xF280000(NAND.Update-Staging),0x40000@0xFE00000(NAND.Manufacturing-Data)",
+};
+
+/*
+ * A torn environment leaves U-Boot on its built-in one, which holds none of the recipes a
+ * saved bootcmd names, and Bose's names nboot.e. So when any is missing the whole
+ * set goes in for this board (rt_b, rt_m, rt_dtb and rt_kernel, as rt_board_setup set them), with the
+ * nand_args pair soundtapd needs to select a slot (rebuiltEnv in internal/flash): the
+ * environment this saves is complete on its own. One that has them all keeps them; its
+ * installer knew the model's variant (a Series III, say) better than the board does.
+ */
+static int rt_set_recipes(void)
+{
+	static char line[2048];
+	const char *v = env_get("rt_b"), *m = env_get("rt_m");
+	const char *dtb = env_get("rt_dtb"), *kernel = env_get("rt_kernel");
+	char *eq;
+	int i, n;
+
+	for (i = 0; i < ARRAY_SIZE(rt_env_templates); i++) {
+		n = strcspn(rt_env_templates[i], "=");
+		memcpy(line, rt_env_templates[i], n);
+		line[n] = 0;
+		if (!env_get(line))
+			break;
+	}
+	if (i == ARRAY_SIZE(rt_env_templates))
+		return 0;
+	if (!v || !m || !dtb || !kernel)
+		return -ENODEV;
+	for (i = 0; i < ARRAY_SIZE(rt_env_templates); i++) {
+		const char *t = rt_env_templates[i];
+
+		n = i == 2 ? snprintf(line, sizeof(line), t, dtb, kernel) :
+		    i == 3 ? snprintf(line, sizeof(line), t, v, m) :
+		    i == 4 ? snprintf(line, sizeof(line), t, v) :
+			     snprintf(line, sizeof(line), "%s", t);
+		eq = strchr(line, '=');
+		if (n < 0 || n >= sizeof(line) || !eq)
+			return -EINVAL;
+		*eq = 0;
+		if (env_set(line, eq + 1))
+			return -EIO;
+	}
+	if (!env_get("nand_args"))
+		env_set("nand_args", "setenv bootargs ${bootargs} ubi.mtd=8,2048");
+	if (!env_get("nand_args2"))
+		env_set("nand_args2", "setenv bootargs ${bootargs} ubi.mtd=9,2048");
+	printf("Update.stu: boot recipes for %s_%s written with the slot\n", v, m);
+	return 0;
+}
+
+/*
+ * The slot this boot would run, as autoboot will pick it: altbootcmd once the coming boot's
+ * count passes bootlimit (bootdelay_process counts it after this spy), bootcmd otherwise.
+ * With no environment both are the built-in defaults, and bootcmd's slot is the one tried.
+ */
+static const char *rt_booting_cmd(void)
+{
+	const char *bootcmd = env_get("bootcmd");
+	const char *alt = env_get("altbootcmd");
+	ulong limit = env_get_ulong("bootlimit", 10, 0);
+	ulong count = env_get_ulong("bootcount", 10, 0);
+
+#ifdef CONFIG_BOOTCOUNT_LIMIT
+	count = bootcount_load();
+#endif
+	if (alt && limit && count + 1 > limit)
+		return alt;
+	return bootcmd;
+}
+
+/* The slot a boot command runs by the first slot recipe it names: 1 Ping (nand_boot), 2 Pong
+ * (nand_boot2), 0 when it names none, as the built-in bootcmd does. */
+static int rt_named_slot(const char *cmd)
+{
+	const char *p = cmd ? strstr(cmd, "nand_boot") : NULL;
+
+	if (!p)
+		return 0;
+	return p[9] == '2' ? 2 : 1;
+}
+
+/*
+ * Whether the built-in bootcmd (CONFIG_BOOTCOMMAND) boots slot: the same steps in the same
+ * order -- the slot's UBI, its rootfs volume, /boot/${rt_v}_${rt_m}.dtb, /boot/uImage-${rt_v}
+ * with the uImage magic -- and the header and data CRCs bootm then checks. Attaching reads
+ * the slot as every boot of it does; UBI is detached again before anything is written.
+ */
+static bool rt_slot_bootable(const char *slot)
+{
+	static char cmd[128];
+	const char *v = env_get("rt_v"), *m = env_get("rt_m");
+	const struct legacy_img_hdr *hdr = map_sysmem(0x82000000, 0);
+	ulong size;
+	bool ok = false;
+
+	if (!v || !m)
+		return false;
+	snprintf(cmd, sizeof(cmd), "ubi part NAND.File-System-%s 2048", slot);
+	if (run_command(cmd, 0) || run_command("ubifsmount ubi0:rootfs", 0))
+		goto out;
+	snprintf(cmd, sizeof(cmd), "ubifsload 0x83000000 /boot/%s_%s.dtb", v, m);
+	if (run_command(cmd, 0))
+		goto out;
+	run_command("mw.l 0x82000000 0 1", 0);
+	snprintf(cmd, sizeof(cmd), "ubifsload 0x82000000 /boot/uImage-%s", v);
+	if (run_command(cmd, 0))
+		goto out;
+	size = env_get_hex("filesize", 0);
+	ok = image_check_magic(hdr) && image_check_hcrc(hdr) && size >= image_get_header_size() &&
+	     image_get_data_size(hdr) <= size - image_get_header_size() && image_check_dcrc(hdr);
+out:
+	run_command("ubi detach", 0);
+	printf("Update.stu: %s %s what the built-in bootcmd boots\n", slot, ok ? "holds" : "does not hold");
+	return ok;
+}
+
+/*
+ * The slot the coming boot runs, true for Pong, which the stick must not write (ADR 0010). A
+ * boot command that names a slot recipe says which. One that names none is the built-in
+ * bootcmd of a lost environment: it tries Pong, then Ping, so it runs Pong when Pong holds
+ * a kernel and device tree that load and check out, and Ping otherwise. *unnamed is set
+ * then: nothing saved selects that slot yet, and the built-in bootcmd would try the other
+ * one too, so the caller saves a selection before it erases anything.
+ */
+static bool rt_booting_pong(const char *booting, bool *unnamed)
+{
+	int n = rt_named_slot(booting);
+
+	*unnamed = !n;
+	if (n)
+		return n == 2;
+	return rt_slot_bootable("Pong");
+}
+
+/*
+ * The environment as one 8 KiB copy, the format Bose's U-Boot reads (UseLegacyEnv in
+ * internal/flash): a CRC-32 and the entries, NUL separated, zero padded. margin keeps that
+ * many bytes free, for a check made before the entries that are still to come are set.
+ */
+static u8 rt_env_img[RT_ENV_LEGACY];
+
+static int rt_env_export(int margin)
+{
+	char *data = (char *)rt_env_img + 4;
+
+	memset(rt_env_img, 0, sizeof(rt_env_img));
+	if (hexport_r(&env_htab, '\0', 0, &data, sizeof(rt_env_img) - 4 - margin, 0, NULL) < 0)
+		return -EFBIG;
+	put_unaligned_le32(crc32(0, rt_env_img + 4, sizeof(rt_env_img) - 4), rt_env_img);
+	return 0;
+}
+
+/*
+ * The environment in RAM written as that copy into NAND.U-Boot-Env and read back, then,
+ * with drop_redundant, the redundant copy in the last block of NAND.U-Boot erased and read
+ * back erased, as UseLegacyEnv does. Until that erase our U-Boot boots the redundant copy;
+ * from it on it boots this one (CONFIG_ENV_REDUNDANT_UPGRADE), and Bose's U-Boot reads only
+ * this one. Afterwards a save of this U-Boot goes to the redundant copy, as after a boot
+ * that read this one (env_nand_save writes CONFIG_ENV_OFFSET_REDUND when ENV_VALID), and
+ * never over the copy Bose's U-Boot reads.
+ */
+static int rt_env_legacy(struct mtd_info *mtd, bool drop_redundant)
+{
+	struct erase_info ei = { .mtd = mtd, .addr = RT_ENV_OFFSET, .len = mtd->erasesize };
+	size_t ret;
+	u32 p;
+	int err;
+
+	err = rt_env_export(0);
+	if (err)
+		return err;
+	if (mtd_erase(mtd, &ei) ||
+	    mtd_write(mtd, RT_ENV_OFFSET, sizeof(rt_env_img), &ret, rt_env_img) ||
+	    ret != sizeof(rt_env_img))
+		return -EIO;
+	for (p = 0; p < sizeof(rt_env_img); p += mtd->writesize) {
+		err = mtd_read(mtd, RT_ENV_OFFSET + p, mtd->writesize, &ret, rt_page);
+		if ((err && !mtd_is_bitflip(err)) || ret != mtd->writesize ||
+		    memcmp(rt_page, rt_env_img + p, mtd->writesize))
+			return -EIO;
+	}
+	if (drop_redundant && !mtd_block_isbad(mtd, RT_ENV_REDUND)) {
+		struct erase_info er = { .mtd = mtd, .addr = RT_ENV_REDUND, .len = mtd->erasesize };
+
+		if (mtd_erase(mtd, &er))
+			return -EIO;
+		for (p = 0; p < RT_ENV_SIZE; p += mtd->writesize) {
+			err = mtd_read(mtd, RT_ENV_REDUND + p, mtd->writesize, &ret, rt_page);
+			if ((err && !mtd_is_bitflip(err)) || ret != mtd->writesize ||
+			    !rt_page_empty(rt_page, mtd->writesize))
+				return -EIO;
+		}
+	}
+	gd->env_valid = ENV_VALID;
+	return 0;
+}
+
+/* The two slot recipes the way back writes for Bose's U-Boot (stockRecipes in
+ * app/internal/flash/recipes.go, byte for byte). */
+static const char *const rt_stock_recipes[] = {
+	"nand_boot=run nand_args; mtdparts default; ubi part NAND.File-System-Ping 2048; "
+		"ubifsmount ubi0; ubifsload ${loadaddr} /boot/${variant}_${module_type}.dtb; "
+		"fdt addr ${loadaddr}; nboot.e ${kloadaddr} 0 ${kernel0_nand_address}; fixsig; "
+		"bootm ${kloadaddr} - ${loadaddr}",
+	"nand_boot2=run nand_args2; mtdparts default; ubi part NAND.File-System-Pong 2048; "
+		"ubifsmount ubi0; ubifsload ${loadaddr} /boot/${variant}_${module_type}.dtb; "
+		"fdt addr ${loadaddr}; nboot.e ${kloadaddr} 0 ${kernel1_nand_address}; fixsig; "
+		"bootm ${kloadaddr} - ${loadaddr}",
+};
+
+/* Entries only Bose's own environment defines, which those recipes read. */
+static const char *const rt_stock_vars[] = {
+	"nand_args", "nand_args2", "loadaddr", "kloadaddr", "kernel0_nand_address",
+	"kernel1_nand_address",
+};
+
+/* key's value without the fields a SoundTap install adds (isSoundTapMarker): soundtap.nandroot=1
+ * and a ubi.mtd= naming a partition. ubi.mtd=8,2048 is stock's own and stays. */
+static void rt_strip_markers(const char *key)
+{
+	static char out[1024];
+	const char *v = env_get(key), *f, *e;
+	size_t len = 0, n;
+
+	if (!v || strlen(v) >= sizeof(out))
+		return;
+	for (f = v; *f; f = e) {
+		while (*f == ' ')
+			f++;
+		for (e = f; *e && *e != ' '; e++)
+			;
+		n = e - f;
+		if (!n || (n == 19 && !strncmp(f, "soundtap.nandroot=1", n)) ||
+		    (n > 13 && !strncmp(f, "ubi.mtd=NAND.", 13)))
+			continue;
+		if (len)
+			out[len++] = ' ';
+		memcpy(out + len, f, n);
+		len += n;
+	}
+	out[len] = 0;
+	env_set(key, out);
+}
+
+/*
+ * The environment Bose's U-Boot boots the new slot with, as the way back leaves it: its slot
+ * recipes in place of ours and the entries only our U-Boot reads gone (InstallStockRecipes),
+ * no rollback and no SoundTap markers (SelectBootSlot with none, armRollback, markUnconfirmed).
+ * bootcmd names the new slot already. An environment without Bose's own entries (rebuilt
+ * after it was torn) keeps our recipes, which Bose's U-Boot runs too (replaceBootloaders):
+ * Bose's would read variables that are not there.
+ */
+static void rt_stock_env(void)
+{
+	static char line[512];
+	bool bose = true;
+	int i, n;
+
+	for (i = 0; i < ARRAY_SIZE(rt_stock_vars); i++)
+		if (!env_get(rt_stock_vars[i]))
+			bose = false;
+	if (bose) {
+		for (i = 0; i < ARRAY_SIZE(rt_stock_recipes); i++) {
+			n = strcspn(rt_stock_recipes[i], "=");
+			memcpy(line, rt_stock_recipes[i], n);
+			line[n] = 0;
+			env_set(line, rt_stock_recipes[i] + n + 1);
+		}
+		for (i = 2; i < ARRAY_SIZE(rt_env_templates); i++) {
+			n = strcspn(rt_env_templates[i], "=");
+			memcpy(line, rt_env_templates[i], n);
+			line[n] = 0;
+			env_set(line, NULL);
+		}
+	} else {
+		printf("Update.stu: the environment holds none of Bose's own entries; our slot "
+		       "recipes stay\n");
+	}
+	/* Ours is -2 where UART0 is a link to another processor (rt_board_setup); Bose's
+	 * environment has 1, as InstallStockRecipes puts back. */
+	if (env_get("bootdelay") && !strcmp(env_get("bootdelay"), "-2"))
+		env_set("bootdelay", "1");
+	env_set("altbootcmd", NULL);
+	env_set("bootlimit", NULL);
+	env_set("upgrade_available", NULL);
+	env_set("bootcount", NULL);
+	rt_strip_markers("nand_args");
+	rt_strip_markers("nand_args2");
+}
+
+/*
+ * Select the slot just written, as a normal install leaves it (armRollback in internal/flash,
+ * ADR 0010): the new slot boots, the one it was installed next to is the fallback, and the
+ * count starts over, so a recovered slot that never confirms rolls back instead of
+ * retrying. It is unconfirmed, so the count is kept in the environment too, where a power
+ * cut does not clear it (bootcount_davinci.c), in this same save.
+ */
+static int rt_select(const char *next, const char *prev)
+{
+	int ret;
+
+	env_set("bootcmd", next);
+	env_set("altbootcmd", prev);
+	env_set("bootlimit", "4");
+	env_set("upgrade_available", "1");
+	env_set("bootcount", "0");
+	ret = env_save();
+	if (ret) {
+		/* The environment in RAM names the new slot and the one on NAND does not: reset,
+		 * so the boot reads what is saved, the slot that booted before. */
+		printf("Update.stu: environment not saved (%d); resetting\n", ret);
+		do_reset(NULL, 0, 0, NULL);
+		return ret;
+	}
+#ifdef CONFIG_BOOTCOUNT_LIMIT
+	bootcount_store(0);	/* the RTC: the environment already holds 0 */
+#endif
+	return 0;
+}
+
+/*
+ * Whether this U-Boot reads the SPL the ROM booted, in NAND.SPL, without an ECC error and as
+ * the image the ROM loads. That SPL was written from Linux, in the ECC layout the ROM reads;
+ * read here without an error, this U-Boot's layout is that one, and the SPL copies it writes
+ * are ones the ROM can load. A layout that differed would fail every page.
+ */
+static bool rt_spl_readable(struct mtd_info *mtd)
+{
+	size_t ret;
+	u32 p;
+	int err;
+
+	for (p = 0; p < 4 * mtd->writesize; p += mtd->writesize) {
+		err = mtd_read(mtd, p, mtd->writesize, &ret, rt_page);
+		if ((err && !mtd_is_bitflip(err)) || ret != mtd->writesize)
+			return false;
+		if (!p && (get_unaligned_le32(rt_page) != 0x40 ||
+			   get_unaligned_le32(rt_page + 0x204) != 0x402f0400))
+			return false;
+	}
+	return true;
+}
+
+/*
+ * Before anything of Bose's package is written: its kernel is Bose's, this U-Boot reads the
+ * SPL the ROM booted (rt_spl_readable), NAND.U-Boot-Env is
+ * on a good block (Bose's U-Boot finds no environment elsewhere), every boot chain copy
+ * has the room, and the environment with our recipes -- which our U-Boot boots the new
+ * slot by until Bose's replaces it -- leaves room in 8 KiB for the selection.
+ */
+static int rt_bose_preflight(struct mtd_info *mtd, u8 *buf, struct rt_pkg *pkg)
+{
+	const struct rt_copy *c;
+	int ret;
+
+	ret = rt_kernel_ok(buf, pkg->kernel);
+	if (ret)
+		return ret;
+	if (!rt_spl_readable(mtd)) {
+		printf("Update.stu: NAND.SPL does not read back as the SPL the ROM boots; Bose's boot "
+		       "chain is not written from here, nothing written\n");
+		return -EIO;
+	}
+	if (mtd_block_isbad(mtd, RT_ENV_OFFSET)) {
+		printf("Update.stu: NAND.U-Boot-Env is a bad block, where Bose's U-Boot reads its "
+		       "environment; nothing written\n");
+		return -EIO;
+	}
+	for (c = rt_stock_copies; c < rt_stock_copies + ARRAY_SIZE(rt_stock_copies); c++)
+		if (!rt_copy_fits(mtd, c, c->uboot ? pkg->uboot->size : pkg->mlo->size)) {
+			printf("Update.stu: %s has no room for Bose's copy; nothing written\n", c->name);
+			return -ENOSPC;
+		}
+	ret = rt_set_recipes();
+	if (ret)
+		return ret;
+	if (rt_env_export(128)) {
+		printf("Update.stu: the environment does not fit the 8 KiB Bose's U-Boot reads; "
+		       "nothing written\n");
+		return -EFBIG;
+	}
+	return 0;
+}
+
+/*
+ * Bose's package after pass two: its kernel and ubi.img are in the slot that is not
+ * booting, read back, and nothing selects that slot yet; its SPL and U-Boot are in RAM,
+ * hashed from there. What a power cut leaves at each step:
+ *
+ * 1. Bose's SPL and U-Boot checked. Fails: nothing selected, the old slot boots.
+ * 2. The new slot selected with our recipes, in our redundant environment (rt_select).
+ *    Before the save: the old slot. After: our U-Boot boots the new slot through slot_boot's
+ *    stock_args arm (Bose's kernel from the slot's kernel partition, fixsig, the device tree
+ *    from its /boot), with the old slot as the fallback after four unconfirmed boots.
+ * 3. A second save, so both redundant copies hold that environment, and the one the next
+ *    step overwrites is no older copy that would come back.
+ * 4. The 8 KiB copy into NAND.U-Boot-Env, then the redundant copy erased (rt_env_legacy).
+ *    Cut before the erase: our U-Boot reads the redundant copy, the same entries. After:
+ *    the 8 KiB copy, the same entries again, which Bose's U-Boot reads as well.
+ * 5. Bose's U-Boot, SPLs and spare in rt_stock_copies order, the ones that differ. Cut
+ *    during the first U-Boot copy or the SPL backups: our SPL boots our spare, as in 2.
+ *    During NAND.SPL: the ROM moves on to backup1, Bose's SPL, which boots Bose's U-Boot
+ *    from the first copy; it runs our recipes from the 8 KiB copy (they boot under Bose's
+ *    U-Boot too, as replaceBootloaders relies on) into the new slot. After NAND.SPL the
+ *    same; the spare is never read by Bose's chain.
+ * 6. Bose's recipes into the 8 KiB copy (rt_stock_env). A cut while that one block is
+ *    erased and written leaves Bose's U-Boot on its built-in environment: the window the
+ *    way back through /api/firmware has too.
+ * 7. Reset into Bose's boot chain: our U-Boot, still running, cannot run Bose's recipes.
+ *
+ * A failure from 3 on leaves the new slot selected and the boot going on under this U-Boot,
+ * which still runs our recipes; a failure in 6 resets as well.
+ */
+static int rt_bose_finish(struct mtd_info *mtd, struct rt_pkg *pkg, const u8 *mlo, const u8 *ub,
+			  const char *next, const char *prev)
+{
+	int ret;
+
+	ret = rt_boot_ok(mlo, pkg->mlo->size, ub, pkg->uboot->size);
+	if (ret) {
+		printf("Update.stu: MLO or u-boot.img is not a boot loader this board runs; "
+		       "nothing selected\n");
+		return ret;
+	}
+	ret = rt_set_recipes();
+	if (!ret)
+		ret = rt_select(next, prev);
+	if (ret)
+		return ret;
+	ret = env_save();
+	if (!ret)
+		ret = rt_env_legacy(mtd, true);
+	if (!ret)
+		ret = rt_boot_chain(mtd, mlo, pkg->mlo->size, ub, pkg->uboot->size);
+	if (ret) {
+		printf("Update.stu: Bose's slot selected under this U-Boot; Bose's boot chain not "
+		       "written (%d)\n", ret);
+		return ret;
+	}
+	rt_stock_env();
+	ret = rt_env_legacy(mtd, false);
+	if (ret)
+		printf("Update.stu: Bose's environment not written (%d)\n", ret);
+	else
+		printf("Update.stu: Bose's firmware installed; starting it\n");
+	do_reset(NULL, 0, 0, NULL);
+	return ret;
+}
+
+static int rt_usb_update(void)
+{
+	const char *bootcmd, *alt, *next, *prev;
+	bool st20 = rt_st20(), pong, unnamed;
+	loff_t part, kpart;
+	struct mtd_info *mtd = get_nand_dev_by_index(0);
+	static struct rt_pkg pkg;
+	static u8 hdr[RT_STU_HEADER];
+	struct rt_module *w[4];
+	sha256_context ctx;
+	u8 digest[SHA256_SUM_LEN], again[SHA256_SUM_LEN];
+	u8 *buf, *mlo = NULL, *ub = NULL;
+	loff_t file, pos;
+	int ret, i, nw = 0;
+
+	if (!mtd || mtd->erasesize > RT_CHUNK || RT_CHUNK % mtd->erasesize)
+		return -ENODEV;
+	buf = malloc_cache_aligned(RT_CHUNK);
+	if (!buf)
+		return -ENOMEM;
+	if (st20)
+		rt_st20_microbsel(0);
+	ret = rt_usb_host_start();
+	if (ret)
+		goto out;
+	if (rt_find_stick() && st20) {
+		usb_stop();
+		rt_st20_microbsel(1);
+		ret = usb_init();
+		if (ret)
+			goto out;
+	}
+	ret = rt_find_stick();
+	if (ret)
+		goto out;
+	if (fs_size(RT_STU_NAME, &file)) {
+		printf("USB UPDATE FILE NOT FOUND\n");
+		ret = -ENOENT;
+		goto out;
+	}
+	memset(&pkg, 0, sizeof(pkg));
+	ret = rt_scan(buf, file, &pkg);
+	if (!ret)
+		ret = rt_classify(&pkg, mtd->erasesize);
+	if (!ret && pkg.bose)
+		ret = rt_bose_preflight(mtd, buf, &pkg);
+	if (ret)
+		goto out;
+	/* Pass one: nothing is erased before every CRC of Update.stu checks out. */
+	printf("Update.stu: %lld bytes, %s, checking\n", file,
+	       pkg.bose ? "Bose's firmware" : "SoundTap");
+	sha256_starts(&ctx);
+	ret = rt_check(buf, &pkg, &ctx, file);
+	if (ret)
+		goto out;
+	sha256_finish(&ctx, digest);
+	/* What pass two writes, in the order the package holds it. Bose's SPL and U-Boot go
+	 * into RAM, written only once the whole file has hashed the same twice. */
+	if (pkg.bose) {
+		mlo = malloc_cache_aligned(roundup(RT_SPL_SIZE, mtd->erasesize));
+		ub = malloc_cache_aligned(roundup(RT_UBOOT_MAX, mtd->erasesize));
+		if (!mlo || !ub) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		memset(mlo, 0xff, roundup(RT_SPL_SIZE, mtd->erasesize));
+		memset(ub, 0xff, roundup(RT_UBOOT_MAX, mtd->erasesize));
+		w[nw++] = pkg.kernel;
+	}
+	w[nw++] = pkg.rootfs;
+	if (pkg.bose) {
+		w[nw++] = pkg.mlo;
+		w[nw++] = pkg.uboot;
+	}
+	/*
+	 * Install into the slot that is not booting (rt_booting_pong), decided only now that
+	 * the package checked out, so a gesture without a good stick attaches no UBI.
+	 */
+	pong = rt_booting_pong(rt_booting_cmd(), &unnamed);
+	part = pong ? RT_PING_ROOTFS : RT_PONG_ROOTFS;
+	kpart = pong ? RT_PING_KERNEL : RT_PONG_KERNEL;
+	next = pong ? "run nand_boot;" : "run nand_boot2;";
+	prev = pong ? "run nand_boot2;" : "run nand_boot;";
+	bootcmd = env_get("bootcmd");
+	alt = env_get("altbootcmd");
+	/*
+	 * Nothing may name the slot about to be erased while it is written (ADR 0010): a power
+	 * cut would leave bootcmd or altbootcmd on a half-written slot. Point both at the slot
+	 * that boots first, saved, and start its count over; if that save fails, nothing is
+	 * erased. The built-in bootcmd of a lost environment tries both slots, Pong first, so
+	 * it always gets that selection, with the recipes it runs by (rt_set_recipes): left
+	 * in place, a cut while Pong is written would have it try a half-written Pong.
+	 */
+	if (unnamed || (bootcmd && strstr(bootcmd, next)) || (alt && strstr(alt, next))) {
+		ret = unnamed ? rt_set_recipes() : 0;
+		if (ret) {
+			printf("Update.stu: no boot recipes for this board (%d); nothing written\n", ret);
+			goto out;
+		}
+		env_set("bootcmd", prev);
+		env_set("altbootcmd", prev);
+		env_set("bootcount", "0");
+		ret = env_save();
+		if (ret) {
+			printf("Update.stu: environment not saved (%d); nothing written\n", ret);
+			goto out;
+		}
+#ifdef CONFIG_BOOTCOUNT_LIMIT
+		bootcount_store(0);
+#endif
+	}
+	/*
+	 * Pass two hashes the whole file again, in order, with every module it writes hashed
+	 * from the very buffers it is written from, and each of their headers compared with
+	 * the one that placed it. A stick that reads back otherwise ends with another digest,
+	 * and nothing is selected. The spare slot is written by then, as an interrupted
+	 * /api/firmware leaves it; the slot that boots is untouched.
+	 */
+	printf("Update.stu: writing %s\n", pong ? "PING" : "PONG");
+	sha256_starts(&ctx);
+	for (pos = 0, i = 0; !ret && i < nw; pos = w[i]->off + w[i]->body, i++) {
+		ret = rt_hash(buf, &ctx, pos, w[i]->off - pos);
+		if (!ret)
+			ret = rt_read(hdr, w[i]->off - RT_STU_HEADER, RT_STU_HEADER);
+		if (!ret && crc32(0, hdr, RT_STU_HEADER) != w[i]->hcrc)
+			ret = -EBADMSG;
+		if (ret)
+			break;
+		if (w[i] == pkg.rootfs)
+			ret = rt_write(mtd, buf, w[i], part, RT_SLOT_SIZE, &ctx);
+		else if (w[i] == pkg.kernel)
+			ret = rt_write(mtd, buf, w[i], kpart, RT_KERNEL_SIZE, &ctx);
+		else
+			ret = rt_capture(w[i] == pkg.mlo ? mlo : ub, w[i], &ctx);
+	}
+	if (!ret)
+		ret = rt_hash(buf, &ctx, pos, file - pos);
+	if (ret)
+		goto out;
+	sha256_finish(&ctx, again);
+	if (memcmp(digest, again, SHA256_SUM_LEN)) {
+		printf("Update.stu: read back otherwise the second time; nothing selected\n");
+		ret = -EBADMSG;
+		goto out;
+	}
+	if (pkg.bose) {
+		ret = rt_bose_finish(mtd, &pkg, mlo, ub, next, prev);
+		goto out;
+	}
+	ret = rt_set_recipes();
+	if (!ret)
+		ret = rt_select(next, prev);
+out:
+	free(ub);
+	free(mlo);
+	free(buf);
+	return ret;
+}
+
+/*
+ * The Wireless Link has no preset keys, only two buttons: Bluetooth on gpio0_23 and AUX on
+ * gpio0_27, low when pressed, pulled up on the board (docs/hardware/wla/buttons.md). Both held at
+ * power-on stand in for VOLUME DOWN + PRESET 4; the stick goes in its micro-B, as on the
+ * ST10 (ADR 0130).
+ */
+static const char *const rt_wla_buttons[] = { "gpio@44e07000_23", "gpio@44e07000_27" };
+
+static struct module_pin_mux rt_wla_button_pin_mux[] = {
+	{OFFSET(gpmc_ad9), MODE(7) | RXACTIVE | PULLUDDIS},
+	{OFFSET(gpmc_ad11), MODE(7) | RXACTIVE | PULLUDDIS},
+	{-1},
+};
+
+static bool rt_wla_both_held(void)
+{
+	struct gpio_desc in[ARRAY_SIZE(rt_wla_buttons)] = {};
+	int held = 0, n;
+
+	configure_module_pin_mux(rt_wla_button_pin_mux);
+	for (n = 0; n < ARRAY_SIZE(rt_wla_buttons); n++)
+		if (!dm_gpio_lookup_name(rt_wla_buttons[n], &in[n]) &&
+		    !dm_gpio_request(&in[n], "button") &&
+		    !dm_gpio_set_dir_flags(&in[n], GPIOD_IS_IN) &&
+		    dm_gpio_get_value(&in[n]) == 0)
+			held++;
+	for (n = 0; n < ARRAY_SIZE(rt_wla_buttons); n++)
+		if (dm_gpio_is_valid(&in[n]))
+			dm_gpio_free(in[n].dev, &in[n]);
+	return held == ARRAY_SIZE(rt_wla_buttons);
+}
+
+/*
+ * The SA-5 (burns) and the SoundTouch adapter (lisa, lisa2) have one button straight on a
+ * GPIO, besides any keypad stock scans: stock's bit 9 (0x200), gpio0_27 on the SM2 and
+ * gpio0_29 on the SCM. Held at power-on, stock runs the emergency update from USB. It is
+ * read with the module's keypad pad mux and no strobe driven, as stock reads it after its scan.
+ */
+static bool rt_single_button_held(void)
+{
+	bool scm = rt_st20();
+	struct gpio_desc in = {};
+	bool held = false;
+
+	configure_module_pin_mux(scm ? rt_st20_keypad_pin_mux : rt_keypad_pin_mux);
+	if (!dm_gpio_lookup_name(scm ? "gpio@44e07000_29" : "gpio@44e07000_27", &in) &&
+	    !dm_gpio_request(&in, "button") &&
+	    !dm_gpio_set_dir_flags(&in, GPIOD_IS_IN))
+		held = dm_gpio_get_value(&in) == 0;
+	if (dm_gpio_is_valid(&in))
+		dm_gpio_free(in.dev, &in);
+	return held;
+}
+
+/*
+ * The ST300 (ginger) has no keypad on the module: its keys and IR live on the LPM, which
+ * raises a module GPIO at power-on when the remote's recovery combo is held (SoundTouch,
+ * then CC held while power comes back; Bose's documented USB update). Stock U-Boot reads
+ * it asserted high: gpio0_26 on this SM2 module (bits 17:16 of 0x44e107fc = 2), gpio0_23
+ * on the other revision. Its second pin (gpio0_22, factory reset) is not used: SoundTap
+ * only offers the preserving update. Stock brackets the update with LPM frames over UART0;
+ * this does not, as the update writes the other slot and a reset midway boots the old one.
+ */
+static bool rt_ginger_combo(void)
+{
+	bool rev2 = ((readl(0x44e107fc) >> 16) & 3) == 2;
+	struct module_pin_mux mux[] = {
+		{rev2 ? OFFSET(gpmc_ad10) : OFFSET(gpmc_ad9), MODE(7) | RXACTIVE | PULLUDEN},
+		{-1},
+	};
+	struct gpio_desc in = {};
+	bool held;
+
+	configure_module_pin_mux(mux);
+	held = !dm_gpio_lookup_name(rev2 ? "gpio@44e07000_26" : "gpio@44e07000_23", &in) &&
+	       !dm_gpio_request(&in, "recovery") &&
+	       !dm_gpio_set_dir_flags(&in, GPIOD_IS_IN) &&
+	       dm_gpio_get_value(&in) == 1;
+	if (dm_gpio_is_valid(&in))
+		dm_gpio_free(in.dev, &in);
+	return held;
+}
+
+/*
+ * Tell Linux the gesture was seen: soundtap.recovery=<result> on the kernel command line,
+ * 0 for an install, a negative errno otherwise (-19 no stick, -2 no Update.stu, -8 not a
+ * .stu or not a package for this speaker, -74 a header or image CRC that does not check
+ * out or a stick that read back otherwise, -5 a read or NAND error). A gesture
+ * with no stick in is how the trigger is tested without installing anything. It is added
+ * where the command line goes into the device tree (board_fdt_chosen_bootargs), never to
+ * the environment: the boot count of an unconfirmed slot saves the environment after this
+ * runs, and the next boot must not carry it.
+ */
+#define RT_NO_RECOVERY		1	/* no gesture this boot */
+static int rt_recovery_result = RT_NO_RECOVERY;
+
+static void rt_mark_cmdline(int ret)
+{
+	rt_recovery_result = ret;
+}
+
+static int rt_usb_recovery(void)
+{
+	/* The model from the board, never from the environment, which may be torn or another
+	 * board's: rt_board_setup set rt_b from the variant resistor (the SCM boards), the
+	 * manufacturing partition (the SM2 boards) or variant_raw. That spy runs first: the
+	 * linker list sorts spies by name. Every board with the 3x3 keypad takes stock's
+	 * Volume Down + Preset 4, on the scan its module wires (rt_st20). */
+	const char *v = env_get("rt_b");
+	int ret;
+
+	if (!v)
+		return 0;
+	if (!strcmp(v, "ginger")) {
+		if (!rt_ginger_combo())
+			return 0;
+		mdelay(50);
+		if (!rt_ginger_combo())
+			return 0;
+	} else if (!strcmp(v, "binky")) {
+		if (!rt_wla_both_held())
+			return 0;
+		mdelay(50);
+		if (!rt_wla_both_held())
+			return 0;
+	} else if (!strcmp(v, "burns") || !strcmp(v, "lisa") || !strcmp(v, "lisa2")) {
+		/* Stock's one button, or the keypad's Volume Down + Preset 4: an ST20 whose
+		 * variant resistor reads in the adapter's range still takes its own gesture. */
+		if (!rt_single_button_held() && rt_keypad_scan() != RT_KEYS_PRESERVE)
+			return 0;
+		mdelay(50);
+		if (!rt_single_button_held() && rt_keypad_scan() != RT_KEYS_PRESERVE)
+			return 0;
+	} else {
+		if (strcmp(v, "rhino") && strcmp(v, "spotty") && strcmp(v, "mojo") &&
+		    strcmp(v, "taigan") && strcmp(v, "spotty3") && strcmp(v, "mojo3"))
+			return 0;
+		/* Two sweeps 50 ms apart must agree, as stock's own exact-mask test does. */
+		if (rt_keypad_scan() != RT_KEYS_PRESERVE)
+			return 0;
+		mdelay(50);
+		if (rt_keypad_scan() != RT_KEYS_PRESERVE)
+			return 0;
+	}
+	printf("Emergency Update from USB - preserve...\n");
+	ret = rt_usb_update();
+	usb_stop();
+	if (ret) {
+		printf("Emergency Update failed (%d); booting what the environment selects\n", ret);
+		if (ret == -ENOEXEC)
+			rt_lamp_refused();
+		else
+			rt_lamp_fail();
+	}
+	rt_lamp(true);
+	if (!ret)
+		printf("Emergency Update done; booting it\n");
+	rt_mark_cmdline(ret);
+	/* Either way the boot goes on: bootcmd names the new slot only if it checked out
+	 * (a Bose package that got as far as its boot chain has reset by now). */
+	return 0;
+}
+EVENT_SPY_SIMPLE(EVT_LAST_STAGE_INIT, rt_usb_recovery);
+
+/*
+ * What this U-Boot adds to the kernel command line: the gesture's result, and, on every
+ * boot, that it reads the redundant environment, so soundtapd writes that format and no
+ * other (flash.EnvRedundantMarker, ADR 0010): an older U-Boot of ours, or Bose's, reads
+ * one 8 KiB copy and falls back to its built-in default on two of 32 KiB. fdt_chosen puts
+ * what this returns in /chosen/bootargs, the line the kernel takes.
+ */
+#ifdef CONFIG_ENV_REDUNDANT
+#define RT_ENV_MARKER		" soundtap.env=redundant"
+#else
+#define RT_ENV_MARKER		""
+#endif
+
+const char *board_fdt_chosen_bootargs(const struct fdt_property *fdt_ba)
+{
+	const char *args = env_get("bootargs");
+	static char *line;
+
+	if (!args)
+		return NULL;
+	free(line);
+	line = malloc(strlen(args) + sizeof(RT_ENV_MARKER) + 32);
+	if (!line)
+		return args;
+	if (rt_recovery_result != RT_NO_RECOVERY)
+		sprintf(line, "%s%s soundtap.recovery=%d", args, RT_ENV_MARKER, rt_recovery_result);
+	else
+		sprintf(line, "%s%s", args, RT_ENV_MARKER);
+	return line;
+}
+#endif

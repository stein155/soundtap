+/*
+ * Stock blinks its lamps while it installs from a stick. The ST10's Wi-Fi lamp (gpio0_19)
+ * is already a lit GPIO output here (uboot-2026.07-early-lamp.patch), so it toggles once
+ * per chunk read or written: a blink that runs as fast as the install does, and stops if
+ * it hangs. The ST20's pad is the BCO's clock and is left alone.
+ */
+static void rt_lamp(bool on)
+{
+	if (!rt_st20())
+		writel(1 << 19, on ? 0x44e07194 : 0x44e07190);	/* GPIO0 SET/CLEARDATAOUT */
+}
+
+/* Failure: ten quick blinks, then the lamp back on as the boot goes on. */
+static void rt_lamp_fail(void)
+{
+	int i;
+
+	for (i = 0; i < 20; i++) {
+		rt_lamp(i & 1);
+		mdelay(100);
+	}
+}
+
+/* Refused, nothing written: not a .stu, or not a package for this speaker. Three slow
+ * blinks, so it is not taken for a stick that could not be read. */
+static void rt_lamp_refused(void)
+{
+	int i;
+
+	for (i = 0; i < 6; i++) {
+		rt_lamp(i & 1);
+		mdelay(600);
+	}
+}

+/*
+ * One module of the package: where its payload starts, what its header declares, and a
+ * CRC-32 of the whole header, so the second pass can tell the header it reads again is the
+ * one that placed the write.
+ */
+struct rt_module {
+	loff_t off;
+	u32 size, body;		/* the declared size; how much of it is written */
+	u32 crc;		/* the image CRC its header names */
+	u32 hcrc;
+	char name[0x29];
+	char tag[0x41];		/* the version at 0xa8: 27.0.6...@<module>/<variants> */
+};
+
+/* What the first read found: every module, and the ones this stick writes. */
+struct rt_pkg {
+	int n;
+	struct rt_module m[RT_STU_MODULES];
+	struct rt_module *rootfs, *kernel, *mlo, *uboot;
+	bool bose;
+};
+
+/*
+ * Walks the header chain the way internal/stu does: big-endian fields, each module's header
+ * starting 0x14 bytes before the end of the previous payload, the last module ending where
+ * the file does. The first header carries the BOSE magic, the package size and a CRC over
+ * its first 0x10 bytes; every header its own CRC from 0x14 to 0x134. -ENOEXEC: not a .stu
+ * at all. -EBADMSG: one that does not check out.
+ */
+static int rt_scan(u8 *hdr, loff_t file, struct rt_pkg *pkg)
+{
+	loff_t off = 0;
+
+	for (pkg->n = 0; pkg->n < RT_STU_MODULES; pkg->n++) {
+		struct rt_module *m = &pkg->m[pkg->n];
+
+		if (off + RT_STU_HEADER > file)
+			return pkg->n ? -EBADMSG : -ENOEXEC;
+		if (rt_read(hdr, off, RT_STU_HEADER))
+			return -EIO;
+		if (!pkg->n && memcmp(hdr + 4, "BOSE", 4)) {
+			printf("Update.stu: not a .stu package; nothing written\n");
+			return -ENOEXEC;
+		}
+		if (!pkg->n && (get_unaligned_be32(hdr + 0x08) != file ||
+				crc32(0, hdr, 0x10) != get_unaligned_be32(hdr + 0x10)))
+			return -EBADMSG;
+		if (crc32(0, hdr + RT_STU_OVERLAP, 0x134 - RT_STU_OVERLAP) !=
+		    get_unaligned_be32(hdr + 0x134))
+			return -EBADMSG;
+		m->size = get_unaligned_be32(hdr + 0x98);
+		if (m->size <= RT_STU_OVERLAP || m->size > RT_STU_MAX)
+			return -EBADMSG;
+		m->off = off + RT_STU_HEADER;
+		m->body = m->size;
+		m->crc = get_unaligned_be32(hdr + 0x12c);
+		m->hcrc = crc32(0, hdr, RT_STU_HEADER);
+		memcpy(m->name, hdr + 0x18, 0x28);
+		m->name[0x28] = 0;
+		memcpy(m->tag, hdr + 0xa8, 0x40);
+		m->tag[0x40] = 0;
+		if (m->off + m->size == file) {
+			pkg->n++;
+			return 0;
+		}
+		off = m->off + m->size - RT_STU_OVERLAP;
+	}
+	return -EBADMSG;
+}

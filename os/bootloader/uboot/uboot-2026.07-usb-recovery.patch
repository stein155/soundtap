+static int rt_read(void *buf, loff_t off, loff_t len)
+{
+	loff_t got;
+
+	rt_kick();
+	if (fs_set_blk_dev("usb", rt_part, FS_TYPE_ANY))
+		return -ENODEV;
+	if (fs_read(RT_STU_NAME, map_to_sysmem(buf), off, len, &got) || got != len)
+		return -EIO;
+	return 0;
+}

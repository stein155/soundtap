+/*
+ * One sweep the way stock's sampler at 0x80101fe0 and soundtapd's keypad_gpio.go do it:
+ * assert a strobe high, settle 100 us, read three switch-ins, release; then the fourth
+ * switch-in unstrobed. A pressed key reads low. Returns the key mask, or -1.
+ */
+static int rt_keypad_scan(void)
+{
+	bool st20 = rt_st20();
+	const char *const *strobes = st20 ? rt_st20_strobes : rt_strobes;
+	const char *const *switchins = st20 ? rt_st20_switchins : rt_switchins;
+	/* ST10: drive high to assert, low to release. ST20: low to assert, input to release. */
+	ulong idle = st20 ? GPIOD_IS_IN : GPIOD_IS_OUT;
+	ulong assert = st20 ? GPIOD_IS_OUT : GPIOD_IS_OUT | GPIOD_IS_OUT_ACTIVE;
+	struct gpio_desc strobe[ARRAY_SIZE(rt_strobes)] = {};
+	struct gpio_desc in[ARRAY_SIZE(rt_switchins)] = {};
+	int mask = -1, s, n;
+
+	for (s = 0; s < ARRAY_SIZE(rt_strobes); s++)
+		if (dm_gpio_lookup_name(strobes[s], &strobe[s]) ||
+		    dm_gpio_request(&strobe[s], "keypad") ||
+		    dm_gpio_set_dir_flags(&strobe[s], idle))
+			goto out;
+	for (n = 0; n < ARRAY_SIZE(rt_switchins); n++)
+		if (dm_gpio_lookup_name(switchins[n], &in[n]) ||
+		    dm_gpio_request(&in[n], "keypad") ||
+		    dm_gpio_set_dir_flags(&in[n], GPIOD_IS_IN))
+			goto out;
+	configure_module_pin_mux(st20 ? rt_st20_keypad_pin_mux : rt_keypad_pin_mux);
+
+	mask = 0;
+	for (s = 0; s < ARRAY_SIZE(rt_strobes); s++) {
+		dm_gpio_set_dir_flags(&strobe[s], assert);
+		udelay(100);
+		for (n = 0; n < 3; n++)
+			if (dm_gpio_get_value(&in[n]) == 0)
+				mask |= RT_KEY(s * 4 + n);
+		dm_gpio_set_dir_flags(&strobe[s], idle);
+	}
+	if (dm_gpio_get_value(&in[3]) == 0)
+		mask |= RT_KEY(12);
+out:
+	for (s = 0; s < ARRAY_SIZE(rt_strobes); s++)
+		if (dm_gpio_is_valid(&strobe[s]))
+			dm_gpio_free(strobe[s].dev, &strobe[s]);
+	for (n = 0; n < ARRAY_SIZE(rt_switchins); n++)
+		if (dm_gpio_is_valid(&in[n]))
+			dm_gpio_free(in[n].dev, &in[n]);
+	return mask;
+}

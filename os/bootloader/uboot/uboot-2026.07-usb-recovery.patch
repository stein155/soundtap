+/*
+ * VOLUME DOWN + PRESET 4 held at power-on: install Update.stu from a USB stick and keep
+ * the settings. Stock U-Boot does this as `sweup uboot preserve`, and an owner who knows
+ * the gesture should not lose it because the bootloader is ours now
+ * (docs/decisions/0130-usb-stick-recovery.md).
+ *
+ * No signature (the speaker owner, 2026-11-24): someone holding the keys at power-on is
+ * the authorization. Signatures are for the updates anyone can start over the network
+ * (ADR 0048). What the stick checks is that the file is whole: every header CRC, every
+ * module's image CRC, and a second read of the whole file that hashes (SHA-256) to what
+ * the first read did. A file that is not a BOSE-magic .stu container is refused.
+ *
+ * Two kinds of package:
+ *
+ * - SoundTap's (it carries soundtap-rootfs): only the root filesystem -- our kernels live
+ *   in it -- into the slot that is not booting.
+ * - Bose's own for this board, on every model (the speaker owner, 2026-11-24; its ubi.img
+ *   names the module and variants it is for): the way back to stock, as POST /api/firmware
+ *   takes it, writing only Bose's kernel, ubi.img, SPL and U-Boot. Its kernel and ubi.img go into the slot that is not
+ *   booting, the environment selects that slot in the 8 KiB copy Bose's U-Boot reads,
+ *   then Bose's SPL and U-Boot replace ours, only the copies that differ, and the speaker
+ *   restarts into Bose's boot chain (rt_bose_finish has the order and every cut).
+ *
+ * The stick is read twice: once to check and hash all of Update.stu before anything is
+ * erased, once to write, hashing it again in the same order. bootcmd moves to the new
+ * slot only when the second pass hashed to the first pass's digest, so what was written
+ * is what was checked, and a stick pulled halfway, a package that does not check out or a
+ * slot full of bad blocks leaves the old slot booting as before.
+ *
+ * ST10 (rhino) and ST20 (spotty). The Wireless Link has no preset keys. Stock's sampler
+ * (0x80101f44 in the ST20's U-Boot 2014.07) serves both from one function: the same matrix
+ * in the same order, the same 0x108 mask for these two keys, only other GPIOs.
+ */
+#define RT_STU_NAME		"/Update.stu"
+#define RT_STU_HEADER		0x138
+#define RT_STU_OVERLAP		0x14
+#define RT_STU_MAX		(120 << 20)
+#define RT_STU_MODULES		16	/* the longest chain, Bose's ST20 package, has 13 */
+#define RT_CHUNK		(1 << 20)
+#define RT_SLOT_SIZE		0x6000000
+#define RT_PING_ROOTFS		0xc80000
+#define RT_PONG_ROOTFS		0x6c80000
+#define RT_KERNEL_SIZE		0x500000
+#define RT_PING_KERNEL		0x280000
+#define RT_PONG_KERNEL		0x780000
+/* The boot chain (ADR 0009): four SPL copies of one block each, then NAND.U-Boot with the
+ * first U-Boot in blocks 0-7, the spare in 8-13 and the redundant environment in 14. */
+#define RT_SPL_SIZE		0x20000
+#define RT_UBOOT		0x80000
+#define RT_UBOOT_SPARE		0x180000
+#define RT_UBOOT_MAX		0xc0000
+#define RT_ENV_REDUND		0x240000
+#define RT_ENV_OFFSET		0x260000
+#define RT_ENV_SIZE		0x8000
+#define RT_ENV_LEGACY		0x2000
+
+/* soundtapd's defaultKeymap indices: strobe * 4 + switch-in, 12 the directly wired key. */
+#define RT_KEY(i)		(1 << (i))
+#define RT_KEYS_PRESERVE	(RT_KEY(4) | RT_KEY(10))	/* VOLUME DOWN + PRESET 4 */
+
+/* The ST20 straps SYSBOOT 10010b, as the early-lamp patch tells it apart. */
+static bool rt_st20(void)
+{
+	return (readl(0x44e10040) & 0x1f) == 0x12;
+}

+	configure_module_pin_mux(rt_st20_usb_pin_mux);
+	if (dm_gpio_lookup_name("gpio@481ae000_7", &sel) || dm_gpio_request(&sel, "microbsel"))
+		return;
+	dm_gpio_set_dir_flags(&sel, high ? GPIOD_IS_OUT | GPIOD_IS_OUT_ACTIVE : GPIOD_IS_OUT);
+	dm_gpio_free(sel.dev, &sel);
+}

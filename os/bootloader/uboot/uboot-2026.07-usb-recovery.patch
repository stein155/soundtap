+static int rt_find_stick(void)
+{
+	rt_part = "0:1";
+	if (!fs_set_blk_dev("usb", rt_part, FS_TYPE_ANY))
+		return 0;
+	rt_part = "0";	/* a stick formatted without a partition table */
+	return fs_set_blk_dev("usb", rt_part, FS_TYPE_ANY) ? -ENODEV : 0;
+}

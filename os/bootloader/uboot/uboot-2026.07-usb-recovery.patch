+static struct rt_module *rt_module_named(struct rt_pkg *pkg, const char *name)
+{
+	int i;
+
+	for (i = 0; i < pkg->n; i++)
+		if (!strcmp(pkg->m[i].name, name))
+			return &pkg->m[i];
+	return NULL;
+}
+
+/* Whether a version tag (27.0.6.46330.5043500@sm2/spotty+mojo+binky) names module m and,
+ * among its variants, v. */
+static bool rt_tag_names(const char *tag, const char *m, const char *v)
+{
+	const char *p = strchr(tag, '@'), *e;
+	size_t n = strlen(m), k = strlen(v);
+
+	if (!p || strncmp(++p, m, n) || p[n] != '/')
+		return false;
+	for (p += n + 1; *p; p = *e ? e + 1 : e) {
+		for (e = p; *e && *e != '+'; e++)
+			;
+		if ((size_t)(e - p) == k && !strncmp(p, v, k))
+			return true;
+	}
+	return false;
+}

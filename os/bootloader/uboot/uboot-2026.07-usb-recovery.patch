+	{OFFSET(gpmc_be1n), MODE(7) | PULLUP_EN},
+	{OFFSET(gpmc_ad12), MODE(7) | PULLUP_EN},
+	{OFFSET(gpmc_ad13), MODE(7) | PULLUP_EN},
+	{-1},
+};

+/*
+ * The ST20's SPL starts WDT1 for ~100 s and this U-Boot does not service it, so a long
+ * write would be cut off by a reset. Reloaded here, between chunks, only while the
+ * module is clocked: touching it gated is an external abort.
+ */
+static void rt_kick(void)
+{
+	static u32 trigger, chunks;
+
+	rt_lamp(++chunks & 1);
+	schedule();
+	if ((readl(0x44e004d4) & 0x30003) != 0x2)	/* CM_WKUP_WDT1_CLKCTRL: on, functional */
+		return;
+	while (readl(0x44e35034) & (1 << 3))		/* WWPS: WTGR write pending */
+		;
+	writel(++trigger, 0x44e35030);			/* WTGR: any new value reloads */
+}

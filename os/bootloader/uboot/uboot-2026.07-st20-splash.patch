diff --git a/board/ti/am335x/board.c b/board/ti/am335x/board.c
--- a/board/ti/am335x/board.c
+++ b/board/ti/am335x/board.c
@@ -767,9 +767,150 @@ static void soundtap_early_lamp(void)
 	clrbits_le32((void *)0x44e07134, 1 << 19);	/* GPIO0 OE: output */
 }
 
+/*
+ * ST20 only (SYSBOOT 10010b): paint soundtapd's first boot frame on the OLED as soon as
+ * U-Boot runs. Until now the panel stayed dark, or faint while the PMIC's VDD3 boost was
+ * off, until soundtapd started. Raw registers and bounded waits, like soundtap_early_lamp:
+ * VDD3 on through the TPS65910 on I2C2, then the panel (soundtap/oled/spidev_linux.go)
+ * over bit-banged SPI mode 3. Linux remuxes every pad and redoes all of it.
+ */
+#include "soundtap-splash.h"
+
+#define RT_GPIO0 0x44e07000
+#define RT_GPIO1 0x4804c000
+#define RT_GPIO2 0x481ac000
+#define RT_GPIO3 0x481ae000
+
+static int rt_wait(u32 addr, u32 mask, u32 want)
+{
+	for (int i = 0; i < 100000; i++) {
+		if ((readl(addr) & mask) == want)
+			return 0;
+		udelay(1);
+	}
+	return -1;
+}
+
+static void rt_clk(u32 clkctrl)
+{
+	writel(0x2, clkctrl);
+	rt_wait(clkctrl, 3 << 16, 0);
+}
+
+/* One register write to the TPS65910 (0x2d) on I2C2 at 100 kHz, polled. */
+static int rt_pmic_write(u8 reg, u8 val)
+{
+	const u32 i2c = 0x4819c000;
+	int err = -1;
+
+	rt_clk(0x44e00044);			/* CM_PER_I2C2_CLKCTRL */
+	writel(0x6b, 0x44e10978);		/* uart1_ctsn: i2c2_sda, pull-up, input */
+	writel(0x6b, 0x44e1097c);		/* uart1_rtsn: i2c2_scl */
+	writel(0, i2c + 0xa4);			/* CON: off */
+	writel(3, i2c + 0xb0);			/* PSC: 48 MHz / 4 */
+	writel(53, i2c + 0xb4);			/* SCLL: 5 us low */
+	writel(55, i2c + 0xb8);			/* SCLH: 5 us high */
+	writel(1, i2c + 0xa8);			/* OA */
+	writel(0x8000, i2c + 0xa4);		/* CON: on */
+	if (rt_wait(i2c + 0x24, 1 << 12, 0))	/* IRQSTATUS_RAW.BB: bus free */
+		goto out;
+	writel(0xffff, i2c + 0x28);
+	writel(0x2d, i2c + 0xac);		/* SA */
+	writel(2, i2c + 0x98);			/* CNT */
+	writel(0x8603, i2c + 0xa4);		/* EN | MST | TRX | STP | STT */
+	for (int i = 0; i < 2; i++) {
+		if (rt_wait(i2c + 0x24, 1 << 4 | 1 << 1, 1 << 4))	/* XRDY and no NACK */
+			goto out;
+		writel(i ? val : reg, i2c + 0x9c);
+		writel(1 << 4, i2c + 0x28);
+	}
+	err = rt_wait(i2c + 0x24, 1 << 2, 1 << 2);	/* ARDY: done */
+out:
+	writel(0xffff, i2c + 0x28);
+	writel(0, i2c + 0xa4);
+	return err;
+}
+
+static void rt_out(u32 gpio, int bit, int high)
+{
+	writel(1u << bit, gpio + (high ? 0x194 : 0x190));	/* SETDATAOUT / CLEARDATAOUT */
+}
+
+static void rt_spi_byte(u8 b)
+{
+	for (int i = 7; i >= 0; i--) {
+		rt_out(RT_GPIO0, 7, 0);			/* SCLK low: data changes */
+		rt_out(RT_GPIO3, 15, b >> i & 1);	/* MOSI */
+		udelay(1);
+		rt_out(RT_GPIO0, 7, 1);			/* rising edge: the panel samples */
+		udelay(1);
+	}
+}
+
+static void rt_spi_cmd(const u8 *p, int n)
+{
+	rt_out(RT_GPIO1, 27, 0);		/* D/C: command */
+	rt_out(RT_GPIO2, 24, 0);		/* CE */
+	while (n--)
+		rt_spi_byte(*p++);
+	rt_out(RT_GPIO2, 24, 1);
+}
+
+static void soundtap_st20_splash(void)
+{
+	static const u8 init[] = {
+		0xae, 0x15, 0x00, 0x3f, 0x75, 0x00, 0x63, 0x81,
+		0x85, 0xa0, 0x53, 0xa2, 0x1c, 0xa1, 0x00, 0xa4,
+		0xa8, 0x63, 0xab, 0x01, 0xb1, 0x16, 0xb3, 0x90,
+		0xb6, 0x0f, 0xbc, 0x07, 0xbe, 0x00, 0xd5, 0x63,
+		0xb8, 0x03, 0x06, 0x08, 0x0b, 0x0e, 0x12, 0x16,
+		0x1b, 0x1f, 0x24, 0x29, 0x2e, 0x33, 0x39, 0x3f,
+	};
+	static const u8 window[] = { 0x15, 0x00, 0x3f, 0x75, 0x00, 0x63 };
+	static const u8 on = 0xaf;
+
+	if ((readl(0x44e10040) & 0x1f) != 0x12)
+		return;
+	if (rt_pmic_write(0x27, 0x05)) {	/* VDD3_REG: boost on, the value Linux leaves */
+		printf("soundtap: TPS65910 VDD3 write failed, no boot frame\n");
+		return;
+	}
+	rt_clk(0x44e00408);			/* GPIO0 */
+	rt_clk(0x44e000ac);			/* GPIO1 */
+	rt_clk(0x44e000b0);			/* GPIO2 */
+	rt_clk(0x44e000b4);			/* GPIO3 */
+	rt_out(RT_GPIO0, 7, 1);			/* SCLK idles high */
+	rt_out(RT_GPIO2, 24, 1);		/* CE off */
+	rt_out(RT_GPIO2, 18, 1);		/* reset released */
+	rt_out(RT_GPIO1, 27, 0);
+	writel(0x7, 0x44e10964);		/* ecap0_in_pwm0_out: gpio0_7, SCLK */
+	writel(0x7, 0x44e10994);		/* mcasp0_fsx: gpio3_15, MOSI */
+	writel(0x7, 0x44e108e8);		/* lcd_pclk: gpio2_24, CE */
+	writel(0x7, 0x44e10934);		/* mii1_rxd3: gpio2_18, reset */
+	writel(0x7, 0x44e1086c);		/* gpmc_a11: gpio1_27, D/C */
+	clrbits_le32((void *)(RT_GPIO0 + 0x134), 1 << 7);
+	clrbits_le32((void *)(RT_GPIO3 + 0x134), 1 << 15);
+	clrbits_le32((void *)(RT_GPIO2 + 0x134), 1 << 24 | 1 << 18);
+	clrbits_le32((void *)(RT_GPIO1 + 0x134), 1 << 27);
+	rt_out(RT_GPIO2, 18, 0);
+	mdelay(10);
+	rt_out(RT_GPIO2, 18, 1);
+	mdelay(10);
+	rt_spi_cmd(init, sizeof(init));
+	rt_spi_cmd(window, sizeof(window));
+	rt_out(RT_GPIO1, 27, 1);		/* D/C: data */
+	rt_out(RT_GPIO2, 24, 0);
+	for (unsigned int i = 0; i + 1 < sizeof(soundtap_splash_rle); i += 2)
+		for (int n = soundtap_splash_rle[i]; n; n--)
+			rt_spi_byte(soundtap_splash_rle[i + 1]);
+	rt_out(RT_GPIO2, 24, 1);
+	rt_spi_cmd(&on, 1);
+}
+
 int board_init(void)
 {
 	soundtap_early_lamp();
+	soundtap_st20_splash();
 #if defined(CONFIG_HW_WATCHDOG)
 	hw_watchdog_init();
 #endif

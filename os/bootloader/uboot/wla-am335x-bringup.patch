 	rtc_only();
 #endif
+	watchdog_disable();
+	timer_init();
+	/* WLA USB boot has no UART console; its mux setup hangs here. */
+	setup_clocks_for_console();
+	/* pre-reloc dpll_ddr_regs pointer is invalid; use fixed AM335x registers. */
+	clrsetbits_le32(CM_WKUP + 0x94, CM_CLKMODE_DPLL_DPLL_EN_MASK,
+			  DPLL_EN_MN_BYPASS << CM_CLKMODE_DPLL_EN_SHIFT);
+	for (timeout = 1000000; (readl(CM_WKUP + 0x34) & ST_DPLL_CLK_MASK) && timeout; timeout--)
+		;
+	temp = readl(CM_WKUP + 0x40);
+	temp &= ~(CM_CLKSEL_DPLL_M_MASK | CM_CLKSEL_DPLL_N_MASK);
+	temp |= (266 << CM_CLKSEL_DPLL_M_SHIFT) & CM_CLKSEL_DPLL_M_MASK;
+	temp |= (23 << CM_CLKSEL_DPLL_N_SHIFT) & CM_CLKSEL_DPLL_N_MASK;
+	writel(temp, CM_WKUP + 0x40);
+	writel(1, CM_WKUP + 0xa0);
+	clrsetbits_le32(CM_WKUP + 0x94, CM_CLKMODE_DPLL_DPLL_EN_MASK,
+			  DPLL_EN_LOCK << CM_CLKMODE_DPLL_EN_SHIFT);
+	for (timeout = 1000000; !(readl(CM_WKUP + 0x34) & ST_DPLL_CLK_MASK) && timeout; timeout--)
+		;
+	/*
+	 * nothing else here tunes the MPU, so it ran at the ROM's 500 MHz. These
+	 * boards are fused for 600 (ST10 and WLA ZCE-600, ST20 ZCZ-600) and the ST10 runs 600
+	 * under Bose's SPL: 20% more CPU, which a Spotify multiroom leader needs. Relocked
+	 * at runtime on the WLA and ST20 first, 3 min at full load (2026-09-29).
+	 */
+	clrsetbits_le32(CM_WKUP + 0x88, CM_CLKMODE_DPLL_DPLL_EN_MASK,
+			  DPLL_EN_MN_BYPASS << CM_CLKMODE_DPLL_EN_SHIFT);
+	for (timeout = 1000000; (readl(CM_WKUP + 0x20) & ST_DPLL_CLK_MASK) && timeout; timeout--)
+		;
+	temp = readl(CM_WKUP + 0x2c);
+	temp &= ~(CM_CLKSEL_DPLL_M_MASK | CM_CLKSEL_DPLL_N_MASK);
+	temp |= (600 << CM_CLKSEL_DPLL_M_SHIFT) & CM_CLKSEL_DPLL_M_MASK;
+	temp |= (23 << CM_CLKSEL_DPLL_N_SHIFT) & CM_CLKSEL_DPLL_N_MASK;
+	writel(temp, CM_WKUP + 0x2c);
+	clrsetbits_le32(CM_WKUP + 0xa8, 0x1f, 1);	/* M2 = 1 */
+	clrsetbits_le32(CM_WKUP + 0x88, CM_CLKMODE_DPLL_DPLL_EN_MASK,
+			  DPLL_EN_LOCK << CM_CLKMODE_DPLL_EN_SHIFT);
+	for (timeout = 1000000; !(readl(CM_WKUP + 0x20) & ST_DPLL_CLK_MASK) && timeout; timeout--)
+		;

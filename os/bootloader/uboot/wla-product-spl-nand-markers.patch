+/* Diagnostic build only: mtd11 starts at 0xf280000 and is scratch space. */
+#define WLA_DIAG_FIRST_BLOCK	(0xf280000 / CONFIG_SYS_NAND_BLOCK_SIZE)
+#define WLA_DIAG_WAIT_US	1000000
+
+static int wla_diag_ready(struct nand_chip *this)
+{
+	unsigned int left = WLA_DIAG_WAIT_US;
+
+	while (left && !this->dev_ready(mtd)) {
+		left--;
+		udelay(1);
+	}
+	return left ? 0 : -1;
+}
+
+static void wla_diag_ctrl(struct nand_chip *this, int value, unsigned int ctrl)
+{
+	this->cmd_ctrl(mtd, value, ctrl);
+}
+
+static void wla_diag_write(struct nand_chip *this, const u8 *buf, unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i < len; i++)
+		writeb(buf[i], this->IO_ADDR_R);
+}
+
+void wla_spl_diag_mark(unsigned int stage)
+{
+	static const u8 marker[][16] = {
+		"SOUNDTAP-SPL:01\n", "SOUNDTAP-SPL:02\n",
+	};
+	static const u8 erased[16] = {
+		[0 ... 15] = 0xff,
+	};
+	struct nand_chip *this = mtd_to_nand(mtd);
+	unsigned int block, page_addr, i;
+	u8 status;
+
+	if (!stage || stage > ARRAY_SIZE(marker))
+		return;
+	block = WLA_DIAG_FIRST_BLOCK + stage - 1;
+	if (nand_is_bad_block(block) || wla_diag_ready(this))
+		return;
+	page_addr = block * SYS_NAND_BLOCK_PAGES;
+
+	/* Erase exactly one dedicated mtd11 block. */
+	wla_diag_ctrl(this, NAND_CMD_ERASE1, NAND_CTRL_CLE | NAND_CTRL_CHANGE);
+	wla_diag_ctrl(this, page_addr & 0xff, NAND_CTRL_ALE | NAND_CTRL_CHANGE);
+	wla_diag_ctrl(this, (page_addr >> 8) & 0xff, NAND_CTRL_ALE);
+#ifdef CONFIG_SYS_NAND_5_ADDR_CYCLE
+	wla_diag_ctrl(this, (page_addr >> 16) & 0x0f, NAND_CTRL_ALE);
+#endif
+	wla_diag_ctrl(this, NAND_CMD_ERASE2, NAND_CTRL_CLE | NAND_CTRL_CHANGE);
+	wla_diag_ctrl(this, NAND_CMD_NONE, NAND_NCE | NAND_CTRL_CHANGE);
+	ndelay(150);
+	if (wla_diag_ready(this))
+		return;
+
+	/* Program first page raw. No OOB/ECC bytes: inspect with nanddump --noecc. */
+	wla_diag_ctrl(this, NAND_CMD_SEQIN, NAND_CTRL_CLE | NAND_CTRL_CHANGE);
+	wla_diag_ctrl(this, 0, NAND_CTRL_ALE | NAND_CTRL_CHANGE);
+	wla_diag_ctrl(this, 0, NAND_CTRL_ALE);
+	wla_diag_ctrl(this, page_addr & 0xff, NAND_CTRL_ALE);
+	wla_diag_ctrl(this, (page_addr >> 8) & 0xff, NAND_CTRL_ALE);
+#ifdef CONFIG_SYS_NAND_5_ADDR_CYCLE
+	wla_diag_ctrl(this, (page_addr >> 16) & 0x0f, NAND_CTRL_ALE);
+#endif
+	wla_diag_ctrl(this, NAND_CMD_NONE, NAND_NCE | NAND_CTRL_CHANGE);
+	wla_diag_write(this, marker[stage - 1], sizeof(marker[0]));
+	for (i = sizeof(marker[0]); i < CONFIG_SYS_NAND_PAGE_SIZE; i += sizeof(erased))
+		wla_diag_write(this, erased, sizeof(erased));
+	wla_diag_ctrl(this, NAND_CMD_PAGEPROG, NAND_CTRL_CLE | NAND_CTRL_CHANGE);
+	wla_diag_ctrl(this, NAND_CMD_NONE, NAND_NCE | NAND_CTRL_CHANGE);
+	ndelay(150);
+	if (wla_diag_ready(this))
+		return;
+	wla_diag_ctrl(this, NAND_CMD_STATUS, NAND_CTRL_CLE | NAND_CTRL_CHANGE);
+	wla_diag_ctrl(this, NAND_CMD_NONE, NAND_NCE | NAND_CTRL_CHANGE);
+	status = readb(this->IO_ADDR_R);
+	(void)status;
+}
+

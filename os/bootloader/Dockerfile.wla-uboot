FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
    build-essential gcc-arm-linux-gnueabihf bison flex libssl-dev libgnutls28-dev \
    uuid-dev pkg-config python3 python3-dev python3-setuptools python3-pyelftools \
    device-tree-compiler swig bc git ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
